// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──── KONTEN ────

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  body      String // HTML dari Tiptap
  category  String // Prestasi | Keagamaan | Akademik | Ekstrakurikuler | PPDB
  imageUrl  String?
  published Boolean  @default(false)
  featured  Boolean  @default(false) // tampil di homepage
  authorId  String? // akun pengusul (guru); null = dibuat staf langsung
  reviewStatus String? // null = konten staf; pending | approved | rejected untuk usulan guru
  reviewNote   String? // alasan penolakan (diisi staf)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    Account? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([reviewStatus])
}

model Department {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String // "Perbankan Syariah" | "DKV (Desain Komunikasi Visual)"
  icon        String? // material symbol name
  description String
  kompetensi  String // JSON string[]
  karir       String // JSON string[]
  imageUrl    String?
  order       Int     @default(0)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // "profil" | "visi-misi" | "sejarah"
  title     String
  content   String
  metaDesc  String?
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String  @id @default(cuid())
  title       String
  level       String // Kabupaten | Provinsi | Nasional
  year        String
  category    String? // Akademik | Non-Akademik | Keagamaan
  student     String? // nama siswa/tim
  description String?
  imageUrl    String?
  featured    Boolean @default(false) // tampil di homepage
  order       Int     @default(0)
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  title     String? // "S.E.,M.Pd."
  position  String // Kepala Sekolah | Waka Kurikulum | Guru Mapel
  subject   String?
  photoUrl  String?
  level     String   @default("Guru") // Yayasan | Kepala Sekolah | Waka | Kaprog | Guru | Staf
  order     Int      @default(0)
  accountId String?  @unique // tautan ke akun guru (realm Internal), opsional
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model Extracurricular {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
}

model Facility {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String?
  imageUrl    String?
  order       Int     @default(0)
}

model Partner {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?
  type    String? // Industri | Institusi | Pemerintah
  order   Int     @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String // Siswa | Orang Tua | Alumni | Mitra
  content   String
  photoUrl  String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  album     String? // Kegiatan 2026 | Fasilitas | Prestasi
  createdAt DateTime @default(now())
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String?
  imageUrl  String? // set -> shows as homepage hero spotlight; empty -> text ribbon
  linkUrl   String?
  linkLabel String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Alumni {
  id        String   @id @default(cuid())
  nama      String
  angkatan  Int // tahun lulus (2010 = angkatan pertama)
  jurusan   String // Department live | Multimedia | Lainnya
  status    String   @default("Bekerja") // Bekerja | Kuliah | Wirausaha | Lainnya
  pekerjaan String?
  instansi  String?
  domisili  String? // kota/kabupaten saat ini — untuk stat persebaran (publik)
  cerita    String? // pendek, 1 paragraf
  email     String? @unique // PRIVAT — jangkar login (magic-link); unik cegah dup (NULL boleh banyak di Postgres)
  wa        String? @unique // PRIVAT — kontak/recovery; unik cegah dup (NULL boleh banyak)
  photoUrl    String? // admin isi saat verifikasi
  alumniId    String?  @unique // ID kartu alumni (SMKSDH-0001), diberi saat approve; permanen
  verifyToken String?  @unique // token acak untuk QR/URL verify publik (anti-enumerasi); diberi saat approve
  verified    Boolean  @default(false) // gate moderasi (data valid, masuk DB)
  publicOptIn Boolean  @default(false) // alumni setuju tampil publik
  featured    Boolean  @default(false) // admin pilih tampil di showcase; hanya boleh bila publicOptIn
  createdAt   DateTime @default(now())

  loginTokens AlumniLoginToken[]

  @@index([verified])
  @@index([angkatan])
  @@index([featured])
}
model AlumniLoginToken {
  id        String    @id @default(cuid())
  alumniId  String
  tokenHash String    @unique // sha256 dari token acak (token mentah hanya di email, tak disimpan)
  expiresAt DateTime // TTL 15 menit
  usedAt    DateTime? // sekali pakai; terisi saat dikonsumsi
  createdAt DateTime  @default(now())
  alumni    Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId])
  @@index([expiresAt])
}

model AlumniContribution {
  id        String   @id @default(cuid())
  nama      String
  kontak    String // WA atau email — untuk admin follow up (privat)
  jenis     String // Usulan/Saran | Tawaran Workshop/Narasumber | Info Lowongan | Lainnya
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Download {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  category  String? // Formulir | Brosur | Akademik
  createdAt DateTime @default(now())
}

// ──── RBAC (realm Internal) ────

model Account {
  id           String            @id @default(cuid())
  email        String            @unique
  username     String?           @unique
  passwordHash String
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  roles        AccountRole[]
  overrides    AccountOverride[]
  teacher      Teacher?
  articles     Article[]
}

model AccountRole {
  id        String  @id @default(cuid())
  accountId String
  role      String // superadmin | staf | guru | siswa
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role])
}

model AccountOverride {
  id         String  @id @default(cuid())
  accountId  String
  capability String
  effect     String // grant | revoke
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, capability, effect])
  @@index([accountId])
}

// ──── SETTINGS ────

model Setting {
  id               String  @id @default("main")
  siteName         String?
  siteShortName    String?
  tagline          String?
  address          String?
  phone            String?
  email            String?
  wa               String?
  instagram        String?
  facebook         String?
  tiktok           String?
  youtube          String?
  metaDefaultTitle String?
  metaDefaultDesc  String?
}

// ──── MASTER WILAYAH (untuk dropdown domisili — konsistensi data) ────

model Province {
  id   String @id // kode BPS, mis. "35"
  name String
}

model Regency {
  id         String @id // kode BPS, mis. "3524"
  provinceId String
  name       String // "Kabupaten Lamongan" | "Kota Surabaya"

  @@index([provinceId])
}

// ──── MEDIA LIBRARY ────

model Media {
  id        String   @id @default(cuid())
  url       String // public URL (via /api/image proxy)
  filename  String // original file name
  mimeType  String?
  size      Int? // bytes (compressed)
  folder    String?  @default("uploads")
  kind      String   @default("image") // image | file — image pickers show only "image"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}
