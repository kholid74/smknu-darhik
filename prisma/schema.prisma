// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ElectionState {
  DRAFT
  SCHEDULED
  CLOSED
  ARCHIVED
}

enum CandidateMode {
  SINGLE
  OPTIONAL_VICE
}

enum CandidatePosition {
  CHAIR
  VICE_CHAIR
}

enum VotingSessionScope {
  ELECTION_VOTING
}

// ──── KONTEN ────

model Article {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String?
  body         String // HTML dari Tiptap
  category     String // Prestasi | Keagamaan | Akademik | Ekstrakurikuler | PPDB
  imageUrl     String?
  published    Boolean  @default(false)
  featured     Boolean  @default(false) // tampil di homepage
  authorId     String? // akun pengusul (guru); null = dibuat staf langsung
  reviewStatus String? // null = konten staf; pending | approved | rejected untuk usulan guru
  reviewNote   String? // alasan penolakan (diisi staf)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       Account? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([reviewStatus])
}

model Department {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String // "Perbankan Syariah" | "DKV (Desain Komunikasi Visual)"
  icon        String? // material symbol name
  description String
  kompetensi  String // JSON string[]
  karir       String // JSON string[]
  imageUrl    String?
  order       Int           @default(0)
  classes     SchoolClass[]
}

model SchoolClass {
  id           String     @id @default(cuid())
  academicYear String     @db.VarChar(20)
  name         String     @db.VarChar(40)
  departmentId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students     Student[]

  @@unique([academicYear, name, departmentId])
  @@index([departmentId])
  @@index([academicYear, name])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // "profil" | "visi-misi" | "sejarah"
  title     String
  content   String
  metaDesc  String?
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String  @id @default(cuid())
  title       String
  level       String // Kabupaten | Provinsi | Nasional
  year        String
  category    String? // Akademik | Non-Akademik | Keagamaan
  student     String? // nama siswa/tim
  description String?
  imageUrl    String?
  featured    Boolean @default(false) // tampil di homepage
  order       Int     @default(0)
}

model Teacher {
  id             String          @id @default(cuid())
  name           String
  title          String? // "S.E.,M.Pd."
  position       String // Kepala Sekolah | Waka Kurikulum | Guru Mapel
  subject        String?
  photoUrl       String?
  level          String          @default("Guru") // Yayasan | Kepala Sekolah | Waka | Kaprog | Guru | Staf
  order          Int             @default(0)
  accountId      String?         @unique // tautan ke akun guru (realm Internal), opsional
  account        Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  electionVoters ElectionVoter[]
}

model Extracurricular {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
}

model Facility {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String?
  imageUrl    String?
  order       Int     @default(0)
}

model Partner {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?
  type    String? // Industri | Institusi | Pemerintah
  order   Int     @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String // Siswa | Orang Tua | Alumni | Mitra
  content   String
  photoUrl  String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  album     String? // Kegiatan 2026 | Fasilitas | Prestasi
  createdAt DateTime @default(now())
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String?
  imageUrl  String? // set -> shows as homepage hero spotlight; empty -> text ribbon
  linkUrl   String?
  linkLabel String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Alumni {
  id          String   @id @default(cuid())
  nama        String
  angkatan    Int // tahun lulus (2010 = angkatan pertama)
  jurusan     String // Department live | Multimedia | Lainnya
  status      String   @default("Bekerja") // Bekerja | Kuliah | Wirausaha | Lainnya
  pekerjaan   String?
  instansi    String?
  domisili    String? // kota/kabupaten saat ini — untuk stat persebaran (publik)
  cerita      String? // pendek, 1 paragraf
  email       String?  @unique // PRIVAT — jangkar login (magic-link); unik cegah dup (NULL boleh banyak di Postgres)
  wa          String?  @unique // PRIVAT — kontak/recovery; unik cegah dup (NULL boleh banyak)
  photoUrl    String? // admin isi saat verifikasi
  alumniId    String?  @unique // ID kartu alumni (SMKSDH-0001), diberi saat approve; permanen
  verifyToken String?  @unique // token acak untuk QR/URL verify publik (anti-enumerasi); diberi saat approve
  verified    Boolean  @default(false) // gate moderasi (data valid, masuk DB)
  publicOptIn Boolean  @default(false) // alumni setuju tampil publik
  featured    Boolean  @default(false) // admin pilih tampil di showcase; hanya boleh bila publicOptIn
  createdAt   DateTime @default(now())

  loginTokens AlumniLoginToken[]

  @@index([verified])
  @@index([angkatan])
  @@index([featured])
}

model AlumniLoginToken {
  id        String    @id @default(cuid())
  alumniId  String
  tokenHash String    @unique // sha256 dari token acak (token mentah hanya di email, tak disimpan)
  expiresAt DateTime // TTL 15 menit
  usedAt    DateTime? // sekali pakai; terisi saat dikonsumsi
  createdAt DateTime  @default(now())
  alumni    Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId])
  @@index([expiresAt])
}

model AlumniContribution {
  id        String   @id @default(cuid())
  nama      String
  kontak    String // WA atau email — untuk admin follow up (privat)
  jenis     String // Usulan/Saran | Tawaran Workshop/Narasumber | Info Lowongan | Lainnya
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Download {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  category  String? // Formulir | Brosur | Akademik
  createdAt DateTime @default(now())
}

// ──── RBAC (realm Internal) ────

model Account {
  id                 String              @id @default(cuid())
  email              String              @unique
  username           String?             @unique
  passwordHash       String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  roles              AccountRole[]
  overrides          AccountOverride[]
  teacher            Teacher?
  articles           Article[]
  votingAuditEvents  VotingAuditEvent[]
  studentAuditEvents StudentAuditEvent[]
}

// E-Voting student master is independent from internal Account credentials.
model Student {
  id                   String              @id @default(uuid()) @db.Uuid
  nisn                 String              @unique @db.VarChar(10)
  name                 String              @db.VarChar(120)
  className            String              @db.VarChar(40)
  schoolClassId        String?
  schoolClass          SchoolClass?        @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)
  voters               ElectionVoter[]
  candidateMemberships CandidateMember[]
  auditEvents          StudentAuditEvent[]

  @@index([schoolClassId])
}

model StudentAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @db.Uuid
  actorAccountId String
  event          String   @db.VarChar(32)
  changedFields  Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          Account  @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([studentId, createdAt])
  @@index([actorAccountId, createdAt])
}

model ElectionPeriod {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique @db.VarChar(64)
  name             String            @db.VarChar(120)
  academicYear     String            @db.VarChar(20)
  isTest           Boolean           @default(false)
  state            ElectionState     @default(DRAFT)
  opensAt          DateTime          @db.Timestamptz(3)
  closesAt         DateTime          @db.Timestamptz(3)
  extensionUsedAt  DateTime?         @db.Timestamptz(3)
  closedAt         DateTime?         @db.Timestamptz(3)
  publishedAt      DateTime?         @db.Timestamptz(3)
  resultSnapshot   Json?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  contestsRevision Int               @default(0)
  contests         ElectionContest[]
  voters           ElectionVoter[]
}

model ElectionType {
  code           String            @id @db.VarChar(32)
  name           String            @db.VarChar(120)
  logoUrl        String?           @db.VarChar(1024)
  candidateMode  CandidateMode
  chairLabel     String            @db.VarChar(80)
  viceChairLabel String?           @db.VarChar(80)
  active         Boolean           @default(true)
  sortOrder      Int
  revision       Int               @default(0)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  contests       ElectionContest[]

  @@index([active, sortOrder, code])
}

model ElectionContest {
  periodId               String               @db.Uuid
  organization           String               @db.VarChar(32)
  nameSnapshot           String               @db.VarChar(120)
  logoUrlSnapshot        String?              @db.VarChar(1024)
  candidateModeSnapshot  CandidateMode
  chairLabelSnapshot     String               @db.VarChar(80)
  viceChairLabelSnapshot String?              @db.VarChar(80)
  sortOrder              Int
  type                   ElectionType         @relation(fields: [organization], references: [code], onDelete: Restrict, onUpdate: Restrict, map: "ElectionContest_type_fkey")
  period                 ElectionPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidates             CandidatePair[]
  participation          VoterParticipation[]
  ballots                Ballot[]

  @@id([periodId, organization])
  // SQL migration makes this constraint DEFERRABLE INITIALLY DEFERRED.
  @@unique([periodId, sortOrder], map: "ElectionContest_period_order_key")
  @@index([organization])
}

model CandidatePair {
  id           String            @id @default(uuid()) @db.Uuid
  periodId     String            @db.Uuid
  organization String            @db.VarChar(32)
  ballotNumber Int
  vision       String            @db.VarChar(2000)
  mission      String            @db.VarChar(2000)
  contest      ElectionContest   @relation(fields: [periodId, organization], references: [periodId, organization], onDelete: Restrict, onUpdate: Restrict)
  members      CandidateMember[]
  ballots      Ballot[]

  @@unique([periodId, organization, ballotNumber])
  @@unique([id, periodId, organization])
}

model CandidateMember {
  candidatePairId String            @db.Uuid
  periodId        String            @db.Uuid
  organization    String            @db.VarChar(32)
  studentId       String            @db.Uuid
  position        CandidatePosition
  nameSnapshot    String            @db.VarChar(120)
  classSnapshot   String            @db.VarChar(40)
  photoUrl        String?           @db.VarChar(1024)
  pair            CandidatePair     @relation(fields: [candidatePairId, periodId, organization], references: [id, periodId, organization], onDelete: Restrict, onUpdate: Restrict)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([candidatePairId, position])
  @@unique([periodId, organization, studentId])
  @@index([studentId, periodId])
}

enum ElectionVoterType {
  STUDENT
  TEACHER
}

model ElectionVoter {
  id                String               @id @default(uuid()) @db.Uuid
  voterType         ElectionVoterType    @default(STUDENT)
  studentId         String?              @db.Uuid
  teacherId         String?
  loginCode         String?              @db.VarChar(32)
  periodId          String               @db.Uuid
  nisn              String?              @db.VarChar(10)
  name              String               @db.VarChar(120)
  className         String               @db.VarChar(40)
  credentialEnabled Boolean              @default(true)
  pinHash           String?              @db.VarChar(60)
  pinFingerprint    String?              @db.Char(64)
  pinVersion        Int                  @default(0)
  period            ElectionPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student           Student?             @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teacher           Teacher?             @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participation     VoterParticipation[]
  session           VotingSession?

  @@unique([periodId, nisn])
  @@unique([periodId, studentId])
  @@unique([periodId, teacherId])
  @@unique([periodId, loginCode])
  @@unique([periodId, pinFingerprint])
  @@unique([id, periodId])
  @@index([studentId])
  @@index([periodId, className])
}

model VoterParticipation {
  voterId      String          @db.Uuid
  periodId     String          @db.Uuid
  organization String          @db.VarChar(32)
  hasVoted     Boolean         @default(false)
  voter        ElectionVoter   @relation(fields: [voterId, periodId], references: [id, periodId], onDelete: Restrict, onUpdate: Restrict)
  contest      ElectionContest @relation(fields: [periodId, organization], references: [periodId, organization], onDelete: Restrict, onUpdate: Restrict)

  @@id([voterId, organization])
  @@index([periodId, organization, hasVoted])
}

model Ballot {
  id           String          @id @default(uuid()) @db.Uuid
  periodId     String          @db.Uuid
  organization String          @db.VarChar(32)
  candidateId  String          @db.Uuid
  candidate    CandidatePair   @relation(fields: [candidateId, periodId, organization], references: [id, periodId, organization], onDelete: Restrict, onUpdate: Restrict)
  contest      ElectionContest @relation(fields: [periodId, organization], references: [periodId, organization], onDelete: Restrict, onUpdate: Restrict, map: "Ballot_contest_fkey")

  @@index([periodId, organization, candidateId])
}

model VotingSession {
  id         String             @id @default(uuid()) @db.Uuid
  scope      VotingSessionScope @default(ELECTION_VOTING)
  voterId    String             @unique @db.Uuid
  tokenHash  String             @unique @db.Char(64)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime           @db.Timestamptz(3)
  expiresAt  DateTime           @db.Timestamptz(3)
  voter      ElectionVoter      @relation(fields: [voterId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([expiresAt])
}

model VotingRateBucket {
  key       String   @id @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model VotingAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  periodId       String?  @db.Uuid
  actorAccountId String?
  event          String   @db.VarChar(64)
  targetId       String?  @db.VarChar(64)
  reasonCode     String?  @db.VarChar(64)
  detail         Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  actor          Account? @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([periodId, createdAt])
  @@index([actorAccountId, createdAt])
}

model AccountRole {
  id        String  @id @default(cuid())
  accountId String
  role      String // superadmin | staf | guru | siswa
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role])
}

model AccountOverride {
  id         String  @id @default(cuid())
  accountId  String
  capability String
  effect     String // grant | revoke
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, capability, effect])
  @@index([accountId])
}

// ──── SETTINGS ────

model Setting {
  id               String  @id @default("main")
  siteName         String?
  siteShortName    String?
  tagline          String?
  address          String?
  phone            String?
  email            String?
  wa               String?
  instagram        String?
  facebook         String?
  tiktok           String?
  youtube          String?
  metaDefaultTitle String?
  metaDefaultDesc  String?
}

// ──── MASTER WILAYAH (untuk dropdown domisili — konsistensi data) ────

model Province {
  id   String @id // kode BPS, mis. "35"
  name String
}

model Regency {
  id         String @id // kode BPS, mis. "3524"
  provinceId String
  name       String // "Kabupaten Lamongan" | "Kota Surabaya"

  @@index([provinceId])
}

// ──── MEDIA LIBRARY ────

model Media {
  id        String   @id @default(cuid())
  url       String // public URL (via /api/image proxy)
  filename  String // original file name
  mimeType  String?
  size      Int? // bytes (compressed)
  folder    String?  @default("uploads")
  kind      String   @default("image") // image | file — image pickers show only "image"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}
