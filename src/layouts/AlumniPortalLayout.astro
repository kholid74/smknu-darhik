---
export interface Props {
  title: string;
  active?: 'beranda' | 'kartu' | 'profil' | 'kontribusi';
  nama: string;
  alumniId?: string | null;
}
const { title, active = 'beranda', nama, alumniId } = Astro.props;
const nav = [
  { key: 'beranda', label: 'Beranda', icon: 'home', href: '/alumni/portal' },
  { key: 'kartu', label: 'Kartu', icon: 'badge', href: '/alumni/portal/kartu' },
  { key: 'profil', label: 'Profil', icon: 'person', href: '/alumni/portal/profil' },
  { key: 'kontribusi', label: 'Kontribusi', icon: 'volunteer_activism', href: '/alumni/portal/kontribusi' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title} — Portal Alumni SMKS NU Darul Hikam</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
      :root { --green: #1B7A3D; --ink: #1c1b1b; --muted: #6f7a6e; }
      * { box-sizing: border-box; margin: 0; }
      body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f4f1ee; color: var(--ink); min-height: 100vh; }
      .topbar { background: #fff; border-bottom: 1px solid rgba(0,0,0,.07); position: sticky; top: 0; z-index: 20; }
      .topbar-in { max-width: 900px; margin: 0 auto; display: flex; align-items: center; gap: 12px; padding: 12px 20px; }
      .topbar img { width: 30px; height: 30px; }
      .topbar .t { font-size: 14px; font-weight: 800; }
      .topbar .who { margin-left: auto; font-size: 13px; color: var(--muted); text-align: right; line-height: 1.3; }
      .topbar .who strong { color: var(--ink); }
      .logout { border: 1px solid #d9ddd7; background: #fff; border-radius: 9px; padding: 8px 12px; font-size: 12.5px; font-weight: 700; color: #b91c1c; cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; gap: 4px; }
      .shell { max-width: 900px; margin: 0 auto; padding: 20px; }
      .nav { display: flex; gap: 6px; margin-bottom: 18px; flex-wrap: wrap; }
      .nav a { display: inline-flex; align-items: center; gap: 6px; padding: 9px 14px; border-radius: 10px; font-size: 13.5px; font-weight: 700; text-decoration: none; color: var(--muted); background: #fff; border: 1px solid rgba(0,0,0,.06); }
      .nav a[data-active] { background: var(--green); color: #fff; border-color: var(--green); }
      .nav a .material-symbols-outlined { font-size: 18px; }
      main { display: block; }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-in">
        <img src="/assets/logo.png" alt="Logo" />
        <span class="t">Portal Alumni</span>
        <div class="who">
          <strong>{nama}</strong>{alumniId && <span> · <span style="font-family:monospace">{alumniId}</span></span>}
        </div>
        <form method="POST" action="/alumni/logout" style="margin:0">
          <button class="logout" type="submit"><span class="material-symbols-outlined" style="font-size:16px">logout</span> Keluar</button>
        </form>
      </div>
    </header>

    <div class="shell">
      <nav class="nav">
        {nav.map((n) => (
          <a href={n.href} data-active={active === n.key || undefined}>
            <span class="material-symbols-outlined">{n.icon}</span> {n.label}
          </a>
        ))}
      </nav>
      <main><slot /></main>
    </div>
  </body>
</html>
