---
import '../styles/portal-tokens.css';
import '../styles/admin.css';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ConfirmDialog from '../components/ui/ConfirmDialog.astro';
import Icon from '../components/ui/Icon.astro';
import FontHead from '../components/ui/FontHead.astro';
import { site } from '../data/site';
import { can } from '../lib/rbac';

interface Props {
  title: string;
  user?: { role: string };
}

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;

// Izin efektif disuplai middleware (locals.principal). Menu disaring per kapabilitas.
const principal = Astro.locals.principal;
const allow = (cap: string) => (principal ? can(principal, cap) : false);
// Menu guru muncul bila benar-benar ber-role guru (bukan lewat wildcard superadmin).
const isGuru = principal?.roles.includes('guru') ?? false;

const allGroups = [
  ...(allow('student.kelola') || allow('evoting.lihat') ? [{
    label: 'Modul',
    icon: 'how_to_vote',
    items: [
      { label: 'Pemilihan', href: '/admin/e-voting', cap: 'evoting.lihat' },
      { label: 'Jenis Pemilihan', href: '/admin/e-voting/jenis', cap: 'evoting.lihat' },
      { label: 'Absensi', href: null, cap: null, comingSoon: true },
    ],
  }] : []),
  ...(isGuru
    ? [{
        label: 'Guru',
        icon: 'badge',
        items: [
          { label: 'Profil Saya', href: '/admin/profil-saya', cap: 'profil.edit-sendiri' },
          { label: 'Usulan Saya', href: '/admin/usulan', cap: 'konten.usul' },
        ],
      }]
    : []),
  {
    label: 'Konten Website',
    icon: 'edit_note',
    items: [
      { label: 'Artikel', href: '/admin/artikel', cap: 'artikel.kelola' },
      { label: 'Halaman Statis', href: '/admin/halaman', cap: 'halaman.kelola' },
      { label: 'Pengumuman', href: '/admin/pengumuman', cap: 'pengumuman.kelola' },
      { label: 'FAQ', href: '/admin/faq', cap: 'faq.kelola' },
    ],
  },
  {
    label: 'Data Sekolah',
    icon: 'school',
    items: [
      { label: 'Data Siswa', href: '/admin/siswa', cap: 'student.kelola' },
      { label: 'Master Kelas', href: '/admin/kelas', cap: 'student.kelola' },
      { label: 'Jurusan', href: '/admin/jurusan', cap: 'jurusan.kelola' },
      { label: 'Guru & Staf', href: '/admin/guru', cap: 'guru.kelola' },
      { label: 'Fasilitas', href: '/admin/fasilitas', cap: 'fasilitas.kelola' },
      { label: 'Ekstrakurikuler', href: '/admin/ekskul', cap: 'ekskul.kelola' },
      { label: 'Mitra Industri', href: '/admin/mitra', cap: 'mitra.kelola' },
    ],
  },
  {
    label: 'Prestasi & Alumni',
    icon: 'emoji_events',
    items: [
      { label: 'Prestasi', href: '/admin/prestasi', cap: 'prestasi.kelola' },
      { label: 'Testimoni', href: '/admin/testimoni', cap: 'testimoni.kelola' },
      { label: 'Alumni', href: '/admin/alumni', cap: 'alumni.moderasi' },
      { label: 'Kontribusi Alumni', href: '/admin/kontribusi', cap: 'kontribusi.kelola' },
    ],
  },
  {
    label: 'Media',
    icon: 'perm_media',
    items: [
      { label: 'Pustaka Media', href: '/admin/media', cap: 'media.kelola' },
      { label: 'Galeri Foto', href: '/admin/galeri', cap: 'galeri.kelola' },
      { label: 'Download', href: '/admin/download', cap: 'download.kelola' },
    ],
  },
  {
    label: 'Pengaturan',
    icon: 'settings',
    items: [
      { label: 'Informasi Sekolah', href: '/admin/pengaturan', cap: 'setting.kelola' },
      { label: 'Pengguna', href: '/admin/pengguna', cap: 'account.kelola' },
    ],
  },
];

// Sisakan hanya item yang diizinkan; buang grup yang jadi kosong.
const groups = allGroups
  .map((g) => ({ ...g, items: g.items.filter((i) => i.comingSoon || (i.cap && allow(i.cap))) }))
  .filter((g) => g.items.length > 0);

const currentModule = groups.flatMap(group=>group.items).filter(item=>item.href && currentPath.startsWith(item.href)).sort((a,b)=>b.href!.length-a.href!.length)[0];
const breadcrumbItems = [{label:'Dashboard',href:currentPath==='/admin'?undefined:'/admin'}, ...(currentModule ? [{label:currentModule.label,href:currentPath===currentModule.href?undefined:currentModule.href!}] : []), ...(currentPath!=='/admin' && title!==currentModule?.label ? [{label:title}] : [])];
const roleLabel: Record<string, string> = { superadmin: 'Super Admin', staf: 'Staf', guru: 'Guru', siswa: 'Siswa' };
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title} — Admin {site.shortName}</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-v1.png"/>
  <FontHead symbols="full" />

</head>
<body>
  <a class="skip-link" href="#admin-main">Lewati navigasi</a>
  <!-- Sidebar -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>
  <aside class="sidebar" id="sidebar">
    <div style="padding:20px 16px;border-bottom:1px solid rgba(255,255,255,0.1);text-align:center">
      <img src="/assets/logo-v1.webp" alt="Logo" width="113" height="113" style="width:48px;height:48px;margin-bottom:8px"/>
      <div style="font-size:15px;font-weight:800">{site.shortName}</div>
      <div style="font-size:11px;color:rgba(255,255,255,0.72)">Admin Panel</div>
    </div>
    <nav style="flex:1;padding:8px">
      <a href="/admin" class:list={['', { active: currentPath === '/admin' }]}>
        <Icon name="dashboard"/> Dashboard
      </a>
      {groups.map(g => {
        const groupActive = g.items.some(i => i.href && currentPath.startsWith(i.href));
        const groupId='sidebar-group-'+g.label.toLowerCase().replace(/[^a-z]+/g,'-');
        return (
          <div class="sidebar-group" data-group={g.label} data-active={String(groupActive)}>
            <button type="button" class="sidebar-group-toggle" aria-controls={groupId} aria-expanded={groupActive ? 'true' : 'false'}>
              <Icon name={g.icon} size={18}/>
              <span>{g.label}</span>
              <Icon name="expand_more" class="sidebar-chevron" size={18}/>
            </button>
            <div class="sidebar-group-items" id={groupId} data-open={String(groupActive)}>
              <div class="sidebar-group-inner">
                {g.items.map(i => i.href ? (
                  <a href={i.href} aria-current={currentModule?.href===i.href?'page':undefined} class:list={[{ active: currentModule?.href===i.href }]}>
                    {i.label}
                  </a>
                ) : (
                  <span class="sidebar-coming-soon" aria-disabled="true">
                    {i.label}<small>Segera hadir</small>
                  </span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </nav>
    <div style="padding:16px;border-top:1px solid rgba(255,255,255,0.1)">
      <a href="/" target="_blank" style="font-size:12px;color:rgba(255,255,255,0.78)">
        <Icon name="open_in_new" size={16}/> Lihat Website
      </a>
      <a href="/admin/logout" id="logout-link" style="font-size:12px;color:rgba(255,255,255,0.78);margin-top:4px;cursor:pointer">
        <Icon name="logout" size={16}/> Keluar
      </a>
    </div>
  </aside>

  <ConfirmDialog id="logout-modal" title="Keluar dari dashboard?" message="Anda akan kembali ke halaman masuk." confirmLabel="Keluar" />
  <ConfirmDialog id="delete-modal" title="Hapus data ini?" message="Tindakan ini tidak dapat dibatalkan." confirmLabel="Hapus" danger />
  <ConfirmDialog id="action-confirm-dialog" title="Konfirmasi tindakan" message="Periksa sebelum melanjutkan." />

  <!-- Flash Message -->
  {Astro.url.searchParams.get('saved') && (
    <div id="flash-msg" role="status" aria-live="polite" style="position:fixed;top:16px;right:16px;z-index:120;background:#1B7A3D;color:white;padding:12px 24px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.15);display:flex;align-items:center;gap:8px;animation:fadeIn 0.3s">
      <Icon name="check_circle"/> Berhasil disimpan
    </div>
  )}

  <!-- Main -->
  <div class="main-content">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:8px;min-width:0">
        <button class="menu-btn" id="menu-btn" aria-label="Buka menu" aria-controls="sidebar" aria-expanded="false" style="background:none;border:none;padding:6px;color:var(--color-ink);align-items:center">
          <Icon name="menu"/>
        </button>
        <div style="font-weight:700;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{title}</div>
      </div>
      <div style="font-size:12px;color:#6f7a6e;display:flex;align-items:center;gap:12px">
        <span>{new Date().toLocaleDateString('id', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <span style="background:#e8f5e9;color:#1B7A3D;padding:2px 10px;border-radius:100px;font-weight:600">{roleLabel[user?.role || ''] || user?.role || 'Pengguna'}</span>
      </div>
    </div>
    <main class="page-body" id="admin-main" tabindex="-1">
      <Breadcrumbs items={breadcrumbItems}/><slot/>
    </main>
  </div>

  <style>
    @keyframes fadeIn { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:translateY(0)} }
    #flash-msg { animation: fadeIn 0.3s ease-out, fadeOut 0.3s 2.7s ease-in forwards; }
    @keyframes fadeOut { to{opacity:0;transform:translateY(-10px)} }
  </style>

  <script>
    let pendingForm: HTMLFormElement | null = null;
    const deleteDialog=document.querySelector<HTMLDialogElement>('#delete-modal')!;
    document.addEventListener('submit',event=>{
      const form=event.target;
      if(!(form instanceof HTMLFormElement)||form.method.toLowerCase()!=='post'||!form.action.includes('/delete'))return;
      event.preventDefault();pendingForm=form;deleteDialog.returnValue='cancel';deleteDialog.showModal();
    });
    deleteDialog.addEventListener('close',()=>{if(deleteDialog.returnValue==='confirm')pendingForm?.submit();pendingForm=null});
    const flash=document.getElementById('flash-msg');
    if(flash)setTimeout(()=>flash.remove(),5000);

    // Mobile drawer sidebar
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const menuBtn = document.getElementById('menu-btn');
    function setDrawer(open: boolean) {
      sidebar?.classList.toggle('open', open);
      overlay?.classList.toggle('open', open);
      menuBtn?.setAttribute('aria-expanded', String(open));
      if(window.matchMedia('(max-width:768px)').matches){
        if(sidebar)sidebar.inert=!open;
        document.querySelector<HTMLElement>('.main-content')!.inert=open;
        document.body.style.overflow=open?'hidden':'';
        if(open)sidebar?.querySelector<HTMLAnchorElement>('a')?.focus();else menuBtn?.focus();
      }
    }
    menuBtn?.addEventListener('click', () => setDrawer(!sidebar?.classList.contains('open')));
    overlay?.addEventListener('click', () => setDrawer(false));
    const mobile=window.matchMedia('(max-width:768px)');
    const resetDrawer=()=>{setDrawer(false);if(sidebar)sidebar.inert=mobile.matches;document.querySelector<HTMLElement>('.main-content')!.inert=false;document.body.style.overflow=''};
    mobile.addEventListener('change',resetDrawer);resetDrawer();
    sidebar?.addEventListener('keydown',event=>{if(event.key!=='Tab'||!mobile.matches)return;const items=[...sidebar.querySelectorAll<HTMLElement>('a,button')].filter(el=>!el.closest('[inert]'));const first=items[0],last=items.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus()}});

    sidebar?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setDrawer(false)));

    // Accordion groups: multi-open, active group forced open, rest from localStorage.
    const GROUP_KEY = 'smkdh_sidebar_groups';
    let groupState: Record<string, boolean> = {};
    try { groupState = JSON.parse(localStorage.getItem(GROUP_KEY) || '{}'); } catch {}
    document.querySelectorAll<HTMLElement>('.sidebar-group').forEach(group => {
      const label = group.dataset.group || '';
      const toggle = group.querySelector<HTMLButtonElement>('.sidebar-group-toggle');
      const panel = group.querySelector<HTMLElement>('.sidebar-group-items');
      if (!toggle || !panel) return;
      const isActive = group.dataset.active === 'true';
      const apply = (open: boolean) => {
        panel.dataset.open = String(open);
        panel.inert=!open;
        toggle.setAttribute('aria-expanded', String(open));
      };
      // Active group always opens; others restore their saved state.
      apply(isActive || (label in groupState ? groupState[label] : false));
      toggle.addEventListener('click', () => {
        const next = panel.dataset.open !== 'true';
        apply(next);
        groupState[label] = next;
        try { localStorage.setItem(GROUP_KEY, JSON.stringify(groupState)); } catch {}
      });
    });

    // Logout confirmation modal (lives at body level, opened from the sidebar link)
    const logoutLink = document.getElementById('logout-link');
    const logoutModal = document.querySelector<HTMLDialogElement>('#logout-modal');
    logoutLink?.addEventListener('click', e => {
      e.preventDefault();
      setDrawer(false);
      if(logoutModal){logoutModal.returnValue='cancel';logoutModal.showModal()}
    });
    logoutModal?.addEventListener('close',()=>{if(logoutModal.returnValue==='confirm')location.assign('/admin/logout')});
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      setDrawer(false);
      logoutModal?.close('cancel');
    });

    // Accessible-name backfill: label icon-only buttons/links that ship no text.
    const ICON_LABELS: Record<string, string> = {
      edit: 'Edit', delete: 'Hapus', visibility: 'Lihat', visibility_off: 'Sembunyikan',
      add: 'Tambah', add_photo_alternate: 'Tambah foto', open_in_new: 'Buka di tab baru',
      logout: 'Keluar', menu: 'Buka menu', close: 'Tutup', save: 'Simpan',
      search: 'Cari', settings: 'Pengaturan', arrow_upward: 'Naik', arrow_downward: 'Turun',
    };
    document.querySelectorAll<HTMLElement>('button, a').forEach(el => {
      if (el.getAttribute('aria-label') || el.getAttribute('title')) return;
      const icon = el.querySelector('.material-symbols-outlined');
      if (!icon) return;
      const text = (el.textContent || '').trim();
      const iconName = (icon.textContent || '').trim();
      if (text === iconName && ICON_LABELS[iconName]) el.setAttribute('aria-label', ICON_LABELS[iconName]);
    });
  </script>
</body>
</html>
