---
import { site } from '../data/site';
import { can } from '../lib/rbac';

interface Props {
  title: string;
  user?: { role: string };
}

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;

// Izin efektif disuplai middleware (locals.principal). Menu disaring per kapabilitas.
const principal = Astro.locals.principal;
const allow = (cap: string) => (principal ? can(principal, cap) : false);
// Menu guru muncul bila benar-benar ber-role guru (bukan lewat wildcard superadmin).
const isGuru = principal?.roles.includes('guru') ?? false;

const allGroups = [
  ...(isGuru
    ? [{
        label: 'Guru',
        icon: 'badge',
        items: [
          { label: 'Profil Saya', href: '/admin/profil-saya', cap: 'profil.edit-sendiri' },
          { label: 'Usulan Saya', href: '/admin/usulan', cap: 'konten.usul' },
        ],
      }]
    : []),
  {
    label: 'Konten',
    icon: 'edit_note',
    items: [
      { label: 'Artikel', href: '/admin/artikel', cap: 'artikel.kelola' },
      { label: 'Halaman Statis', href: '/admin/halaman', cap: 'halaman.kelola' },
      { label: 'Pengumuman', href: '/admin/pengumuman', cap: 'pengumuman.kelola' },
    ],
  },
  {
    label: 'Sekolah',
    icon: 'school',
    items: [
      { label: 'Jurusan', href: '/admin/jurusan', cap: 'jurusan.kelola' },
      { label: 'Guru & Staf', href: '/admin/guru', cap: 'guru.kelola' },
      { label: 'Fasilitas', href: '/admin/fasilitas', cap: 'fasilitas.kelola' },
      { label: 'Ekstrakurikuler', href: '/admin/ekskul', cap: 'ekskul.kelola' },
      { label: 'Mitra Industri', href: '/admin/mitra', cap: 'mitra.kelola' },
    ],
  },
  {
    label: 'Prestasi & Bukti',
    icon: 'emoji_events',
    items: [
      { label: 'Prestasi', href: '/admin/prestasi', cap: 'prestasi.kelola' },
      { label: 'Testimoni', href: '/admin/testimoni', cap: 'testimoni.kelola' },
      { label: 'Alumni', href: '/admin/alumni', cap: 'alumni.moderasi' },
      { label: 'Kontribusi Alumni', href: '/admin/kontribusi', cap: 'kontribusi.kelola' },
      { label: 'FAQ', href: '/admin/faq', cap: 'faq.kelola' },
    ],
  },
  {
    label: 'Media',
    icon: 'perm_media',
    items: [
      { label: 'Pustaka Media', href: '/admin/media', cap: 'media.kelola' },
      { label: 'Galeri Foto', href: '/admin/galeri', cap: 'galeri.kelola' },
      { label: 'Download', href: '/admin/download', cap: 'download.kelola' },
    ],
  },
  {
    label: 'Pengaturan',
    icon: 'settings',
    items: [
      { label: 'Informasi Sekolah', href: '/admin/pengaturan', cap: 'setting.kelola' },
      { label: 'Pengguna', href: '/admin/pengguna', cap: 'account.kelola' },
    ],
  },
];

// Sisakan hanya item yang diizinkan; buang grup yang jadi kosong.
const groups = allGroups
  .map((g) => ({ ...g, items: g.items.filter((i) => allow(i.cap)) }))
  .filter((g) => g.items.length > 0);

const roleLabel: Record<string, string> = { superadmin: 'Super Admin', staf: 'Staf', guru: 'Guru', siswa: 'Siswa' };
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title} — Admin {site.shortName}</title>
  <link rel="icon" type="image/png" href="/assets/logo.png"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style is:global>
    /* Design tokens — single source for brand colour + contrast-safe neutrals.
       Values kept as source hex to preserve exact brand green; only the washed
       grey (#6f7a6e) is darkened to --color-muted to clear WCAG AA. */
    :root{
      --color-brand:#00602b; --color-accent:#1B7A3D; --color-accent-dark:#145a2d;
      --color-ink:#1c1b1b; --color-muted:#5a6459; --color-muted-strong:#3f493f;
      --color-paper:#f6f3f2; --color-line:rgba(0,0,0,0.08); --color-danger:#dc2626;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html,body{overflow-x:clip}
    body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:var(--color-paper);color:var(--color-ink);min-height:100vh}
    /* Keyboard focus — visible ring on every interactive element, shown instantly. */
    :focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;border-radius:4px}
    .sidebar a:focus-visible,.sidebar button:focus-visible{outline-color:#fff}
    /* Contrast backfill: darken washed grey wherever it was hardcoded inline. */
    [style*="color:#6f7a6e"]{color:var(--color-muted)!important}
    .material-symbols-outlined{font-family:'Material Symbols Outlined';font-weight:400;font-style:normal;font-size:20px;line-height:1;display:inline-block}
    .sidebar{width:240px;background:#00602b;color:white;position:fixed;top:0;left:0;bottom:0;z-index:40;overflow-y:auto;display:flex;flex-direction:column}
    .sidebar a,.sidebar button{color:white;background:transparent;border:none;text-decoration:none;display:flex;align-items:center;gap:10px;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:500;transition:background .15s}
    .sidebar a:hover,.sidebar button:hover{background:rgba(255,255,255,0.1)}
    .sidebar a.active{background:rgba(255,255,255,0.2);font-weight:700}
    .sidebar-group-label{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.72);padding:16px 16px 6px;font-weight:700}
    /* Accordion group: header toggles a collapsible panel of items. */
    .sidebar-group{margin-top:4px}
    .sidebar button.sidebar-group-toggle{width:100%;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.72);padding:11px 16px}
    .sidebar button.sidebar-group-toggle:hover{color:#fff}
    .sidebar-group-toggle .sidebar-chevron{margin-left:auto;font-size:18px;transition:transform .2s ease}
    .sidebar-group-toggle[aria-expanded="true"] .sidebar-chevron{transform:rotate(180deg)}
    /* grid 0fr->1fr gives a smooth height animation without measuring. */
    .sidebar-group-items{display:grid;grid-template-rows:0fr;transition:grid-template-rows .2s ease}
    .sidebar-group-items[data-open="true"]{grid-template-rows:1fr}
    .sidebar-group-inner{overflow:hidden;min-height:0;display:flex;flex-direction:column;gap:2px;padding-left:6px}
    .sidebar-group-inner a{font-size:13px}
    .main-content{margin-left:240px;min-height:100vh}
    .topbar{background:white;border-bottom:1px solid rgba(0,0,0,0.06);padding:12px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:30}
    .page-body{padding:24px}
    a{color:#1B7A3D}
    button{cursor:pointer}
    input,select,textarea{border:1px solid rgba(0,0,0,0.12);border-radius:8px;padding:10px 14px;font-size:14px;font-family:inherit;width:100%}
    input:focus,select:focus,textarea:focus{outline:none;border-color:#1B7A3D;box-shadow:0 0 0 2px rgba(27,122,61,0.15)}
    .btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:700;border:none;transition:all .15s}
    .btn-primary{background:#1B7A3D;color:white}.btn-primary:hover{background:#145a2d}
    .btn-outline{background:white;border:1px solid rgba(0,0,0,0.12);color:#3f493f}.btn-outline:hover{background:#f0f7f1}
    .card{background:white;border-radius:12px;border:1px solid rgba(0,0,0,0.06);padding:20px}
    table{width:100%;border-collapse:collapse}
    th,td{text-align:left;padding:10px 14px;border-bottom:1px solid rgba(0,0,0,0.06);font-size:13px}
    th{font-weight:700;color:var(--color-muted);font-size:12px;text-transform:uppercase}
    /* Sortable table headers (SortTh + tableSort) */
    .th-sort{display:inline-flex;align-items:center;gap:4px;color:inherit;text-decoration:none;cursor:pointer;user-select:none;white-space:nowrap}
    .th-sort:hover{color:var(--color-accent)}
    .th-sort .material-symbols-outlined{font-size:15px;opacity:.35}
    .th-sort[data-active]{color:var(--color-accent)}
    .th-sort[data-active] .material-symbols-outlined{opacity:1}
    .menu-btn{display:none}
    .badge{display:inline-block;padding:2px 8px;border-radius:100px;font-size:11px;font-weight:700}
    .badge-green{background:#e8f5e9;color:#1B7A3D}
    .badge-gold{background:#fdf6e8;color:#7e5700}
    .badge-gray{background:#f0f0f0;color:var(--color-muted)}
    .sidebar-overlay{display:none}
    /* Mobile: sidebar becomes an off-canvas drawer, tables scroll, grids stack. */
    @media (max-width:768px){
      .main-content{margin-left:0}
      .menu-btn{display:inline-flex}
      .sidebar{transform:translateX(-100%);transition:transform .2s var(--ease,ease);box-shadow:0 0 40px rgba(0,0,0,0.35)}
      .sidebar.open{transform:translateX(0)}
      .sidebar-overlay{display:block;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:39;opacity:0;pointer-events:none;transition:opacity .2s}
      .sidebar-overlay.open{opacity:1;pointer-events:auto}
      table{min-width:620px}
      .card{overflow-x:auto}
      [style*="grid-template-columns"]{grid-template-columns:1fr!important}
    }
    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
    }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>
  <aside class="sidebar" id="sidebar">
    <div style="padding:20px 16px;border-bottom:1px solid rgba(255,255,255,0.1);text-align:center">
      <img src="/assets/logo.png" alt="Logo" style="width:48px;height:48px;margin-bottom:8px"/>
      <div style="font-size:15px;font-weight:800">{site.shortName}</div>
      <div style="font-size:11px;color:rgba(255,255,255,0.72)">Admin Panel</div>
    </div>
    <nav style="flex:1;padding:8px">
      <a href="/admin" class:list={['', { active: currentPath === '/admin' }]}>
        <span class="material-symbols-outlined">dashboard</span> Dashboard
      </a>
      {groups.map(g => {
        const groupActive = g.items.some(i => currentPath.startsWith(i.href));
        return (
          <div class="sidebar-group" data-group={g.label} data-active={String(groupActive)}>
            <button type="button" class="sidebar-group-toggle" aria-expanded={groupActive ? 'true' : 'false'}>
              <span class="material-symbols-outlined" style="font-size:18px">{g.icon}</span>
              <span>{g.label}</span>
              <span class="material-symbols-outlined sidebar-chevron">expand_more</span>
            </button>
            <div class="sidebar-group-items" data-open={String(groupActive)}>
              <div class="sidebar-group-inner">
                {g.items.map(i => (
                  <a href={i.href} class:list={[{ active: currentPath.startsWith(i.href) }]}>
                    {i.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </nav>
    <div style="padding:16px;border-top:1px solid rgba(255,255,255,0.1)">
      <a href="/" target="_blank" style="font-size:12px;color:rgba(255,255,255,0.78)">
        <span class="material-symbols-outlined" style="font-size:16px">open_in_new</span> Lihat Website
      </a>
      <a href="/admin/logout" id="logout-link" style="font-size:12px;color:rgba(255,255,255,0.78);margin-top:4px;cursor:pointer">
        <span class="material-symbols-outlined" style="font-size:16px">logout</span> Keluar
      </a>
    </div>
  </aside>

  <!-- Custom Logout Modal — kept at body level: nesting it inside the sidebar
       trapped position:fixed inside the sidebar's mobile transform. -->
  <div id="logout-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center;padding:16px">
    <div style="background:white;border-radius:16px;padding:32px;max-width:360px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.2)">
      <span class="material-symbols-outlined" style="font-size:48px;color:#C8963E;margin-bottom:12px">logout</span>
      <h3 style="font-size:18px;font-weight:800;margin-bottom:8px;color:#1c1b1b">Yakin ingin keluar?</h3>
      <p style="font-size:14px;color:#6f7a6e;margin-bottom:24px">Kamu akan diarahkan ke halaman login.</p>
      <div style="display:flex;gap:10px;justify-content:center">
        <button onclick="document.getElementById('logout-modal').style.display='none'" style="padding:10px 24px;border:1px solid #d1d5db;border-radius:10px;background:white;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;color:#3f493f">Batal</button>
        <a href="/admin/logout" style="padding:10px 24px;border-radius:10px;background:#dc2626;color:white;font-size:14px;font-weight:700;text-decoration:none;display:inline-block">Keluar</a>
      </div>
    </div>
  </div>

  <!-- Shared Delete Confirm Modal -->
  <div id="delete-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:110;align-items:center;justify-content:center">
    <div style="background:white;border-radius:16px;padding:32px;max-width:380px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.2)">
      <span class="material-symbols-outlined" style="font-size:48px;color:#dc2626;margin-bottom:12px">delete_forever</span>
      <h3 style="font-size:18px;font-weight:800;margin-bottom:8px;color:#1c1b1b">Hapus data ini?</h3>
      <p style="font-size:14px;color:#6f7a6e;margin-bottom:24px">Tindakan ini tidak dapat dibatalkan.</p>
      <div style="display:flex;gap:10px;justify-content:center">
        <button onclick="document.getElementById('delete-modal').style.display='none'" style="padding:10px 24px;border:1px solid #d1d5db;border-radius:10px;background:white;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;color:#3f493f">Batal</button>
        <button id="delete-confirm-btn" style="padding:10px 24px;border-radius:10px;background:#dc2626;color:white;font-size:14px;font-weight:700;cursor:pointer;border:none;font-family:inherit">Hapus</button>
      </div>
    </div>
  </div>

  <!-- Flash Message -->
  {Astro.url.searchParams.get('saved') && (
    <div id="flash-msg" style="position:fixed;top:16px;right:16px;z-index:120;background:#1B7A3D;color:white;padding:12px 24px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.15);display:flex;align-items:center;gap:8px;animation:fadeIn 0.3s">
      <span class="material-symbols-outlined">check_circle</span> Berhasil disimpan
    </div>
  )}

  <!-- Main -->
  <div class="main-content">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:8px;min-width:0">
        <button class="menu-btn" id="menu-btn" aria-label="Buka menu" aria-controls="sidebar" aria-expanded="false" style="background:none;border:none;padding:6px;color:var(--color-ink);align-items:center">
          <span class="material-symbols-outlined">menu</span>
        </button>
        <div style="font-weight:700;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{title}</div>
      </div>
      <div style="font-size:12px;color:#6f7a6e;display:flex;align-items:center;gap:12px">
        <span>{new Date().toLocaleDateString('id', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <span style="background:#e8f5e9;color:#1B7A3D;padding:2px 10px;border-radius:100px;font-weight:600">{roleLabel[user?.role || ''] || user?.role || 'Pengguna'}</span>
      </div>
    </div>
    <div class="page-body">
      <slot />
    </div>
  </div>

  <style>
    @keyframes fadeIn { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:translateY(0)} }
    #flash-msg { animation: fadeIn 0.3s ease-out, fadeOut 0.3s 2.7s ease-in forwards; }
    @keyframes fadeOut { to{opacity:0;transform:translateY(-10px)} }
  </style>

  <script>
    // Intercept all delete forms — show custom modal
    let pendingForm: HTMLFormElement | null = null;
    document.addEventListener('submit', function(e) {
      const form = e.target as HTMLFormElement;
      if (form.method.toLowerCase() === 'post' && form.action.includes('/delete')) {
        e.preventDefault();
        pendingForm = form;
        document.getElementById('delete-modal')!.style.display = 'flex';
      }
    });
    document.getElementById('delete-confirm-btn')!.addEventListener('click', function() {
      if (pendingForm) {
        document.getElementById('delete-modal')!.style.display = 'none';
        pendingForm.submit();
      }
    });
    // Auto-hide flash message
    const flash = document.getElementById('flash-msg');
    if (flash) setTimeout(() => flash.remove(), 3000);

    // Mobile drawer sidebar
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const menuBtn = document.getElementById('menu-btn');
    function setDrawer(open: boolean) {
      sidebar?.classList.toggle('open', open);
      overlay?.classList.toggle('open', open);
      menuBtn?.setAttribute('aria-expanded', String(open));
    }
    menuBtn?.addEventListener('click', () => setDrawer(!sidebar?.classList.contains('open')));
    overlay?.addEventListener('click', () => setDrawer(false));
    sidebar?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setDrawer(false)));

    // Accordion groups: multi-open, active group forced open, rest from localStorage.
    const GROUP_KEY = 'smkdh_sidebar_groups';
    let groupState: Record<string, boolean> = {};
    try { groupState = JSON.parse(localStorage.getItem(GROUP_KEY) || '{}'); } catch {}
    document.querySelectorAll<HTMLElement>('.sidebar-group').forEach(group => {
      const label = group.dataset.group || '';
      const toggle = group.querySelector<HTMLButtonElement>('.sidebar-group-toggle');
      const panel = group.querySelector<HTMLElement>('.sidebar-group-items');
      if (!toggle || !panel) return;
      const isActive = group.dataset.active === 'true';
      const apply = (open: boolean) => {
        panel.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      // Active group always opens; others restore their saved state.
      apply(isActive || (label in groupState ? groupState[label] : false));
      toggle.addEventListener('click', () => {
        const next = panel.dataset.open !== 'true';
        apply(next);
        groupState[label] = next;
        try { localStorage.setItem(GROUP_KEY, JSON.stringify(groupState)); } catch {}
      });
    });

    // Logout confirmation modal (lives at body level, opened from the sidebar link)
    const logoutLink = document.getElementById('logout-link');
    const logoutModal = document.getElementById('logout-modal');
    logoutLink?.addEventListener('click', e => {
      e.preventDefault();
      setDrawer(false);
      if (logoutModal) logoutModal.style.display = 'flex';
    });
    logoutModal?.addEventListener('click', e => {
      if (e.target === logoutModal) logoutModal.style.display = 'none';
    });
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      setDrawer(false);
      if (logoutModal) logoutModal.style.display = 'none';
    });

    // Accessible-name backfill: label icon-only buttons/links that ship no text.
    const ICON_LABELS: Record<string, string> = {
      edit: 'Edit', delete: 'Hapus', visibility: 'Lihat', visibility_off: 'Sembunyikan',
      add: 'Tambah', add_photo_alternate: 'Tambah foto', open_in_new: 'Buka di tab baru',
      logout: 'Keluar', menu: 'Buka menu', close: 'Tutup', save: 'Simpan',
      search: 'Cari', settings: 'Pengaturan', arrow_upward: 'Naik', arrow_downward: 'Turun',
    };
    document.querySelectorAll<HTMLElement>('button, a').forEach(el => {
      if (el.getAttribute('aria-label') || el.getAttribute('title')) return;
      const icon = el.querySelector('.material-symbols-outlined');
      if (!icon) return;
      const text = (el.textContent || '').trim();
      const iconName = (icon.textContent || '').trim();
      if (text === iconName && ICON_LABELS[iconName]) el.setAttribute('aria-label', ICON_LABELS[iconName]);
    });
  </script>
</body>
</html>
