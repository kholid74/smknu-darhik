---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import AnnounceBar from '../components/AnnounceBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import FontHead from '../components/ui/FontHead.astro';
import type { TextAnnouncement } from '../lib/announcements';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  iconNames?: (string | null | undefined)[];
  announcements?: TextAnnouncement[];
}
const { title, description, iconNames, announcements } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SMKS NU Darul Hikam Karanggeneng</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-v1.png" />
    <FontHead iconNames={iconNames} />
  </head>
  <body class="bg-[#fcf9f8] text-[#1c1b1b] font-sans antialiased">
    <AnnounceBar announcements={announcements} />
    <Header />
    <MobileMenu />

    <main>
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      const mo = document.getElementById('menu-open');
      const mc = document.getElementById('menu-close');
      const mm = document.getElementById('mobile-menu');
      mo?.addEventListener('click', () => { mm?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; });
      mc?.addEventListener('click', () => { mm?.classList.add('hidden'); document.body.style.overflow = ''; });
    </script>
  </body>
</html>
