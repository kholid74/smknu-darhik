---
import CandidatePortraits from '../../../../../components/voting/CandidatePortraits.astro';
import StudentPortalLayout from '../../../../../layouts/StudentPortalLayout.astro';
import { votingCsrfSecret } from '../../../../../lib/voting/student-auth';
import { createStudentSessionCsrfToken } from '../../../../../lib/voting/security';
import { BallotPageError, getOrganizationCandidates } from '../../../../../lib/voting/ballot-pages';
import { thumbnailUrl } from '../../../../../lib/image-url';
import { env } from '../../../../../lib/env';

import { voterPortal } from '../../../../../lib/voting/voter-identity';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('X-Frame-Options', 'DENY');
const session = Astro.locals.votingSession;
const base = voterPortal(session?.voterType);
if (!session) return Astro.redirect(`${base}/masuk`);
let data;
try { data = Astro.props.data ?? await getOrganizationCandidates(session.periodId, Astro.params.slug!, session.voterId, Astro.params.organization!); }
catch (error) {
  if (error instanceof BallotPageError && error.code === 'INVALID_ORGANIZATION') return new Response('Not Found', {status:404});
  if (error instanceof BallotPageError && error.code === 'ALREADY_VOTED') return Astro.redirect(`${base}/e-voting/${Astro.params.slug}/pilih`);
  if (error instanceof BallotPageError && error.code === 'UNAUTHENTICATED') return Astro.redirect(`${base}/masuk`);
  return Astro.redirect(base);
}
const csrfToken = createStudentSessionCsrfToken(votingCsrfSecret(), session.id);
const contest=data.contests.find(c=>c.organization===Astro.params.organization);
if(!contest)return new Response('Not Found',{status:404});
const organization={id:contest.organization,label:contest.name};
const completed=data.contests.filter(c=>data.participation[c.organization]).length;
const membersOf = (candidate: typeof data.candidates[number]) => ({
  chair: candidate.members.find((member) => member.position === 'CHAIR')!,
  vice: candidate.members.find((member) => member.position === 'VICE_CHAIR'),
});
---
<StudentPortalLayout title={`Pilih ${organization.label}`} csrfToken={csrfToken} periodId={session.periodId}>
  <a class="back" href={`${base}/e-voting/${data.period.slug}/pilih`}>← Semua organisasi</a>
  <p class="eyebrow">E-VOTING · {data.period.name}</p>
  <div class="contest-title">
    {contest.logoUrl && <img src={thumbnailUrl(contest.logoUrl,128,Astro.url.origin,env('R2_PUBLIC_URL'))} width="64" height="64" alt="" decoding="async"/>}
    <h1>Pemilihan {organization.label}</h1>
  </div>
  <div class="voting-progress"><span>{completed} dari {data.contests.length} pemilihan selesai</span><progress aria-label="Kemajuan pemilihan" value={completed} max={data.contests.length}></progress></div>
  <p class="intro">Baca visi dan misi, lalu pilih satu calon. Pilihan yang dikirim tidak dapat diubah.</p>
  <form id="vote-form" method="post" data-organization={organization.id} data-slug={data.period.slug}>
    <fieldset>
      <legend class="sr-only">Pilih satu calon</legend>
      <div class="candidate-grid">
        {data.candidates.map((candidate, index) => {
          const { chair, vice } = membersOf(candidate);
          const label = `Nomor ${candidate.ballotNumber}: ${chair.nameSnapshot}${vice ? ' dan ' + vice.nameSnapshot : ''}`;
          return <label class="candidate" for={`candidate-${candidate.id}`}>
            <input id={`candidate-${candidate.id}`} type="radio" name="candidateId" value={candidate.id} data-label={label} required />
            <article>
              <div class="pair-head"><span class="number">{candidate.ballotNumber}</span><span class="choose-hint">Pilih calon</span></div>
              <CandidatePortraits
                chair={{name:chair.nameSnapshot,className:chair.classSnapshot,photoUrl:chair.photoUrl}}
                viceChair={vice ? {name:vice.nameSnapshot,className:vice.classSnapshot,photoUrl:vice.photoUrl} : null}
                chairLabel={contest.chairLabel} viceChairLabel={contest.viceChairLabel} eager={index === 0}
              >
                <div class="statement"><h2>Visi</h2><p>{candidate.vision}</p><h2>Misi</h2><p class="mission">{candidate.mission}</p></div>
              </CandidatePortraits>
            </article>
          </label>;
        })}
      </div>
    </fieldset>
    <button id="review-vote" type="submit" class="review" disabled>Tinjau pilihan</button>
  </form>
  <p id="vote-message" role="status" aria-live="polite"></p>
  <dialog id="confirm-dialog" class="ui-dialog" aria-labelledby="confirm-title">
    <form method="dialog">
      <h2 id="confirm-title">Konfirmasi pilihan</h2>
      <p>Anda akan memberikan suara untuk:</p>
      <p id="confirm-candidate" class="selected-name"></p>
      <p>Suara yang sudah dikirim tidak dapat diubah.</p>
      <div class="dialog-actions"><button class="secondary" value="cancel">Periksa lagi</button><button id="confirm-vote" value="confirm" type="button">Kirim suara</button></div>
    </form>
  </dialog>
  <noscript><p>Pengiriman suara memerlukan JavaScript untuk perlindungan sesi dan konfirmasi.</p></noscript>
</StudentPortalLayout>

<script>
  const base = document.body.dataset.portalBase!;
  const form = document.getElementById('vote-form');
  const periodId=document.body.dataset.periodId!;
  const organizationId=form?.dataset.organization!;
  const slug=form?.dataset.slug!;
  const dialog = document.getElementById('confirm-dialog');
  const message = document.getElementById('vote-message');
  const confirmName = document.getElementById('confirm-candidate');
  let selectedId = '';
  let sending=false;
  dialog?.addEventListener('cancel',event=>{if(sending)event.preventDefault()});
  form?.addEventListener('change',()=>{form.querySelectorAll<HTMLLabelElement>('.candidate').forEach(card=>{card.querySelector('.choose-hint')!.textContent=card.querySelector<HTMLInputElement>('input')!.checked?'✓ Dipilih':'Pilih calon'})});
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !form.reportValidity() || !(dialog instanceof HTMLDialogElement)) return;
    const selected = form.querySelector('input[name="candidateId"]:checked');
    if (!(selected instanceof HTMLInputElement)) return;
    selectedId = selected.value;
    if (confirmName) confirmName.textContent = selected.dataset.label ?? '';
    dialog.showModal();
  });
  document.getElementById('confirm-vote')?.addEventListener('click', async () => {
    const button = document.getElementById('confirm-vote');
    if (!(button instanceof HTMLButtonElement) || !selectedId) return;
    button.disabled = true;
    sending=true;button.textContent='Mengirim…';
    if (message) message.textContent = 'Mengirim suara…';
    try {
      const response = await fetch(`/api/e-voting/${periodId}/votes`, { method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.body.dataset.csrf ?? '' },
        body: JSON.stringify({ organization: organizationId, candidateId: selectedId }) });
      const payload = await response.json();
      if (!response.ok) {
        if (response.status === 409 && payload.error?.code === 'ALREADY_VOTED') { location.assign(`${base}/e-voting/${slug}/pilih`); return; }
        if (response.status === 401 || response.status === 409) { location.assign(`${base}/masuk`); return; }
        throw new Error(response.status === 429 ? 'Terlalu banyak permintaan. Tunggu sebentar lalu periksa status pemilihan.' : 'Pengiriman belum dapat dipastikan. Periksa status sebelum mencoba lagi.');
      }
      location.assign(payload.data.redirectTo ?? `${base}/e-voting/${slug}/pilih`);
    } catch (error) {
      if (dialog instanceof HTMLDialogElement) dialog.close();
      let statusKnown = false;
      try {
        const statusResponse = await fetch(`/api/e-voting/${periodId}/status`, { cache: 'no-store', credentials: 'same-origin' });
        if (!statusResponse.ok) { location.assign(`${base}/masuk`); return; }
        const current = await statusResponse.json();
        statusKnown = true;
        if (current.data.participation[organizationId]) { location.assign(`${base}/e-voting/${slug}/pilih`); return; }
      } catch { /* keep the delivery state unknown while offline */ }
      if (message) message.textContent = statusKnown
        ? 'Suara belum tercatat. Anda dapat meninjau pilihan dan mengirim kembali.'
        : error instanceof Error ? error.message : 'Pengiriman belum dapat dipastikan. Periksa status sebelum mencoba lagi.';
      button.disabled = false;
    }
    finally {sending=false;button.textContent='Kirim suara'}
  });
  document.querySelector<HTMLButtonElement>('#review-vote')!.disabled=false;
</script>

<style>
  .voting-progress{display:flex;align-items:center;flex-wrap:wrap;gap:14px;margin:16px 0 20px;font-size:13px;font-weight:700;color:var(--color-accent)}
  .voting-progress progress{width:min(280px,100%);height:9px;accent-color:var(--color-accent)}
  .candidate input:checked+article .choose-hint{font-weight:800;color:var(--color-accent)}
  h1 { margin: 8px 0; font-size: clamp(1.8rem, 3vw, 2.25rem); }
  .contest-title{display:flex;align-items:center;gap:16px;min-width:0}.contest-title h1{overflow-wrap:anywhere;min-width:0}.contest-title img{width:64px;height:64px;object-fit:contain;flex:none;padding:6px;border:1px solid #dce5df;border-radius:14px;background:white}
  .back { display: inline-block; margin-bottom: 22px; color: #145c3b; font-weight: 700; }
  .eyebrow { margin: 0 0 8px; color: #27714b; font-size: .74rem; letter-spacing: .1em; font-weight: 800; }
  .intro { margin: 0 0 24px; color: #58685e; line-height: 1.55; }
  fieldset { padding: 0; border: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .candidate-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .candidate { display: block; cursor: pointer; }
  .candidate > input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .candidate article { height: 100%; padding: 0; overflow: hidden; border: 2px solid #dce5df; border-radius: 14px; background: white; transition: border-color .15s, box-shadow .15s; }
  .candidate:focus-within article { outline: 3px solid #e6a800; outline-offset: 3px; }
  .candidate input:checked + article { border-color: #17643f; box-shadow: 0 0 0 3px #17643f22; }
  .pair-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; }
  .number { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: #e5f2e9; color: #145c3b; font-size: 1.15rem; font-weight: 800; }
  .choose-hint { color: #58685e; font-size: .85rem; }
  .statement { padding: 8px 0 0; border-top: 1px solid #e4e9e5; overflow-wrap:anywhere; }
  .statement h2 { margin: 12px 0 5px; font-size: .95rem; }
  .statement p { margin-bottom: 9px; line-height: 1.55; color: #39483e; }
  .mission { white-space: pre-line; }
  .review { min-height: 46px; margin-top: 22px; padding: 11px 18px; border: 0; border-radius: 8px; background: #17643f; color: white; font: inherit; font-weight: 700; cursor: pointer; }
  #vote-message { min-height: 1.5rem; margin-top: 16px; color: #8b2f22; }
  dialog { width: min(92vw, 460px); padding: 26px; border: 1px solid #dce5df; border-radius: 14px; color: #18231e; }
  dialog::backdrop { background: #14231bcc; }
  dialog h2 { margin-top: 0; }
  .selected-name { padding: 12px; border-radius: 8px; background: #f0f5f1; font-weight: 700; }
  .dialog-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .dialog-actions button { flex: 1; min-width: 130px; margin: 0; }
</style>
