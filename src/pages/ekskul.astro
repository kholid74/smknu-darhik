---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { db } from '../lib/prisma';

const thumb = (url: string, w: number) => url.startsWith('/api/image/') ? `${url}?w=${w}` : url;

const items = await db.extracurricular.findMany({ orderBy: { name: 'asc' } });
const ekskulList = items.map(e => ({
  name: e.name,
  desc: e.description || '',
  img: e.imageUrl ? thumb(e.imageUrl, 500) : '',
}));
---

<BaseLayout title="Ekstrakurikuler" description={`Kegiatan ekstrakurikuler di ${site.name} — olahraga, seni, IT, dan keagamaan.`}>

<!-- HERO -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1523050854058-8df90110b159?w=1200&q=80" alt="Kegiatan ekstrakurikuler" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/85"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-24 text-center text-white">
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">Ekstrakurikuler</h1>
    <p class="text-base md:text-lg text-white/80 leading-relaxed max-w-xl mx-auto">Kembangkan bakat dan minatmu melalui berbagai kegiatan ekstrakurikuler di {site.name} — dari olahraga, seni, IT, hingga keagamaan.</p>
  </div>
</section>

<!-- GRID EKSKUL -->
<section class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-20">
  <div class="max-w-2xl mb-12">
    <span class="rule-mark mb-5"></span>
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b]">Pilihan Ekstrakurikuler</h2>
    <p class="mt-4 text-sm md:text-base text-[#3f493f] leading-relaxed">{ekskulList.length} kegiatan yang bisa kamu pilih sesuai minat dan bakatmu.</p>
  </div>

  {ekskulList.length === 0 ? (
    <div class="text-center text-[#6f7a6e] py-12">
      <span class="material-symbols-outlined text-4xl mb-3">interests</span>
      <p class="text-sm">Data ekstrakurikuler belum tersedia. Tambahkan lewat panel admin.</p>
    </div>
  ) : (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {ekskulList.map(e => (
        <div class="bg-white rounded-xl border border-black/5 shadow-[0_4px_12px_rgba(27,122,61,0.06)] overflow-hidden hover:shadow-[0_8px_24px_rgba(27,122,61,0.1)] transition-shadow group">
          {e.img ? (
            <div class="h-40 bg-[#f0f7f1] overflow-hidden">
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={e.img} alt={e.name} loading="lazy" onerror="this.style.display='none'"/>
            </div>
          ) : (
            <div class="h-40 bg-[#f0f7f1] flex items-center justify-center">
              <span class="material-symbols-outlined text-5xl text-[#1B7A3D]/40">interests</span>
            </div>
          )}
          <div class="p-5">
            <h3 class="font-bold text-sm md:text-base text-[#1c1b1b] mb-2">{e.name}</h3>
            <p class="text-xs md:text-sm text-[#6f7a6e] leading-relaxed">{e.desc}</p>
          </div>
        </div>
      ))}
    </div>
  )}
</section>

<!-- CTA -->
<section class="bg-white border-y border-black/5">
  <div class="max-w-3xl mx-auto px-4 md:px-6 py-14 md:py-16 text-center">
    <span class="rule-mark mb-5 mx-auto"></span>
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b] mb-4">Mau Daftar Ekskul?</h2>
    <p class="text-sm md:text-base text-[#3f493f] leading-relaxed mb-8 max-w-xl mx-auto">Hubungi waka kesiswaan atau pembina ekskul pilihanmu. Setiap siswa wajib mengikuti minimal satu kegiatan ekstrakurikuler.</p>
    <a href="/kontak" class="inline-flex items-center justify-center gap-2 bg-[#1B7A3D] text-white font-bold px-8 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-[#145a2d] transition-colors">Hubungi Kami <span class="material-symbols-outlined text-lg">arrow_forward</span></a>
  </div>
</section>

</BaseLayout>
