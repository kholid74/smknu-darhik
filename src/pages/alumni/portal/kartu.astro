---
export const prerender = false;
import AlumniPortalLayout from '../../../layouts/AlumniPortalLayout.astro';
import { getAlumniSession, ALUMNI_COOKIE, alumniCookieOpts } from '../../../lib/alumni-auth';
import { db } from '../../../lib/prisma';
import { buildAlumniCard } from '../../../lib/alumni-card';

const sess = await getAlumniSession(Astro.cookies);
if (!sess) return Astro.redirect('/alumni/masuk');
const a = await db.alumni.findUnique({
  where: { id: sess.sub },
  select: { nama: true, jurusan: true, angkatan: true, photoUrl: true, alumniId: true, verifyToken: true, verified: true },
});
if (!a || !a.verified) {
  Astro.cookies.set(ALUMNI_COOKIE, '', alumniCookieOpts(0));
  return Astro.redirect('/alumni/masuk');
}

const ready = !!a.alumniId && !!a.verifyToken;
const origin = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const card = ready
  ? await buildAlumniCard({ nama: a.nama, jurusan: a.jurusan, angkatan: a.angkatan, photoUrl: a.photoUrl, alumniId: a.alumniId!, verifyToken: a.verifyToken! }, origin)
  : null;
---

<AlumniPortalLayout title="Kartu" active="kartu" nama={a.nama} alumniId={a.alumniId}>
  {card ? (
    <>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap">
        <h1 style="font-size:18px;font-weight:800;flex:1">Kartu Alumni Digital</h1>
        <button id="dl" class="btn-dl"><span class="material-symbols-outlined" style="font-size:18px">download</span> Download PNG</button>
      </div>
      <div id="card" style="border-radius:28px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.14)" set:html={card.svg}></div>
      <p style="font-size:12.5px;color:#6f7a6e;line-height:1.6;margin-top:16px">Simpan kartu ini. QR mengarah ke halaman verifikasi publik (foto, nama, jurusan, angkatan) — kontak pribadi Anda tidak ditampilkan.</p>
    </>
  ) : (
    <div style="background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:26px;text-align:center">
      <span class="material-symbols-outlined" style="font-size:48px;color:#C8963E">hourglass_empty</span>
      <h1 style="font-size:17px;font-weight:800;margin:10px 0 6px">Kartu belum tersedia</h1>
      <p style="font-size:13px;color:#6f7a6e;line-height:1.6">ID alumni Anda sedang diproses admin. Coba lagi nanti atau hubungi sekolah.</p>
    </div>
  )}

  <style>
    .btn-dl { display:inline-flex;align-items:center;gap:6px;background:#1B7A3D;color:#fff;border:0;border-radius:10px;padding:10px 16px;font-size:14px;font-weight:700;font-family:inherit;cursor:pointer; }
    .btn-dl:hover { background:#146030; }
    #card svg { width:100%;height:auto;display:block; }
  </style>

  {card && (
    <script define:vars={{ filename: card.filename }}>
      document.getElementById('dl')?.addEventListener('click', () => {
        const svgEl = document.querySelector('#card svg');
        if (!svgEl) return;
        const scale = 2;
        const vb = svgEl.viewBox.baseVal;
        const xml = new XMLSerializer().serializeToString(svgEl);
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = vb.width * scale; canvas.height = vb.height * scale;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob((blob) => {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = filename; link.click();
            setTimeout(() => URL.revokeObjectURL(link.href), 2000);
          }, 'image/png');
        };
        img.onerror = () => alert('Gagal merender kartu. Coba muat ulang halaman.');
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml);
      });
    </script>
  )}
</AlumniPortalLayout>
