---
export const prerender = false;
import AlumniPortalLayout from '../../../layouts/AlumniPortalLayout.astro';
import { getAlumniSession, ALUMNI_COOKIE, alumniCookieOpts } from '../../../lib/alumni-auth';
import { db } from '../../../lib/prisma';

const sess = await getAlumniSession(Astro.cookies);
if (!sess) return Astro.redirect('/alumni/masuk');
const alumni = await db.alumni.findUnique({
  where: { id: sess.sub },
  select: { nama: true, alumniId: true, email: true, wa: true, verified: true },
});
if (!alumni || !alumni.verified) {
  Astro.cookies.set(ALUMNI_COOKIE, '', alumniCookieOpts(0));
  return Astro.redirect('/alumni/masuk');
}

const JENIS = ['Usulan / Saran', 'Tawaran Workshop / Narasumber', 'Info Lowongan', 'Lainnya'];
const done = Astro.url.searchParams.get('ok') === '1';
let error = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const kontak = data.get('kontak')?.toString().trim() || alumni.wa || alumni.email || '';
  const jenis = data.get('jenis')?.toString() || '';
  const detail = data.get('detail')?.toString().trim() || '';
  if (!jenis || !detail) {
    error = 'Jenis dan detail wajib diisi.';
  } else {
    // Nama & kontak diambil dari identitas alumni (tepercaya), bukan input bebas.
    await db.alumniContribution.create({ data: { nama: alumni.nama, kontak, jenis, detail } });
    return Astro.redirect('/alumni/portal/kontribusi?ok=1');
  }
}
const defaultKontak = alumni.wa || alumni.email || '';
---

<AlumniPortalLayout title="Kontribusi" active="kontribusi" nama={alumni.nama} alumniId={alumni.alumniId}>
  {done ? (
    <div style="background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:16px;padding:34px;text-align:center">
      <span class="material-symbols-outlined" style="font-size:50px;color:#1B7A3D">check_circle</span>
      <h1 style="font-size:19px;font-weight:800;margin:10px 0 6px">Terima kasih!</h1>
      <p style="font-size:13.5px;color:#6f7a6e;line-height:1.6;max-width:380px;margin:0 auto 18px">Kontribusi Anda sudah kami terima. Tim sekolah akan meninjau dan menghubungi bila diperlukan.</p>
      <a href="/alumni/portal" style="display:inline-flex;align-items:center;gap:6px;background:#1B7A3D;color:#fff;text-decoration:none;padding:10px 18px;border-radius:10px;font-size:14px;font-weight:700"><span class="material-symbols-outlined" style="font-size:18px">home</span> Beranda Portal</a>
    </div>
  ) : (
    <>
      <h1 style="font-size:18px;font-weight:800;margin-bottom:4px">Kirim Kontribusi</h1>
      <p style="font-size:12.5px;color:#6f7a6e;line-height:1.6;margin-bottom:16px">Punya usulan untuk sekolah, ingin jadi narasumber workshop, atau info lowongan untuk adik kelas? Kirim di sini — langsung ke tim sekolah.</p>

      {error && <div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-size:13px;border-radius:10px;padding:10px 14px;margin-bottom:14px">{error}</div>}

      <form method="POST" style="background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:14px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div><label class="l">Nama</label><input class="in" type="text" value={alumni.nama} disabled style="background:#f4f4f2;color:#6f7a6e" /></div>
          <div><label class="l">Kontak (untuk dihubungi)</label><input class="in" type="text" name="kontak" value={defaultKontak} placeholder="08xxx atau email" /></div>
        </div>
        <div>
          <label class="l">Jenis Kontribusi *</label>
          <select class="in" name="jenis" required><option value="">Pilih jenis</option>{JENIS.map((j) => <option value={j}>{j}</option>)}</select>
        </div>
        <div>
          <label class="l">Detail *</label>
          <textarea class="in" name="detail" rows="5" required style="resize:vertical" placeholder="Jelaskan usulan / tawaran / info lowongan Anda..."></textarea>
        </div>
        <p style="font-size:11.5px;color:#6f7a6e;margin:0">Data ini masuk ke tim sekolah dan <strong>tidak ditampilkan publik</strong>.</p>
        <div><button type="submit" class="btn-send"><span class="material-symbols-outlined" style="font-size:18px">send</span> Kirim Kontribusi</button></div>
      </form>
    </>
  )}

  <style>
    .l { display:block;font-size:12.5px;font-weight:700;margin-bottom:5px }
    .in { width:100%;border:1px solid #d9ddd7;border-radius:9px;padding:9px 11px;font-size:13.5px;font-family:inherit;background:#fff }
    .in:focus { outline:none;border-color:#1B7A3D;box-shadow:0 0 0 3px rgba(27,122,61,.12) }
    .btn-send { display:inline-flex;align-items:center;gap:6px;background:#1B7A3D;color:#fff;border:0;border-radius:10px;padding:11px 18px;font-size:14px;font-weight:700;font-family:inherit;cursor:pointer }
    .btn-send:hover { background:#146030 }
  </style>
</AlumniPortalLayout>
