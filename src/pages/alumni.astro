---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Alumni" description={`Halaman alumni ${site.name} — tracing, networking, dan informasi untuk para alumni.`}>

<!-- HERO -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1523580494863-6f3031224c94?w=1200&q=80" alt="Alumni" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/85"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-24 text-center text-white">
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">Alumni</h1>
    <p class="text-base md:text-lg text-white/80 leading-relaxed max-w-xl mx-auto">Jejaring dan informasi untuk alumni {site.name}.</p>
  </div>
</section>

<!-- PLACEHOLDER -->
<section class="max-w-2xl mx-auto px-4 md:px-6 py-20 md:py-28 text-center">
  <div class="bg-white rounded-2xl border border-black/5 shadow-[0_8px_32px_rgba(27,122,61,0.08)] p-10 md:p-14">
    <div class="w-20 h-20 rounded-full bg-[#f0f7f1] mx-auto mb-6 flex items-center justify-center">
      <span class="material-symbols-outlined text-4xl text-[#1B7A3D]">engineering</span>
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b] mb-4">Dalam Pengembangan</h2>
    <p class="text-sm md:text-base text-[#3f493f] leading-relaxed mb-8 max-w-md mx-auto">
      Halaman alumni sedang dalam tahap pengembangan. Nantinya akan tersedia fitur pendataan alumni, tracer study, dan galeri kegiatan reuni.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/kontak" class="inline-flex items-center justify-center gap-2 bg-[#1B7A3D] text-white font-bold px-6 py-3 rounded-lg text-sm min-h-[48px] hover:bg-[#145a2d] transition-colors">
        <span class="material-symbols-outlined text-base">mail</span> Hubungi Kami
      </a>
      <a href="/" class="inline-flex items-center justify-center gap-2 border border-black/10 text-[#1c1b1b] font-bold px-6 py-3 rounded-lg text-sm min-h-[48px] hover:bg-gray-50 transition-colors">
        <span class="material-symbols-outlined text-base">home</span> Kembali ke Beranda
      </a>
    </div>

    <div class="mt-10 pt-8 border-t border-black/5">
      <p class="text-xs text-[#6f7a6e] mb-3 font-semibold">Segera Hadir:</p>
      <div class="flex flex-wrap justify-center gap-3">
        {[
          { icon: 'person_search', label: 'Pendataan Alumni' },
          { icon: 'analytics', label: 'Tracer Study' },
          { icon: 'groups', label: 'Komunitas Alumni' },
          { icon: 'photo_library', label: 'Galeri Reuni' },
        ].map(f => (
          <span class="inline-flex items-center gap-1.5 text-xs text-[#6f7a6e] bg-[#f0f7f1] px-3 py-1.5 rounded-full">
            <span class="material-symbols-outlined text-sm text-[#1B7A3D]">{f.icon}</span>
            {f.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

</BaseLayout>
