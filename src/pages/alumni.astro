---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { db } from '../lib/prisma';

const thumb = (url: string, w: number) => (url.startsWith('/api/image/') ? `${url}?w=${w}` : url);

// Showcase publik = terverifikasi + opt-in + dipilih admin
const [showcase, verifiedAll] = await Promise.all([
  db.alumni.findMany({
    where: { verified: true, publicOptIn: true, featured: true },
    orderBy: [{ angkatan: 'desc' }, { nama: 'asc' }],
  }),
  db.alumni.findMany({ where: { verified: true }, select: { status: true } }),
]);

// Statistik agregat (anonim) — dari semua verified, gated bila cukup bermakna
const totalVerified = verifiedAll.length;
const STAT_THRESHOLD = 30;
const showStats = totalVerified >= STAT_THRESHOLD;
const statCounts = { Bekerja: 0, Kuliah: 0, Wirausaha: 0, Lainnya: 0 } as Record<string, number>;
if (showStats) for (const a of verifiedAll) statCounts[a.status] = (statCounts[a.status] || 0) + 1;
const pct = (n: number) => Math.round((n / totalVerified) * 100);
---

<BaseLayout title="Alumni" description={`Alumni ${site.name} — kisah lulusan yang siap kerja dan berprestasi.`}>

<!-- HERO -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1523580494863-6f3031224c94?w=1200&q=80" alt="Alumni" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/85"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-24 text-center text-white">
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">Alumni {site.shortName}</h1>
    <p class="text-base md:text-lg text-white/80 leading-relaxed max-w-xl mx-auto mb-8">Jejak para lulusan — bukti nyata bahwa sekolah kejuruan di desa pun mencetak orang-orang hebat.</p>
    <a href="/alumni/daftar" class="inline-flex items-center justify-center gap-2 bg-gold text-white font-bold px-7 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-gold-deep transition-colors shadow-lg shadow-black/20">
      <span class="material-symbols-outlined text-lg">person_add</span> Daftar sebagai Alumni
    </a>
  </div>
</section>

<!-- STATISTIK AGREGAT (anonim, gated >= 30) -->
{showStats && (
  <section class="bg-white border-b border-black/5">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-12">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        <div><div class="text-3xl font-extrabold text-[#1B7A3D]">{totalVerified}</div><div class="text-xs text-[#6f7a6e] mt-1 font-medium">Alumni Terdata</div></div>
        <div><div class="text-3xl font-extrabold text-[#1B7A3D]">{pct(statCounts.Bekerja)}%</div><div class="text-xs text-[#6f7a6e] mt-1 font-medium">Bekerja</div></div>
        <div><div class="text-3xl font-extrabold text-[#1B7A3D]">{pct(statCounts.Kuliah)}%</div><div class="text-xs text-[#6f7a6e] mt-1 font-medium">Kuliah</div></div>
        <div><div class="text-3xl font-extrabold text-[#1B7A3D]">{pct(statCounts.Wirausaha)}%</div><div class="text-xs text-[#6f7a6e] mt-1 font-medium">Wirausaha</div></div>
      </div>
    </div>
  </section>
)}

<!-- SHOWCASE ALUMNI PILIHAN — carousel horizontal 20/80 -->
{showcase.length > 0 && (
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-2xl mb-10">
      <span class="rule-mark mb-5"></span>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b]">Kisah Alumni Pilihan</h2>
      <p class="mt-4 text-sm md:text-base text-[#3f493f] leading-relaxed">Beberapa lulusan {site.shortName} yang berbagi jejak dan inspirasinya.</p>
    </div>

    <div class="al-carousel" data-total={showcase.length}>
      <div class="al-track" id="al-track">
        {showcase.map((a) => (
          <article class="al-slide">
            <div class="al-photo">
              {a.photoUrl ? (
                <img src={thumb(a.photoUrl, 500)} alt={a.nama} loading="lazy" onerror="this.style.display='none'"/>
              ) : (
                <div class="al-photo-ph"><span class="material-symbols-outlined">person</span></div>
              )}
            </div>
            <div class="al-body">
              <span class="al-badge"><span class="material-symbols-outlined">star</span> Alumni Pilihan</span>
              <h3>{a.nama}</h3>
              <p class="al-meta">Angkatan {a.angkatan} · {a.jurusan}</p>
              {(a.pekerjaan || a.instansi) && (
                <p class="al-job"><span class="material-symbols-outlined">work</span>{[a.pekerjaan, a.instansi].filter(Boolean).join(' · ')}</p>
              )}
              {a.cerita && <blockquote class="al-story">{a.cerita}</blockquote>}
            </div>
          </article>
        ))}
      </div>

      {showcase.length > 1 && (
        <div class="al-nav">
          <button type="button" class="al-btn" id="al-prev" aria-label="Sebelumnya"><span class="material-symbols-outlined">chevron_left</span></button>
          <div class="al-dots" id="al-dots">
            {showcase.map((_, i) => <button type="button" class="al-dot" data-i={i} aria-label={`Slide ${i + 1}`}></button>)}
          </div>
          <button type="button" class="al-btn" id="al-next" aria-label="Berikutnya"><span class="material-symbols-outlined">chevron_right</span></button>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .al-carousel { position: relative; }
  .al-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; gap: 0; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .al-track::-webkit-scrollbar { display: none; }
  .al-slide { flex: 0 0 100%; scroll-snap-align: center; display: grid; grid-template-columns: minmax(240px, 34%) 1fr; gap: 0; background: #fff; border: 1px solid rgba(0,0,0,.05); border-radius: 20px; overflow: hidden; box-shadow: 0 6px 24px rgba(27,122,61,.07); min-height: 320px; }
  .al-photo { background: #f0f7f1; position: relative; }
  .al-photo img { width: 100%; height: 100%; object-fit: cover; }
  .al-photo-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .al-photo-ph .material-symbols-outlined { font-size: 56px; color: rgba(27,122,61,.4); }
  .al-body { padding: 28px 32px; display: flex; flex-direction: column; justify-content: center; }
  .al-badge { display: inline-flex; align-items: center; gap: 4px; align-self: flex-start; background: #C8963E; color: #fff; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 99px; margin-bottom: 12px; }
  .al-badge .material-symbols-outlined { font-size: 14px; }
  .al-body h3 { font-size: 22px; font-weight: 800; color: #1c1b1b; line-height: 1.2; }
  .al-meta { font-size: 13px; color: #6f7a6e; margin-top: 2px; }
  .al-job { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: #1B7A3D; margin-top: 10px; }
  .al-job .material-symbols-outlined { font-size: 18px; }
  .al-story { font-size: 15px; line-height: 1.65; color: #3f493f; margin-top: 16px; padding-left: 16px; border-left: 3px solid #C8963E; font-style: italic; }
  .al-nav { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 22px; }
  .al-btn { width: 40px; height: 40px; border-radius: 99px; border: 1px solid rgba(0,0,0,.1); background: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .15s, opacity .15s; }
  .al-btn:hover { background: #f0f7f1; }
  .al-btn:disabled { opacity: .35; cursor: default; }
  .al-dots { display: flex; gap: 8px; }
  .al-dot { width: 9px; height: 9px; border-radius: 99px; border: none; background: rgba(0,0,0,.15); cursor: pointer; padding: 0; transition: background .15s, width .15s; }
  .al-dot[data-active] { background: #1B7A3D; width: 22px; }
  @media (max-width: 640px) {
    .al-slide { grid-template-columns: 1fr; }
    .al-photo { aspect-ratio: 16 / 10; }
    .al-body { padding: 20px; }
    .al-body h3 { font-size: 19px; }
  }
</style>

<script>
  const track = document.getElementById('al-track');
  if (track) {
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(document.querySelectorAll('.al-dot')) as HTMLElement[];
    const prev = document.getElementById('al-prev') as HTMLButtonElement | null;
    const next = document.getElementById('al-next') as HTMLButtonElement | null;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (i: number) => {
      const idx = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
    };
    const sync = () => {
      const i = current();
      dots.forEach((d, di) => (di === i ? d.setAttribute('data-active', '') : d.removeAttribute('data-active')));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };
    prev?.addEventListener('click', () => goTo(current() - 1));
    next?.addEventListener('click', () => goTo(current() + 1));
    dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.getAttribute('data-i')))));
    track.addEventListener('scroll', () => { window.requestAnimationFrame(sync); });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<!-- AJAKAN DAFTAR (band asimetris — beda ritme dari hero) -->
<section class="max-w-6xl mx-auto px-4 md:px-6 py-14 md:py-16">
  <div class="relative overflow-hidden rounded-3xl bg-[#145a2d] px-6 py-10 md:px-12 md:py-11 flex flex-col md:flex-row md:items-center gap-6 md:gap-10 text-white">
    <svg class="absolute -top-8 -right-10 w-56 h-56 text-white/[0.06] pointer-events-none" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <path d="M50 5 L61 39 L95 39 L67 60 L78 95 L50 74 L22 95 L33 60 L5 39 L39 39 Z" stroke="currentColor" stroke-width="0.7"/>
    </svg>
    <div class="relative flex-1 min-w-0">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-2 [overflow-wrap:anywhere]">Kamu alumni {site.shortName}?</h2>
      <p class="text-sm md:text-base text-white/80 leading-relaxed max-w-lg">Daftarkan dirimu untuk terhubung kembali. Datamu masuk basis data alumni — tampil sebagai alumni pilihan sepenuhnya pilihanmu.</p>
    </div>
    <a href="/alumni/daftar" class="relative shrink-0 inline-flex items-center justify-center gap-2 bg-gold text-white font-bold px-7 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-gold-deep transition-colors shadow-lg shadow-black/20"><span class="material-symbols-outlined text-lg">person_add</span> Daftar Sekarang</a>
  </div>
</section>

</BaseLayout>
