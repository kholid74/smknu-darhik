---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, dummyNote } from '../data/site';
import { db } from '../lib/prisma';

// kompetensi/karir are stored as JSON strings in the DB.
function parseList(raw: string | null | undefined): string[] {
  if (!raw) return [];
  try {
    const v = JSON.parse(raw);
    return Array.isArray(v) ? v.map(String) : [];
  } catch {
    return raw.split(/\r?\n|,/).map(s => s.trim()).filter(Boolean);
  }
}

// Fallback cover images for the seeded programs; used when a row has no imageUrl.
const fallbackImage: Record<string, string> = {
  'perbankan-syariah': 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=800&q=80',
  'dkv': 'https://images.unsplash.com/photo-1492725764893-90b379c2b6e7?w=800&q=80',
};
const genericImage = 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=800&q=80';

const departments = await db.department.findMany({ orderBy: { order: 'asc' } });
const jurusan = departments.map((d, i) => ({
  name: d.name,
  slug: d.slug,
  icon: d.icon || 'school',
  color: i % 2 === 0 ? 'green' : 'gold',   // DB has no colour; alternate for visual rhythm
  description: d.description,
  kompetensi: parseList(d.kompetensi),
  karir: parseList(d.karir),
  image: d.imageUrl || fallbackImage[d.slug] || genericImage,
}));
---

<BaseLayout title="Program Keahlian" description="Dua program keahlian unggulan SMKS NU Darul Hikam — Perbankan Syariah dan Multimedia.">

<!-- PAGE HERO + BREADCRUMB -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=1200&q=80" alt="Siswa praktik" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/80"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-20 text-white text-center">
    <nav class="flex items-center justify-center gap-2 text-sm text-white/70 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <span class="material-symbols-outlined text-sm">chevron_right</span>
      <span class="text-white font-medium">Program Keahlian</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">Program Keahlian</h1>
    <p class="text-base md:text-lg text-white/80 max-w-lg mx-auto leading-relaxed">Dua jurusan unggulan yang memadukan keterampilan digital dan keuangan dengan nilai-nilai Islami.</p>
  </div>
</section>

<!-- JURUSAN DETAIL -->
{jurusan.length === 0 && (
  <section class="bg-white border-y border-black/5">
    <div class="max-w-3xl mx-auto px-4 md:px-6 py-16 md:py-20 text-center text-[#6f7a6e]">
      <span class="material-symbols-outlined text-4xl mb-3">school</span>
      <p class="text-sm">Program keahlian belum tersedia. Silakan tambahkan lewat panel admin.</p>
    </div>
  </section>
)}
{jurusan.map((j, i) => (
  <section id={j.slug} class={i % 2 === 0 ? 'bg-white border-y border-black/5' : ''}>
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-20">
      <div class={`grid lg:grid-cols-2 gap-10 lg:gap-14 items-center ${i % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
        <!-- Image -->
        <div class={i % 2 === 1 ? 'lg:col-start-2' : ''}>
          <div class="relative rounded-2xl overflow-hidden shadow-lg">
            <img
              class="w-full h-72 md:h-96 object-cover"
              src={j.image}
              alt={j.name}
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
            <div class="absolute bottom-4 left-4">
              <span class={`text-white text-xs font-bold px-4 py-2 rounded-full ${j.color === 'gold' ? 'bg-[#C8963E]' : 'bg-[#1B7A3D]'}`}>
                Program Keahlian {i + 1}
              </span>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class={i % 2 === 1 ? 'lg:col-start-1' : ''}>
          <div class="flex items-center gap-3 mb-4">
            <span class={`material-symbols-outlined text-3xl ${j.color === 'gold' ? 'text-[#C8963E]' : 'text-[#1B7A3D]'}`}>{j.icon}</span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-[#1c1b1b]">{j.name}</h2>
          </div>
          <p class="text-sm md:text-base text-[#3f493f] leading-relaxed mb-6">{j.description}</p>

          <!-- Kompetensi -->
          <div class="mb-6">
            <h3 class="font-bold text-[#1c1b1b] mb-3 flex items-center gap-2">
              <span class="material-symbols-outlined text-[#1B7A3D] text-lg">checklist</span>
              Kompetensi yang Dipelajari
            </h3>
            <ul class="space-y-2">
              {j.kompetensi.map(k => (
                <li class="flex items-start gap-2 text-sm text-[#3f493f]">
                  <span class="material-symbols-outlined text-[#1B7A3D] text-sm flex-shrink-0 mt-0.5">check_circle</span>
                  {k}
                </li>
              ))}
            </ul>
          </div>

          <!-- Prospek Karir -->
          <div class="mb-6">
            <h3 class="font-bold text-[#1c1b1b] mb-3 flex items-center gap-2">
              <span class="material-symbols-outlined text-[#C8963E] text-lg">work</span>
              Prospek Karir
            </h3>
            <div class="flex flex-wrap gap-2">
              {j.karir.map(k => (
                <span class={`text-xs font-semibold px-3 py-1.5 rounded-full ${j.color === 'gold' ? 'bg-[#fdf6e8] text-[#7e5700]' : 'bg-[#e8f5e9] text-[#1B7A3D]'}`}>{k}</span>
              ))}
            </div>
          </div>

          <a href="/ppdb" class={`inline-flex items-center gap-2 font-bold text-sm px-6 py-3 rounded-lg text-white transition-colors ${j.color === 'gold' ? 'bg-[#C8963E] hover:bg-[#C8963E]/90' : 'bg-[#1B7A3D] hover:bg-[#145a2d]'}`}>
            Daftar Jurusan Ini <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>
))}

<!-- FASILITAS PENUNJANG -->
<section class="bg-white border-y border-black/5">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-20">
    <span class="rule-mark mb-5 mx-auto"></span>
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b] text-center mb-3">Fasilitas Penunjang</h2>
    <p class="text-sm text-[#6f7a6e] text-center mb-10 max-w-lg mx-auto">Fasilitas modern untuk mendukung pembelajaran praktik di setiap jurusan.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {[
        { icon: 'computer', title: 'Lab Komputer', desc: 'Dilengkapi software perbankan & desain grafis terkini' },
        { icon: 'videocam', title: 'Studio Multimedia', desc: 'Ruang produksi video, fotografi, dan editing' },
        { icon: 'account_balance', title: 'Mini Bank Syariah', desc: 'Simulasi praktik perbankan seperti di dunia nyata' },
        { icon: 'wifi', title: 'Internet Cepat', desc: 'Akses internet untuk pembelajaran digital' },
      ].map(item => (
        <div class="bg-[#fcf9f8] rounded-xl border border-black/5 p-6 hover:shadow-[0_4px_12px_rgba(27,122,61,0.08)] transition-shadow">
          <span class="material-symbols-outlined text-[#1B7A3D] text-3xl mb-3">{item.icon}</span>
          <h3 class="font-bold text-[#1c1b1b] mb-2">{item.title}</h3>
          <p class="text-sm text-[#6f7a6e] leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
    <p class="text-xs text-[#6f7a6e] mt-6 text-center italic">{dummyNote}</p>
  </div>
</section>

<!-- CTA SECTION -->
<section class="relative bg-[#1B7A3D] text-white overflow-hidden">
  <svg class="absolute -top-16 -left-16 w-80 h-80 text-white/10 pointer-events-none" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M50 5 L61 39 L95 39 L67 60 L78 95 L50 74 L22 95 L33 60 L5 39 L39 39 Z" stroke="currentColor" stroke-width="0.8"/></svg>
  <div class="relative max-w-3xl mx-auto px-4 md:px-6 py-16 md:py-20 text-center">
    <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-4">Siap memilih jurusan impianmu?</h2>
    <p class="text-white/85 mb-8 text-sm md:text-lg leading-relaxed max-w-xl mx-auto">Daftar PPDB 2026/2027 sekarang dan wujudkan masa depan cerah bersama {site.name}.</p>
    <a href="/ppdb" class="inline-flex items-center justify-center gap-2 bg-[#C8963E] text-white font-bold px-8 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-[#C8963E]/90 transition-colors">Daftar PPDB <span class="material-symbols-outlined text-lg">arrow_forward</span></a>
  </div>
</section>

</BaseLayout>
