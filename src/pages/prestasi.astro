---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { db } from '../lib/prisma';

const thumb = (url: string, w: number) => (url.startsWith('/api/image/') ? `${url}?w=${w}` : url);

const items = await db.achievement.findMany({ orderBy: [{ order: 'asc' }, { year: 'desc' }] });

// Badge tingkat: Nasional paling menonjol
const levelBadge: Record<string, string> = {
  Nasional: 'bg-gold text-white',
  Provinsi: 'bg-[#1B7A3D] text-white',
  Kabupaten: 'bg-[#f0f7f1] text-[#1B7A3D]',
};
---

<BaseLayout title="Prestasi" description={`Prestasi siswa ${site.name} — akademik, non-akademik, dan keagamaan tingkat kabupaten hingga nasional.`}>

<!-- HERO -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=1200&q=80" alt="Prestasi siswa" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/85"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-24 text-center text-white">
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">Prestasi Siswa</h1>
    <p class="text-base md:text-lg text-white/80 leading-relaxed max-w-xl mx-auto">Raihan membanggakan siswa-siswi {site.name} — dari tingkat kabupaten hingga nasional, di bidang akademik, non-akademik, dan keagamaan.</p>
  </div>
</section>

<!-- GRID PRESTASI -->
<section class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-20">
  <div class="max-w-2xl mb-12">
    <span class="rule-mark mb-5"></span>
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b]">Daftar Prestasi</h2>
    <p class="mt-4 text-sm md:text-base text-[#3f493f] leading-relaxed">{items.length} prestasi yang telah diraih siswa-siswi kami.</p>
  </div>

  {items.length === 0 ? (
    <div class="text-center text-[#6f7a6e] py-12">
      <span class="material-symbols-outlined text-4xl mb-3">emoji_events</span>
      <p class="text-sm">Data prestasi belum tersedia. Tambahkan lewat panel admin.</p>
    </div>
  ) : (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {items.map(a => (
        <div class="bg-white rounded-xl border border-black/5 shadow-[0_4px_12px_rgba(27,122,61,0.06)] overflow-hidden hover:shadow-[0_8px_24px_rgba(27,122,61,0.1)] transition-shadow group flex flex-col">
          {a.imageUrl ? (
            <div class="h-44 bg-[#f0f7f1] overflow-hidden relative">
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={thumb(a.imageUrl, 500)} alt={a.title} loading="lazy" onerror="this.style.display='none'"/>
              <span class={`absolute top-3 left-3 text-[11px] font-bold px-2.5 py-1 rounded-full ${levelBadge[a.level] || 'bg-[#f0f7f1] text-[#1B7A3D]'}`}>{a.level}</span>
            </div>
          ) : (
            <div class="h-44 bg-[#f0f7f1] flex items-center justify-center relative">
              <span class="material-symbols-outlined text-5xl text-[#1B7A3D]/40">emoji_events</span>
              <span class={`absolute top-3 left-3 text-[11px] font-bold px-2.5 py-1 rounded-full ${levelBadge[a.level] || 'bg-white text-[#1B7A3D]'}`}>{a.level}</span>
            </div>
          )}
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-2 text-xs text-[#6f7a6e]">
              {a.category && <span class="font-semibold text-[#1B7A3D]">{a.category}</span>}
              {a.category && <span>&middot;</span>}
              <span>{a.year}</span>
            </div>
            <h3 class="font-bold text-sm md:text-base text-[#1c1b1b] mb-1.5 [overflow-wrap:anywhere]">{a.title}</h3>
            {a.student && <p class="text-xs text-[#1B7A3D] font-medium mb-2">{a.student}</p>}
            {a.description && <p class="text-xs md:text-sm text-[#6f7a6e] leading-relaxed mt-auto">{a.description}</p>}
          </div>
        </div>
      ))}
    </div>
  )}
</section>

</BaseLayout>
