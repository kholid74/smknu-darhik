---
export const prerender = false;
import sharp from 'sharp';
import { getFileFromR2 } from '../../../lib/r2';

const key = (Astro.params as any).key as string || '';
// Optional ?w= renders a resized thumbnail (used by media grids). No param = original.
const wRaw = parseInt(new URL(Astro.request.url).searchParams.get('w') || '0');
const width = Number.isFinite(wRaw) ? Math.min(Math.max(wRaw, 0), 2000) : 0;

const result = await getFileFromR2(key);
if (!result) return new Response(JSON.stringify({ error: 'Not found' }), { status: 404, headers: { 'Content-Type': 'application/json' } });

let bytes: Uint8Array = result.bytes;
let contentType = result.contentType;
if (width > 0) {
  try {
    const buf = await sharp(Buffer.from(result.bytes))
      .resize({ width, withoutEnlargement: true })
      .webp({ quality: 70 })
      .toBuffer();
    bytes = buf;
    contentType = 'image/webp';
  } catch {
    // Non-image or resize failure: fall back to the original bytes.
  }
}

return new Response(bytes, {
  status: 200,
  headers: { 'Content-Type': contentType, 'Cache-Control': 'public, max-age=31536000, immutable' },
});
---
<html></html>
