---
export const prerender = false;
import { getFileFromR2 } from '../../../lib/r2';

const key = (Astro.params as any).key as string || '';

const result = await getFileFromR2(key);
if (!result) return new Response(JSON.stringify({ error: 'Not found', key }), { status: 404, headers: { 'Content-Type': 'application/json' } });
return new Response(result.bytes, {
  status: 200,
  headers: { 'Content-Type': result.contentType, 'Cache-Control': 'public, max-age=31536000, immutable' },
});
---
<html></html>
