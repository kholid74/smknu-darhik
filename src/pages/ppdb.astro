---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, dummyNote } from '../data/site';
---

<BaseLayout title="PPDB 2026/2027" description="Informasi lengkap Pendaftaran Peserta Didik Baru SMKS NU Darul Hikam Karanggeneng tahun ajaran 2026/2027.">

<!-- PAGE HERO + BREADCRUMB -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1523050854058-8df90110b159?w=1200&q=80" alt="Siswa baru" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/80"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-20 text-white text-center">
    <nav class="flex items-center justify-center gap-2 text-sm text-white/70 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <span class="material-symbols-outlined text-sm">chevron_right</span>
      <span class="text-white font-medium">PPDB</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">PPDB 2026/2027</h1>
    <p class="text-base md:text-lg text-white/80 max-w-lg mx-auto leading-relaxed">Pendaftaran Peserta Didik Baru {site.name} — wujudkan masa depan cerah bersama kami.</p>
  </div>
</section>

<!-- ALUR PENDAFTARAN -->
<section class="max-w-5xl mx-auto px-4 md:px-6 py-16 md:py-20">
  <span class="rule-mark mb-5 mx-auto"></span>
  <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b] text-center mb-10">Alur Pendaftaran</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
    {[
      { step: '01', icon: 'description', title: 'Isi Formulir', desc: 'Lengkapi data diri secara online di halaman ini atau datang langsung ke sekolah.' },
      { step: '02', icon: 'upload_file', title: 'Unggah Berkas', desc: 'Upload scan KK, ijazah/skl, pas foto, dan surat keterangan sehat.' },
      { step: '03', icon: 'payments', title: 'Pembayaran', desc: 'Lakukan pembayaran biaya pendaftaran melalui transfer bank yang ditunjuk.' },
      { step: '04', icon: 'how_to_reg', title: 'Verifikasi', desc: 'Tim PPDB akan memverifikasi data dan mengirimkan konfirmasi.' },
      { step: '05', icon: 'school', title: 'Daftar Ulang', desc: 'Datang ke sekolah untuk daftar ulang dan orientasi siswa baru.' },
    ].map(item => (
      <div class="bg-white rounded-xl border border-black/5 p-5 text-center shadow-[0_2px_8px_rgba(27,122,61,0.06)] relative">
        <span class="absolute -top-3 -right-3 text-4xl font-extrabold text-[#1B7A3D]/10">{item.step}</span>
        <span class="material-symbols-outlined text-[#1B7A3D] text-3xl mb-3">{item.icon}</span>
        <h3 class="font-bold text-[#1c1b1b] mb-2">{item.title}</h3>
        <p class="text-xs text-[#6f7a6e] leading-relaxed">{item.desc}</p>
      </div>
    ))}
  </div>
  <div class="mt-8 text-center">
    <a href="https://wa.me/62" class="inline-flex items-center justify-center gap-2 bg-[#1B7A3D] text-white font-bold px-8 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-[#145a2d] transition-colors">
      <span class="material-symbols-outlined text-lg">chat</span> Daftar via WhatsApp
    </a>
  </div>
</section>

<!-- SYARAT & JADWAL -->
<section class="bg-white border-y border-black/5">
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-16 md:py-20">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12">
      <!-- Syarat -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <span class="material-symbols-outlined text-[#1B7A3D] text-2xl">checklist</span>
          <h2 class="text-xl md:text-2xl font-extrabold text-[#1c1b1b]">Syarat Pendaftaran</h2>
        </div>
        <div class="space-y-3">
          {[
            'Fotokopi Kartu Keluarga (KK) 2 lembar',
            'Fotokopi Ijazah / SKL SMP/MTs 2 lembar',
            'Pas foto ukuran 3x4 (4 lembar)',
            'Surat keterangan sehat dari Puskesmas/Dokter',
            'Mengisi formulir pendaftaran (online/offline)',
            'Membayar biaya pendaftaran',
          ].map((s, i) => (
            <div class="flex items-start gap-3 bg-[#fcf9f8] rounded-lg p-4 border border-black/5">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#1B7A3D] text-white text-xs font-bold flex items-center justify-center mt-0.5">{i + 1}</span>
              <p class="text-sm text-[#3f493f] leading-relaxed">{s}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Jadwal -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <span class="material-symbols-outlined text-[#C8963E] text-2xl">calendar_month</span>
          <h2 class="text-xl md:text-2xl font-extrabold text-[#1c1b1b]">Jadwal Penting</h2>
        </div>
        <div class="space-y-3">
          {[
            { label: 'Pendaftaran Gelombang 1', date: '1 Mei – 30 Juni 2026', status: 'open' },
            { label: 'Pendaftaran Gelombang 2', date: '1 Juli – 10 Agustus 2026', status: 'upcoming' },
            { label: 'Verifikasi Berkas', date: 'Setiap hari kerja pukul 08.00–14.00', status: 'info' },
            { label: 'Pengumuman Hasil', date: 'Maks. 7 hari setelah pendaftaran', status: 'info' },
            { label: 'Daftar Ulang', date: 'Segera setelah pengumuman diterima', status: 'upcoming' },
            { label: 'Awal Tahun Ajaran', date: '14 Juli 2026', status: 'upcoming' },
          ].map(item => (
            <div class="flex items-center gap-4 bg-[#fcf9f8] rounded-lg p-4 border border-black/5">
              <div class={`w-3 h-3 rounded-full flex-shrink-0 ${item.status === 'open' ? 'bg-[#1B7A3D]' : item.status === 'upcoming' ? 'bg-[#C8963E]' : 'bg-[#6f7a6e]'}`}></div>
              <div>
                <p class="text-sm font-bold text-[#1c1b1b]">{item.label}</p>
                <p class="text-xs text-[#6f7a6e]">{item.date}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="text-xs text-[#6f7a6e] mt-8 text-center italic">{dummyNote}</p>
  </div>
</section>

<!-- FAQ PPDB -->
<section class="max-w-4xl mx-auto px-4 md:px-6 py-16 md:py-20">
  <span class="rule-mark mb-5 mx-auto"></span>
  <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b] text-center mb-10">FAQ Pendaftaran</h2>
  <div class="space-y-3">
    {[
      { q: 'Apakah ada biaya pendaftaran?', a: 'Ya, biaya pendaftaran sebesar Rp150.000 sudah termasuk biaya administrasi dan tes penempatan.' },
      { q: 'Bisa daftar online?', a: 'Bisa. Hubungi nomor WhatsApp kami atau isi formulir di halaman ini. Petugas akan membantu proses selanjutnya.' },
      { q: 'Apakah ada tes masuk?', a: 'Tidak ada tes akademik. Kami hanya melakukan wawancara singkat untuk mengenal minat dan bakat calon siswa.' },
      { q: 'Berapa kuota per jurusan?', a: 'Masing-masing jurusan menerima 2 kelas (sekitar 60 siswa). Pendaftaran ditutup jika kuota terpenuhi.' },
    ].map((faq, i) => (
      <details class="bg-white rounded-xl border border-black/5 group shadow-[0_2px_8px_rgba(27,122,61,0.04)]">
        <summary class="flex items-center justify-between p-5 cursor-pointer font-bold text-[#1c1b1b] text-sm md:text-base list-none">
          <span class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-[#e8f5e9] text-[#1B7A3D] text-xs font-bold flex items-center justify-center flex-shrink-0">{i + 1}</span>
            {faq.q}
          </span>
          <span class="material-symbols-outlined text-[#6f7a6e] group-open:rotate-180 transition-transform">expand_more</span>
        </summary>
        <div class="px-5 pb-5 pl-14">
          <p class="text-sm text-[#3f493f] leading-relaxed">{faq.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<!-- CTA SECTION -->
<section class="relative bg-[#1B7A3D] text-white overflow-hidden">
  <svg class="absolute -top-16 -right-16 w-80 h-80 text-white/10 pointer-events-none" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M50 5 L61 39 L95 39 L67 60 L78 95 L50 74 L22 95 L33 60 L5 39 L39 39 Z" stroke="currentColor" stroke-width="0.8"/></svg>
  <div class="relative max-w-3xl mx-auto px-4 md:px-6 py-16 md:py-20 text-center">
    <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-4">Masih ragu?</h2>
    <p class="text-white/85 mb-8 text-sm md:text-lg leading-relaxed max-w-xl mx-auto">Tim PPDB kami siap membantu. Hubungi langsung untuk konsultasi gratis tentang pilihan jurusan dan pendaftaran.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="https://wa.me/62" class="inline-flex items-center justify-center gap-2 bg-[#C8963E] text-white font-bold px-8 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-[#C8963E]/90 transition-colors">Chat WhatsApp</a>
      <a href="/kontak" class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/40 text-white font-bold px-8 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-white/20 transition-colors">Kontak Kami</a>
    </div>
  </div>
</section>

</BaseLayout>
