---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Kontak" description="Hubungi SMKS NU Darul Hikam Karanggeneng — alamat, telepon, WhatsApp, email, dan media sosial.">

<!-- PAGE HERO + BREADCRUMB -->
<section class="relative bg-[#145a2d] overflow-hidden">
  <div class="absolute inset-0">
    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1200&q=80" alt="Kontak" loading="eager" onerror="this.style.background='#145a2d'" />
    <div class="absolute inset-0 bg-[#145a2d]/80"></div>
  </div>
  <div class="relative z-10 px-4 md:px-6 max-w-3xl mx-auto py-16 md:py-20 text-white text-center">
    <nav class="flex items-center justify-center gap-2 text-sm text-white/70 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <span class="material-symbols-outlined text-sm">chevron_right</span>
      <span class="text-white font-medium">Kontak</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">Hubungi Kami</h1>
    <p class="text-base md:text-lg text-white/80 max-w-lg mx-auto leading-relaxed">Kami siap mendengar dari Anda. Silakan hubungi melalui saluran di bawah ini.</p>
  </div>
</section>

<!-- INFO + MAP SPLIT -->
<section class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-20">
  <div class="grid lg:grid-cols-2 gap-10 lg:gap-14">

    <!-- Info Kontak -->
    <div>
      <span class="rule-mark mb-5"></span>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c1b1b] mb-6">Informasi Kontak</h2>
      <div class="space-y-5">
        <div class="flex gap-4 bg-white rounded-xl border border-black/5 p-5 shadow-[0_2px_8px_rgba(27,122,61,0.04)]">
          <span class="material-symbols-outlined text-[#1B7A3D] text-2xl flex-shrink-0 mt-1">location_on</span>
          <div>
            <p class="text-xs text-[#6f7a6e] uppercase tracking-wider font-semibold mb-1">Alamat</p>
            <p class="text-sm text-[#1c1b1b] leading-relaxed">{site.address}</p>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-black/5 p-5 shadow-[0_2px_8px_rgba(27,122,61,0.04)]">
          <span class="material-symbols-outlined text-[#1B7A3D] text-2xl flex-shrink-0 mt-1">call</span>
          <div>
            <p class="text-xs text-[#6f7a6e] uppercase tracking-wider font-semibold mb-1">Telepon / WhatsApp</p>
            <a href={`tel:${site.phone}`} class="text-sm text-[#1B7A3D] font-semibold hover:underline">{site.phone}</a>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-black/5 p-5 shadow-[0_2px_8px_rgba(27,122,61,0.04)]">
          <span class="material-symbols-outlined text-[#1B7A3D] text-2xl flex-shrink-0 mt-1">mail</span>
          <div>
            <p class="text-xs text-[#6f7a6e] uppercase tracking-wider font-semibold mb-1">Email</p>
            <a href={`mailto:${site.email}`} class="text-sm text-[#1B7A3D] font-semibold hover:underline">{site.email}</a>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-black/5 p-5 shadow-[0_2px_8px_rgba(27,122,61,0.04)]">
          <span class="material-symbols-outlined text-[#1B7A3D] text-2xl flex-shrink-0 mt-1">schedule</span>
          <div>
            <p class="text-xs text-[#6f7a6e] uppercase tracking-wider font-semibold mb-1">Jam Operasional</p>
            <p class="text-sm text-[#1c1b1b] leading-relaxed">Senin – Jumat: 07.00 – 15.00 WIB<br/>Sabtu: 07.00 – 12.00 WIB</p>
          </div>
        </div>
      </div>

      <!-- Sosmed Icons -->
      <div class="mt-8">
        <h3 class="font-bold text-[#1c1b1b] mb-4">Ikuti Media Sosial Kami</h3>
        <div class="flex gap-3">
          <a href="https://instagram.com/smknudarulhikam" class="w-10 h-10 rounded-full bg-[#e8f5e9] flex items-center justify-center hover:bg-[#1B7A3D] hover:[&_svg]:fill-white transition-colors group" title="Instagram" aria-label="Instagram">
            <svg class="w-[18px] h-[18px] fill-[#1B7A3D] group-hover:fill-white transition-colors" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://facebook.com/smknudarulhikam" class="w-10 h-10 rounded-full bg-[#e8f5e9] flex items-center justify-center hover:bg-[#1B7A3D] transition-colors group" title="Facebook" aria-label="Facebook">
            <svg class="w-[18px] h-[18px] fill-[#1B7A3D] group-hover:fill-white transition-colors" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://tiktok.com/@smknudh_karanggeneng" class="w-10 h-10 rounded-full bg-[#e8f5e9] flex items-center justify-center hover:bg-[#1B7A3D] transition-colors group" title="TikTok" aria-label="TikTok">
            <svg class="w-[18px] h-[18px] fill-[#1B7A3D] group-hover:fill-white transition-colors" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
          <a href="https://www.youtube.com/@dhtvsmkdh9648" class="w-10 h-10 rounded-full bg-[#e8f5e9] flex items-center justify-center hover:bg-[#1B7A3D] transition-colors group" title="YouTube" aria-label="YouTube">
            <svg class="w-[18px] h-[18px] fill-[#1B7A3D] group-hover:fill-white transition-colors" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Map + Form to WA -->
    <div class="space-y-6">
      <!-- Map Placeholder -->
      <div class="bg-[#e8e6e3] rounded-2xl overflow-hidden border border-black/5 h-64 md:h-72 flex items-center justify-center">
        <div class="text-center">
          <span class="material-symbols-outlined text-5xl text-[#6f7a6e] mb-3">map</span>
          <p class="text-sm text-[#6f7a6e] font-medium">{site.location}</p>
          <p class="text-xs text-[#6f7a6e]/60 mt-1">{site.name}</p>
          <a href={`https://maps.google.com/?q=${encodeURIComponent(site.name + ' ' + site.location)}`} target="_blank" rel="noopener" class="inline-block mt-3 text-xs font-bold text-[#1B7A3D] hover:underline">Buka di Google Maps →</a>
        </div>
      </div>

      <!-- Form to WA -->
      <div class="bg-[#fcf9f8] rounded-2xl border border-black/5 p-6">
        <h3 class="font-bold text-[#1c1b1b] mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-[#1B7A3D]">chat</span>
          Kirim Pesan via WhatsApp
        </h3>
        <form id="wa-form" class="space-y-4" onsubmit="event.preventDefault(); const n=this.nama.value.trim(); const p=this.pesan.value.trim(); const jur=this.jurusan?.value||''; const msg=encodeURIComponent(`Assalamu'alaikum, saya ${n}${jur?' - tertarik jurusan '+jur:''}. ${p ? '\\n\\n'+p : ''}`); window.open('https://wa.me/62?text='+msg,'_blank');">
          <div>
            <label for="nama" class="block text-sm font-semibold text-[#1c1b1b] mb-1.5">Nama Lengkap</label>
            <input type="text" id="nama" name="nama" required class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#1B7A3D] focus:border-transparent" placeholder="Masukkan nama Anda" />
          </div>
          <div>
            <label for="jurusan" class="block text-sm font-semibold text-[#1c1b1b] mb-1.5">Jurusan Diminati (opsional)</label>
            <select id="jurusan" name="jurusan" class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#1B7A3D] focus:border-transparent">
              <option value="">-- Pilih jurusan --</option>
              <option value="Perbankan Syariah">Perbankan Syariah</option>
              <option value="Multimedia">Multimedia</option>
            </select>
          </div>
          <div>
            <label for="pesan" class="block text-sm font-semibold text-[#1c1b1b] mb-1.5">Pesan (opsional)</label>
            <textarea id="pesan" name="pesan" rows="3" class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#1B7A3D] focus:border-transparent resize-none" placeholder="Tulis pesan Anda..."></textarea>
          </div>
          <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-bold px-6 py-3.5 rounded-lg text-sm hover:bg-[#20bd5a] transition-colors">
            <span class="material-symbols-outlined text-lg">chat</span> Kirim via WhatsApp
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- CTA SECTION -->
<section class="relative bg-[#1B7A3D] text-white overflow-hidden">
  <svg class="absolute -top-16 -left-16 w-80 h-80 text-white/10 pointer-events-none" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M50 5 L61 39 L95 39 L67 60 L78 95 L50 74 L22 95 L33 60 L5 39 L39 39 Z" stroke="currentColor" stroke-width="0.8"/></svg>
  <div class="relative max-w-3xl mx-auto px-4 md:px-6 py-16 md:py-20 text-center">
    <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-4">Ingin langsung berkunjung?</h2>
    <p class="text-white/85 mb-8 text-sm md:text-lg leading-relaxed max-w-xl mx-auto">Kami selalu terbuka. Datang langsung ke {site.location} dan lihat sendiri suasana belajar di {site.shortName}.</p>
    <a href="/ppdb" class="inline-flex items-center justify-center gap-2 bg-[#C8963E] text-white font-bold px-8 py-3.5 rounded-lg text-sm min-h-[48px] hover:bg-[#C8963E]/90 transition-colors">Daftar PPDB</a>
  </div>
</section>

</BaseLayout>
