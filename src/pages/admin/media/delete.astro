---
export const prerender = false;
import { verifyToken } from '../../../lib/auth';
import { deleteMedia, MediaInUseError } from '../../../lib/media-delete';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
if (!await verifyToken(token)) return Astro.redirect('/admin/login');

if (Astro.request.method === 'POST') {
  if(Astro.request.headers.get('origin')!==Astro.url.origin)return new Response('Forbidden',{status:403});
  const d = await Astro.request.formData();
  const id = d.get('id')?.toString();
  if (id) {
    try {
      const result=await deleteMedia(id,Astro.url.origin);
      if(!result.storageDeleted)return Astro.redirect('/admin/media?delete=storage-pending');
    } catch(error) {
      return Astro.redirect('/admin/media?delete='+(error instanceof MediaInUseError?'in-use':'failed'));
    }
  }
}
return Astro.redirect('/admin/media');
---
<html></html>
