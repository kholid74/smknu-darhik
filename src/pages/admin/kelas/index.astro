---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../lib/prisma';
import { listSchoolClasses } from '../../../lib/students';

const [classes, departments] = await Promise.all([
  listSchoolClasses(),
  db.department.findMany({ select: { id: true, name: true }, orderBy: { name: 'asc' } }),
]);
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<AdminLayout title="Master Kelas" user={{ role: Astro.locals.session?.role ?? '' }}>
  <div style="margin-bottom:18px"><h2 style="font-size:20px;font-weight:800">Master Kelas</h2><p style="font-size:13px;color:var(--color-muted);margin-top:4px">Kelas dibedakan per tahun ajaran dan jurusan. Jurusan diambil dari master jurusan sekolah.</p></div>
  <p id="class-message" role="status" aria-live="polite" style="display:none;margin-bottom:14px;padding:12px;border-radius:8px;font-size:13px"></p>
  <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800">Tambah kelas</h3>
    {departments.length === 0 ? <p style="margin-top:10px;font-size:13px;color:var(--color-muted)">Tambahkan jurusan terlebih dahulu melalui Data Sekolah → Jurusan.</p> : <form id="class-form" class="class-form">
      <label>Tahun ajaran<input name="academicYear" maxlength="9" pattern="[0-9]{4}/[0-9]{4}" required placeholder="2026/2027"/><small>Contoh: 2026/2027</small></label>
      <label>Nama kelas<input name="name" maxlength="40" required placeholder="X DKV 1"/></label>
      <label>Jurusan<select name="departmentId" required><option value="">Pilih jurusan</option>{departments.map((department) => <option value={department.id}>{department.name}</option>)}</select></label>
      <button class="btn btn-primary" type="submit">Simpan kelas</button>
    </form>}
  </section>
  <div class="card class-table"><table><thead><tr><th>Tahun ajaran</th><th>Nama kelas</th><th>Jurusan</th><th>Aksi</th></tr></thead><tbody>
    {classes.length === 0 ? <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--color-muted)">Belum ada kelas.</td></tr> : classes.map((item) => <tr><td>{item.academicYear}</td><td style="font-weight:600">{item.name}</td><td>{item.department.name}</td><td><div class="class-actions">
      <button type="button" class="btn btn-outline edit-class" data-class={JSON.stringify({ id: item.id, academicYear: item.academicYear, name: item.name, departmentId: item.department.id })} aria-label={`Edit kelas ${item.name}`} title="Edit kelas"><span class="material-symbols-outlined">edit</span></button>
      <button type="button" class="btn btn-outline delete-class" data-id={item.id} data-name={`${item.name} · ${item.academicYear}`} aria-label={`Hapus kelas ${item.name}`} title="Hapus kelas"><span class="material-symbols-outlined">delete</span></button>
    </div></td></tr>)}
  </tbody></table></div>
  <dialog id="edit-class-dialog" aria-labelledby="edit-class-title">
    <form id="edit-class-form" class="edit-class-form">
      <h3 id="edit-class-title">Edit kelas</h3>
      <p id="edit-class-message" role="alert" hidden></p>
      <label>Tahun ajaran<input name="academicYear" maxlength="9" pattern="[0-9]{4}/[0-9]{4}" required/></label>
      <label>Nama kelas<input name="name" maxlength="40" required/></label>
      <label>Jurusan<select name="departmentId" required><option value="">Pilih jurusan</option>{departments.map((department) => <option value={department.id}>{department.name}</option>)}</select></label>
      <div class="dialog-actions"><button class="btn btn-primary" type="submit">Simpan perubahan</button><button class="btn btn-outline" id="edit-class-cancel" type="button">Batal</button></div>
    </form>
  </dialog>
</AdminLayout>

<style>
  .class-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:12px;align-items:start;margin-top:14px}
  .class-form label{display:flex;min-width:0;flex-direction:column;gap:5px;font-size:13px;font-weight:700}
  .class-form small{font-size:11px;font-weight:400;color:var(--color-muted)}
  .class-form button{margin-top:18px}
  .class-table{padding:0;overflow:auto}
  .class-actions{display:flex;gap:4px}
  .class-actions .btn{padding:6px 10px;font-size:11px}
  .class-actions .material-symbols-outlined{font-size:16px}
  .class-actions .delete-class{color:#dc2626}
  #edit-class-dialog{width:min(460px,calc(100% - 32px));border:0;border-radius:12px;padding:24px;box-shadow:0 20px 60px #0003}
  #edit-class-dialog::backdrop{background:#11182799}
  .edit-class-form{display:grid;gap:14px}
  .edit-class-form h3{font-size:18px;font-weight:800}
  #edit-class-message{padding:10px;border-radius:8px;background:#fff1f0;color:#991b1b;font-size:13px}
  .edit-class-form label{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:700}
  .dialog-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:4px}
  @media(max-width:800px){.class-form{grid-template-columns:repeat(2,minmax(0,1fr))}.class-form button{justify-self:start}}
  @media(max-width:480px){.class-form{grid-template-columns:1fr}.class-form button{margin-top:0}}
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#class-form');
  const editForm = document.querySelector<HTMLFormElement>('#edit-class-form')!;
  const dialog = document.querySelector<HTMLDialogElement>('#edit-class-dialog')!;
  const editMessage = document.querySelector<HTMLElement>('#edit-class-message')!;
  const message = document.querySelector<HTMLElement>('#class-message')!;
  let csrf = '';
  fetch('/api/admin/classes').then((response) => { csrf = response.headers.get('x-csrf-token') ?? ''; }).catch(() => {});
  const showMessage = (text: string, ok = false) => {
    message.textContent = text; message.style.display = 'block';
    message.style.background = ok ? '#eef5ef' : '#fff1f0'; message.style.color = ok ? '#31573c' : '#991b1b';
  };
  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!csrf) { showMessage('Sesi keamanan belum siap. Muat ulang halaman lalu coba lagi.'); return; }
      const body = Object.fromEntries(new FormData(form));
      try {
        const response = await fetch('/api/admin/classes', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify(body) });
        if (!response.ok) {
          const result = await response.json().catch(() => null);
          showMessage(result?.error?.code === 'DUPLICATE_CLASS' ? 'Kelas dengan tahun ajaran, nama, dan jurusan tersebut sudah ada.' : 'Kelas gagal disimpan.'); return;
        }
        location.reload();
      } catch { showMessage('Koneksi terputus. Periksa koneksi lalu coba lagi.'); }
    });
  }
  document.querySelectorAll<HTMLButtonElement>('.edit-class').forEach((button) => button.addEventListener('click', () => {
    const item = JSON.parse(button.dataset.class!);
    editForm.dataset.id = item.id;
    editMessage.hidden = true;
    editForm.elements.namedItem('academicYear')!.value = item.academicYear;
    editForm.elements.namedItem('name')!.value = item.name;
    editForm.elements.namedItem('departmentId')!.value = item.departmentId;
    dialog.showModal();
  }));
  document.querySelector<HTMLButtonElement>('#edit-class-cancel')!.addEventListener('click', () => dialog.close());
  editForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!csrf) { editMessage.textContent = 'Sesi keamanan belum siap. Muat ulang halaman lalu coba lagi.'; editMessage.hidden = false; return; }
    try {
      const response = await fetch(`/api/admin/classes/${editForm.dataset.id}`, {
        method: 'PATCH', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
        body: JSON.stringify(Object.fromEntries(new FormData(editForm))),
      });
      if (!response.ok) {
        const result = await response.json().catch(() => null);
        editMessage.textContent = result?.error?.code === 'DUPLICATE_CLASS' ? 'Kelas dengan tahun ajaran, nama, dan jurusan tersebut sudah ada.' : 'Perubahan kelas gagal disimpan.';
        editMessage.hidden = false; return;
      }
      location.reload();
    } catch { editMessage.textContent = 'Koneksi terputus. Periksa koneksi lalu coba lagi.'; editMessage.hidden = false; }
  });
  document.querySelectorAll<HTMLButtonElement>('.delete-class').forEach((button) => button.addEventListener('click', async () => {
    if (!window.confirm(`Hapus kelas ${button.dataset.name}? Tindakan ini tidak dapat dibatalkan.`)) return;
    if (!csrf) { showMessage('Sesi keamanan belum siap. Muat ulang halaman lalu coba lagi.'); return; }
    try {
      const response = await fetch(`/api/admin/classes/${button.dataset.id}`, { method: 'DELETE', credentials: 'same-origin', headers: { 'X-CSRF-Token': csrf } });
      if (!response.ok) {
        const result = await response.json().catch(() => null);
        showMessage(result?.error?.code === 'CLASS_HAS_STUDENTS' ? 'Kelas tidak dapat dihapus karena masih memiliki siswa.' : 'Kelas gagal dihapus.'); return;
      }
      location.reload();
    } catch { showMessage('Koneksi terputus. Periksa koneksi lalu coba lagi.'); }
  }));
</script>
