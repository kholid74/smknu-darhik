---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import MediaPicker from '../../../components/MediaPicker.astro';
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';
import { assignAlumniIdIfNeeded } from '../../../lib/alumni-id';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const { id } = Astro.params as { id: string };
const isEdit = id && id !== 'new';
const item = isEdit ? await db.alumni.findUnique({ where: { id } }) : null;
if (id && id !== 'new' && !item) return Astro.redirect('/admin/alumni?saved=1');

let error = '';
let form: any = item;
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const record: any = {
    nama: data.get('nama')?.toString() || '',
    angkatan: parseInt(data.get('angkatan')?.toString() || '') || new Date().getFullYear(),
    jurusan: data.get('jurusan')?.toString() || 'Lainnya',
    status: data.get('status')?.toString() || 'Bekerja',
    pekerjaan: data.get('pekerjaan')?.toString() || null,
    instansi: data.get('instansi')?.toString() || null,
    domisili: data.get('domisili')?.toString() || null,
    cerita: data.get('cerita')?.toString() || null,
    email: data.get('email')?.toString().trim() || null,
    wa: data.get('wa')?.toString().trim() || null,
    photoUrl: data.get('photoUrl')?.toString() || null,
    verified: data.get('verified') === '1',
    publicOptIn: data.get('publicOptIn') === '1',
    // featured hanya berlaku kalau opt-in; kalau tidak, paksa false
    featured: data.get('publicOptIn') === '1' && data.get('featured') === '1',
  };
  try {
    const saved = isEdit
      ? await db.alumni.update({ where: { id: id! }, data: record })
      : await db.alumni.create({ data: record });
    await assignAlumniIdIfNeeded(saved.id); // beri ID kartu bila verified & belum ada
    return Astro.redirect('/admin/alumni?saved=1');
  } catch (e: any) {
    if (e?.code === 'P2002') {
      const f = Array.isArray(e?.meta?.target) ? e.meta.target.join(', ') : 'email/WA';
      error = `Gagal simpan: ${f} sudah dipakai alumni lain.`;
      form = { ...record }; // pertahankan input
    } else throw e;
  }
}

const departments = await db.department.findMany({ orderBy: { order: 'asc' }, select: { name: true } });
const jurusanOptions = [...departments.map((d) => d.name), 'Multimedia'];
const regencies = await db.regency.findMany({ orderBy: { name: 'asc' }, select: { name: true } });
const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 2010 + 1 }, (_, i) => currentYear - i);
const statuses = ['Bekerja', 'Kuliah', 'Wirausaha', 'Lainnya'];
---

<AdminLayout title={isEdit ? 'Edit Alumni' : 'Tambah Alumni'} user={{ role: session.role }}>
  <form method="POST" style="max-width:640px" id="alumni-form" data-was-optin={form?.publicOptIn ? '1' : '0'} data-was-featured={form?.featured ? '1' : '0'}>
    {error && <div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-size:13px;border-radius:10px;padding:10px 14px;margin-bottom:14px">{error}</div>}
    <div class="card" style="display:flex;flex-direction:column;gap:14px">
      {form?.alumniId && (
        <div style="display:flex;align-items:center;gap:8px;background:#f0f7f1;border-radius:8px;padding:8px 12px;font-size:13px">
          <span class="material-symbols-outlined" style="font-size:18px;color:#1B7A3D">badge</span>
          <span>ID Alumni: <strong style="font-family:monospace">{form.alumniId}</strong></span>
          <span style="color:#6f7a6e;font-size:12px">— permanen, otomatis saat verifikasi</span>
        </div>
      )}
      <div><label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Nama *</label><input type="text" name="nama" value={form?.nama || ''} required/></div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <div>
          <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Angkatan (tahun lulus) *</label>
          <select name="angkatan" required>
            {years.map((y) => <option value={y} selected={form?.angkatan === y}>{y}</option>)}
          </select>
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Jurusan *</label>
          <input type="text" name="jurusan" value={form?.jurusan || ''} list="jurusan-list" required placeholder="Pilih atau ketik..."/>
          <datalist id="jurusan-list">
            {jurusanOptions.map((j) => <option value={j}></option>)}
          </datalist>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px">
        <div>
          <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Status</label>
          <select name="status">
            {statuses.map((s) => <option value={s} selected={(form?.status || 'Bekerja') === s}>{s}</option>)}
          </select>
        </div>
        <div><label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Pekerjaan</label><input type="text" name="pekerjaan" value={form?.pekerjaan || ''}/></div>
        <div><label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Instansi</label><input type="text" name="instansi" value={form?.instansi || ''}/></div>
      </div>

      <div>
        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Domisili <span style="font-weight:500;color:#6f7a6e">(kota/kabupaten)</span></label>
        <input type="text" name="domisili" value={form?.domisili || ''} list="kota-list" placeholder="mis. Kabupaten Lamongan"/>
        <datalist id="kota-list">{regencies.map((r) => <option value={r.name}></option>)}</datalist>
      </div>

      <div><label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Cerita singkat</label><textarea name="cerita" rows="4" style="resize:vertical" placeholder="1 paragraf...">{form?.cerita || ''}</textarea></div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <div>
          <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Email <span style="font-weight:500;color:#6f7a6e">(privat — login alumni)</span></label>
          <input type="email" name="email" value={form?.email || ''} placeholder="nama@email.com"/>
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">No. WA <span style="font-weight:500;color:#6f7a6e">(privat)</span></label>
          <input type="text" name="wa" value={form?.wa || ''} placeholder="08xxxx"/>
        </div>
      </div>

      <MediaPicker field="photoUrl" value={form?.photoUrl || ''} label="Foto (opsional)" folder="alumni" hint="Foto potret/landscape, wajah jelas · lebar ≥ 600px · maks 5MB." />

      <div style="display:flex;flex-direction:column;gap:10px;background:#f0f7f1;border-radius:10px;padding:14px">
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600"><input type="checkbox" name="verified" value="1" checked={form?.verified ?? false} style="width:auto"/> Terverifikasi (data valid, masuk direktori internal)</label>
        <label style="display:flex;align-items:flex-start;gap:8px;font-size:13px;font-weight:600"><input type="checkbox" name="publicOptIn" value="1" checked={form?.publicOptIn ?? false} style="width:auto;margin-top:3px"/> <span>Bersedia tampil publik <span style="font-weight:500;color:#6f7a6e">— centang hanya bila alumni sudah menyetujui (mis. konfirmasi via WA)</span></span></label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600"><input type="checkbox" name="featured" value="1" checked={form?.featured ?? false} style="width:auto"/> Tampilkan di showcase beranda <span style="font-weight:500;color:#6f7a6e">— butuh "Bersedia tampil publik"</span></label>
      </div>
    </div>
    <div style="display:flex;gap:10px;margin-top:16px"><button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">save</span> Simpan</button><a href="/admin/alumni" class="btn btn-outline">Batal</a></div>
  </form>

  <div id="pub-modal" class="modal-overlay" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="pub-title">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <span class="material-symbols-outlined" style="color:#C8963E;font-size:24px">public</span>
        <h3 id="pub-title" style="font-size:16px;font-weight:800;margin:0">Tampilkan ke Publik?</h3>
      </div>
      <p id="pub-msg" style="font-size:13px;color:#5a6459;line-height:1.5;margin-bottom:18px"></p>
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button type="button" class="btn btn-outline" id="pub-cancel">Batal</button>
        <button type="button" class="btn btn-primary" id="pub-confirm"><span class="material-symbols-outlined" style="font-size:16px">check</span> Ya, tampilkan</button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:center; justify-content:center; z-index:60; padding:16px; }
  .modal-overlay[hidden] { display:none; }
  .modal-card { background:#fff; border-radius:14px; padding:22px; width:100%; max-width:420px; box-shadow:0 20px 60px rgba(0,0,0,.25); }
</style>

<script>
  const form = document.getElementById('alumni-form') as HTMLFormElement | null;
  const modal = document.getElementById('pub-modal');
  if (form && modal) {
    const optin = form.querySelector('input[name="publicOptIn"]') as HTMLInputElement;
    const featured = form.querySelector('input[name="featured"]') as HTMLInputElement;
    const namaEl = form.querySelector('input[name="nama"]') as HTMLInputElement;
    const msg = document.getElementById('pub-msg');
    const wasOptin = form.dataset.wasOptin === '1';
    const wasFeatured = form.dataset.wasFeatured === '1';
    let confirmed = false;

    form.addEventListener('submit', (e) => {
      if (confirmed) return;
      // Konfirmasi hanya saat MENGAKTIFKAN paparan publik baru
      const newlyPublic = (optin?.checked && !wasOptin) || (featured?.checked && optin?.checked && !wasFeatured);
      if (!newlyPublic) return;
      e.preventDefault();
      const nama = namaEl?.value || 'Alumni ini';
      if (msg) msg.innerHTML = `<strong style="color:#1c1b1b">${nama}</strong> akan ditampilkan publik${featured?.checked ? ' di showcase beranda' : ' (opt-in)'}. Pastikan alumni sudah menyetujui. Lanjutkan?`;
      modal.hidden = false;
    });

    document.getElementById('pub-cancel')?.addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', (ev) => { if (ev.target === modal) modal.hidden = true; });
    document.getElementById('pub-confirm')?.addEventListener('click', () => { confirmed = true; modal.hidden = true; form.submit(); });
  }
</script>
