---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const statusFilter = url.searchParams.get('v') || ''; // '' | pending | verified
const angkatanFilter = url.searchParams.get('a') || '';
const jurusanFilter = url.searchParams.get('j') || '';
const page = parseInt(url.searchParams.get('page') || '1');
const limit = 15;

// Sort — kolom yang boleh diurutkan (whitelist) + arah
const sortCols: Record<string, string> = { nama: 'nama', angkatan: 'angkatan', jurusan: 'jurusan', pekerjaan: 'pekerjaan', status: 'verified' };
const sort = url.searchParams.get('sort') || '';
const dir = url.searchParams.get('dir') === 'asc' ? 'asc' : 'desc';
const orderBy: any = sortCols[sort]
  ? [{ [sortCols[sort]]: dir }, { createdAt: 'desc' }]
  : [{ verified: 'asc' }, { createdAt: 'desc' }];

const where: any = {};
if (search) where.nama = { contains: search };
if (statusFilter === 'pending') where.verified = false;
if (statusFilter === 'verified') where.verified = true;
if (angkatanFilter) where.angkatan = parseInt(angkatanFilter) || undefined;
if (jurusanFilter) where.jurusan = jurusanFilter;

const [alumni, total, pending, angkatanRows, jurusanRows] = await Promise.all([
  db.alumni.findMany({ where, orderBy, skip: (page - 1) * limit, take: limit }),
  db.alumni.count({ where }),
  db.alumni.count({ where: { verified: false } }),
  db.alumni.findMany({ distinct: ['angkatan'], select: { angkatan: true }, orderBy: { angkatan: 'desc' } }),
  db.alumni.findMany({ distinct: ['jurusan'], select: { jurusan: true }, orderBy: { jurusan: 'asc' } }),
]);

const angkatanList = angkatanRows.map((r) => r.angkatan);
const jurusanList = jurusanRows.map((r) => r.jurusan);
const totalPages = Math.ceil(total / limit);

// Bangun querystring dgn override, jaga semua filter/sort tetap ada
const mkQs = (ov: Record<string, string | number> = {}) => {
  const s = new URLSearchParams();
  const base: Record<string, string> = { q: search, v: statusFilter, a: angkatanFilter, j: jurusanFilter, sort, dir, page: String(page) };
  const merged = { ...base, ...Object.fromEntries(Object.entries(ov).map(([k, v]) => [k, String(v)])) };
  for (const [k, v] of Object.entries(merged)) if (v) s.set(k, v);
  return `?${s.toString()}`;
};
// Header sort: klik toggle arah; kolom baru default desc
const sortLink = (col: string) => mkQs({ sort: col, dir: sort === col && dir === 'desc' ? 'asc' : 'desc', page: 1 });
const sortIcon = (col: string) => (sort !== col ? 'unfold_more' : dir === 'asc' ? 'arrow_upward' : 'arrow_downward');
---

<AdminLayout title="Alumni" user={{ role: session.role }}>
  {url.searchParams.get('kartu') === 'belum' && (
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-size:13px;border-radius:10px;padding:10px 14px;margin-bottom:16px">
      Kartu hanya tersedia untuk alumni yang sudah <strong>terverifikasi</strong> (punya ID alumni). Verifikasi dulu alumni tersebut.
    </div>
  )}
  {pending > 0 && (
    <div style="background:#fef9c3;border:1px solid #fde047;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:8px;font-size:13px">
      <span class="material-symbols-outlined" style="font-size:18px;color:#a16207">notifications_active</span>
      <span><strong>{pending}</strong> pendaftaran menunggu verifikasi.</span>
      <a href="?v=pending" style="margin-left:auto;color:#a16207;font-weight:700">Lihat →</a>
    </div>
  )}

  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <div style="display:flex;gap:10px;align-items:center">
      <form method="GET" style="display:flex;gap:8px">
        <input type="hidden" name="sort" value={sort}/>
        <input type="hidden" name="dir" value={dir}/>
        <input type="text" name="q" value={search} placeholder="Cari nama..." style="width:200px"/>
        <select name="v" style="width:150px" onchange="this.form.submit()">
          <option value="" selected={statusFilter === ''}>Semua Status</option>
          <option value="pending" selected={statusFilter === 'pending'}>Menunggu Verifikasi</option>
          <option value="verified" selected={statusFilter === 'verified'}>Terverifikasi</option>
        </select>
        <select name="a" style="width:140px" onchange="this.form.submit()">
          <option value="" selected={angkatanFilter === ''}>Semua Angkatan</option>
          {angkatanList.map((y) => <option value={String(y)} selected={angkatanFilter === String(y)}>{y}</option>)}
        </select>
        <select name="j" style="width:170px" onchange="this.form.submit()">
          <option value="" selected={jurusanFilter === ''}>Semua Jurusan</option>
          {jurusanList.map((j) => <option value={j} selected={jurusanFilter === j}>{j}</option>)}
        </select>
        <button type="submit" class="btn btn-outline" style="padding:10px 14px">Cari</button>
      </form>
    </div>
    <a href="/admin/alumni/new" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Tambah Alumni</a>
  </div>

  <div class="card" style="padding:0">
    <table>
      <thead>
        <tr>
          <th style="width:24%"><a href={sortLink('nama')} class="th-sort" data-active={sort === 'nama' || undefined}>Nama <span class="material-symbols-outlined">{sortIcon('nama')}</span></a></th>
          <th><a href={sortLink('angkatan')} class="th-sort" data-active={sort === 'angkatan' || undefined}>Angkatan <span class="material-symbols-outlined">{sortIcon('angkatan')}</span></a></th>
          <th><a href={sortLink('jurusan')} class="th-sort" data-active={sort === 'jurusan' || undefined}>Jurusan <span class="material-symbols-outlined">{sortIcon('jurusan')}</span></a></th>
          <th><a href={sortLink('pekerjaan')} class="th-sort" data-active={sort === 'pekerjaan' || undefined}>Pekerjaan <span class="material-symbols-outlined">{sortIcon('pekerjaan')}</span></a></th>
          <th><a href={sortLink('status')} class="th-sort" data-active={sort === 'status' || undefined}>Status <span class="material-symbols-outlined">{sortIcon('status')}</span></a></th>
          <th>Publik</th>
          <th style="width:150px"></th>
        </tr>
      </thead>
      <tbody>
        {alumni.length === 0 ? (
          <tr><td colspan="7" style="text-align:center;padding:40px;color:#6f7a6e">Belum ada alumni.</td></tr>
        ) : alumni.map(a => (
          <tr>
            <td style="font-weight:600">{a.nama}
              {a.alumniId && <div style="font-size:11px;color:#6f7a6e;font-weight:600;font-family:monospace;margin-top:2px">{a.alumniId}</div>}
            </td>
            <td style="font-size:13px">{a.angkatan}</td>
            <td style="font-size:12px;color:#6f7a6e">{a.jurusan}</td>
            <td style="font-size:12px;color:#6f7a6e">{[a.pekerjaan, a.instansi].filter(Boolean).join(' · ') || '-'}</td>
            <td>
              {a.verified
                ? <span class="badge badge-green">Terverifikasi</span>
                : <span class="badge badge-gold">Menunggu</span>
              }
            </td>
            <td>
              {a.featured
                ? <span class="badge badge-green" title="Tampil di showcase publik">Tampil</span>
                : a.publicOptIn
                  ? <span class="badge badge-gray" title="Opt-in, belum di-showcase">Opt-in</span>
                  : <span style="font-size:11px;color:#94a3b8" title="Alumni tidak bersedia tampil publik">— privat</span>
              }
            </td>
            <td>
              <div style="display:flex;gap:4px">
                {!a.verified && (
                  <button type="button" class="btn btn-outline js-approve" data-id={a.id} data-nama={a.nama} style="padding:6px 10px;font-size:11px;color:#16a34a" title="Setujui & tampilkan"><span class="material-symbols-outlined" style="font-size:16px">check_circle</span></button>
                )}
                {a.verified && a.publicOptIn && (
                  <form method="POST" action="/admin/alumni/feature" style="display:inline">
                    <input type="hidden" name="id" value={a.id}/>
                    <button type="submit" class="btn btn-outline" style={`padding:6px 10px;font-size:11px;${a.featured ? 'color:#C8963E' : 'color:#94a3b8'}`} title={a.featured ? 'Hentikan tampil di showcase' : 'Tampilkan di showcase publik'}><span class="material-symbols-outlined" style="font-size:16px">{a.featured ? 'star' : 'star_outline'}</span></button>
                  </form>
                )}
                {a.verified && !a.publicOptIn && (
                  <span class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#cbd5e1;cursor:not-allowed" title="Alumni tidak opt-in tampil publik"><span class="material-symbols-outlined" style="font-size:16px">star_outline</span></span>
                )}
                {a.verified && a.alumniId && (
                  <a href={`/admin/alumni/kartu/${a.id}`} class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#1B7A3D" title="Kartu alumni (QR + download)"><span class="material-symbols-outlined" style="font-size:16px">badge</span></a>
                )}
                <a href={`/admin/alumni/${a.id}`} class="btn btn-outline" style="padding:6px 10px;font-size:11px" title="Edit"><span class="material-symbols-outlined" style="font-size:16px">edit</span></a>
                <form method="POST" action="/admin/alumni/delete" style="display:inline">
                  <input type="hidden" name="id" value={a.id}/>
                  <button type="submit" class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#dc2626" title="Hapus"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {totalPages > 1 && (
    <div style="display:flex;justify-content:center;gap:6px;margin-top:20px">
      {Array.from({length: totalPages}, (_, i) => i + 1).map(p => (
        <a href={mkQs({ page: p })} class={`btn ${p === page ? 'btn-primary' : 'btn-outline'}`} style="padding:8px 14px;font-size:13px">{p}</a>
      ))}
    </div>
  )}

  <p style="font-size:12px;color:#6f7a6e;margin-top:12px">Total: {total} alumni</p>

  <div id="approve-modal" class="modal-overlay" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="approve-title">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <span class="material-symbols-outlined" style="color:#16a34a;font-size:24px">check_circle</span>
        <h3 id="approve-title" style="font-size:16px;font-weight:800;margin:0">Setujui Alumni?</h3>
      </div>
      <p style="font-size:13px;color:#5a6459;line-height:1.5;margin-bottom:18px"><strong id="approve-nama" style="color:#1c1b1b"></strong> akan <strong>terverifikasi</strong> dan tampil publik di direktori alumni.</p>
      <form method="POST" action="/admin/alumni/verify" style="display:flex;gap:10px;justify-content:flex-end">
        <input type="hidden" name="id" id="approve-id"/>
        <button type="button" class="btn btn-outline js-approve-cancel">Batal</button>
        <button type="submit" class="btn btn-primary" style="background:#16a34a;border-color:#16a34a"><span class="material-symbols-outlined" style="font-size:16px">check</span> Setujui</button>
      </form>
    </div>
  </div>
</AdminLayout>

<style>
  .th-sort { display:inline-flex; align-items:center; gap:4px; color:inherit; text-decoration:none; cursor:pointer; user-select:none; white-space:nowrap; }
  .th-sort:hover { color:#1B7A3D; }
  .th-sort .material-symbols-outlined { font-size:15px; opacity:.35; }
  .th-sort[data-active] { color:#1B7A3D; }
  .th-sort[data-active] .material-symbols-outlined { opacity:1; }
  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:center; justify-content:center; z-index:60; padding:16px; }
  .modal-overlay[hidden] { display:none; }
  .modal-card { background:#fff; border-radius:14px; padding:22px; width:100%; max-width:400px; box-shadow:0 20px 60px rgba(0,0,0,.25); }
</style>

<script>
  const modal = document.getElementById('approve-modal');
  const nameEl = document.getElementById('approve-nama');
  const idEl = document.getElementById('approve-id') as HTMLInputElement | null;
  const open = (id: string, nama: string) => {
    if (!modal || !nameEl || !idEl) return;
    idEl.value = id;
    nameEl.textContent = nama;
    modal.hidden = false;
  };
  const close = () => { if (modal) modal.hidden = true; };
  document.querySelectorAll('.js-approve').forEach((btn) => {
    btn.addEventListener('click', () => open(btn.getAttribute('data-id') || '', btn.getAttribute('data-nama') || ''));
  });
  document.querySelector('.js-approve-cancel')?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>
