---
export const prerender = false;
import { verifyToken } from '../../../../lib/auth';
import { db } from '../../../../lib/prisma';
import { buildAlumniCard } from '../../../../lib/alumni-card';

// Halaman kartu alumni (admin). Guard kapabilitas ada di middleware (/admin/alumni -> alumni.moderasi).
const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const { id } = Astro.params;
const a = id
  ? await db.alumni.findUnique({
      where: { id },
      select: { nama: true, jurusan: true, angkatan: true, photoUrl: true, alumniId: true, verifyToken: true, verified: true },
    })
  : null;
if (!a) return Astro.redirect('/admin/alumni');
// Kartu hanya untuk alumni yang sudah di-approve (punya ID + token verify).
if (!a.verified || !a.alumniId || !a.verifyToken) return Astro.redirect('/admin/alumni?kartu=belum');

// URL absolut untuk QR: pin domain via env PUBLIC_SITE_URL bila diset, selain itu origin request.
const origin = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const { svg: cardSvg, filename } = await buildAlumniCard(
  { nama: a.nama, jurusan: a.jurusan, angkatan: a.angkatan, photoUrl: a.photoUrl, alumniId: a.alumniId!, verifyToken: a.verifyToken! },
  origin
);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kartu {a.alumniId} — {a.nama}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; margin: 0; }
      body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f1efec; color: #1c1b1b; padding: 24px; }
      .bar { max-width: 1000px; margin: 0 auto 18px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .bar h1 { font-size: 18px; font-weight: 800; flex: 1; }
      .btn { display: inline-flex; align-items: center; gap: 6px; border-radius: 10px; padding: 10px 16px; font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; border: 1px solid transparent; }
      .btn-primary { background: #1B7A3D; color: #fff; }
      .btn-outline { background: #fff; color: #1c1b1b; border-color: #d9ddd7; }
      .cardwrap { max-width: 1000px; margin: 0 auto; }
      .cardwrap svg { width: 100%; height: auto; display: block; border-radius: 28px; box-shadow: 0 20px 50px rgba(0,0,0,.14); }
      .hint { max-width: 1000px; margin: 16px auto 0; font-size: 13px; color: #6f7a6e; line-height: 1.6; }
    </style>
  </head>
  <body>
    <div class="bar">
      <a href="/admin/alumni" class="btn btn-outline"><span class="material-symbols-outlined" style="font-size:18px">arrow_back</span> Alumni</a>
      <h1>Kartu Alumni — {a.nama}</h1>
      <button id="dl" class="btn btn-primary"><span class="material-symbols-outlined" style="font-size:18px">download</span> Download PNG</button>
    </div>

    <div class="cardwrap" id="card" set:html={cardSvg}></div>

    <p class="hint">QR mengarah ke halaman verifikasi publik (foto, nama, jurusan, angkatan) — kontak pribadi tidak ditampilkan. Download PNG lalu kirim ke alumni via WhatsApp.</p>

    <script define:vars={{ filename }}>
      document.getElementById('dl').addEventListener('click', async () => {
        const svgEl = document.querySelector('#card svg');
        if (!svgEl) return;
        const scale = 2; // resolusi 2x untuk cetak
        const vb = svgEl.viewBox.baseVal;
        const w = vb.width, h = vb.height;
        const xml = new XMLSerializer().serializeToString(svgEl);
        const svg64 = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml);
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = w * scale; canvas.height = h * scale;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob((blob) => {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = filename;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 2000);
          }, 'image/png');
        };
        img.onerror = () => alert('Gagal merender kartu. Coba muat ulang halaman.');
        img.src = svg64;
      });
    </script>
  </body>
</html>
