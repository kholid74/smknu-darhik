---
export const prerender = false;
import { verifyToken } from '../../../../lib/auth';
import { db } from '../../../../lib/prisma';
import { qrMatrix, verifyPath } from '../../../../lib/qr';
import sharp from 'sharp';
import { readFile } from 'node:fs/promises';

// Halaman kartu alumni (admin). Guard kapabilitas ada di middleware (/admin/alumni -> alumni.moderasi).
const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const { id } = Astro.params;
const a = id
  ? await db.alumni.findUnique({
      where: { id },
      select: { nama: true, jurusan: true, angkatan: true, photoUrl: true, alumniId: true, verifyToken: true, verified: true },
    })
  : null;
if (!a) return Astro.redirect('/admin/alumni');
// Kartu hanya untuk alumni yang sudah di-approve (punya ID + token verify).
if (!a.verified || !a.alumniId || !a.verifyToken) return Astro.redirect('/admin/alumni?kartu=belum');

// URL absolut untuk QR: pin domain via env PUBLIC_SITE_URL bila diset, selain itu origin request.
const origin = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const verifyUrl = new URL(verifyPath(a.verifyToken), origin).toString();

// Embed logo + foto sebagai data URL (via sharp) agar ikut ter-render saat SVG dirasterisasi ke PNG.
async function logoDataUrl(): Promise<string> {
  try {
    const buf = await readFile('public/assets/logo.png');
    const out = await sharp(buf).resize(180, 180, { fit: 'contain', background: { r: 255, g: 255, b: 255, alpha: 0 } }).png().toBuffer();
    return `data:image/png;base64,${out.toString('base64')}`;
  } catch { return ''; }
}
async function photoDataUrl(url: string): Promise<string> {
  try {
    const abs = new URL(url, origin).toString();
    const res = await fetch(abs);
    if (!res.ok) return '';
    const buf = Buffer.from(await res.arrayBuffer());
    const out = await sharp(buf).resize(520, 640, { fit: 'cover' }).jpeg({ quality: 84 }).toBuffer();
    return `data:image/jpeg;base64,${out.toString('base64')}`;
  } catch { return ''; }
}
const logo = await logoDataUrl();
const photo = a.photoUrl ? await photoDataUrl(a.photoUrl) : '';

// ---- susun kartu sebagai SVG (fixed 1000x620) ----
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const W = 1000, H = 620;

// QR path (nested murni, tanpa sub-resource -> aman dirasterisasi)
const m = qrMatrix(verifyUrl, 'M');
const n = m.length;
const qMod = 5;
const qSize = n * qMod;
const qPad = qMod * 2; // quiet zone
const qBox = qSize + qPad * 2;
const qBoxX = W - 60 - qBox, qBoxY = 300;
const qx = qBoxX + qPad, qy = qBoxY + qPad;
let qrPath = '';
for (let r = 0; r < n; r++) for (let c = 0; c < n; c++)
  if (m[r][c]) qrPath += `M${qx + c * qMod} ${qy + r * qMod}h${qMod}v${qMod}h-${qMod}z`;

// nama: perkecil font bila panjang
const namaLen = a.nama.length;
const namaSize = namaLen <= 16 ? 44 : namaLen <= 22 ? 34 : namaLen <= 30 ? 27 : 22;

const cardSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" font-family="'Plus Jakarta Sans', Arial, sans-serif">
  <defs>
    <clipPath id="card"><rect x="0" y="0" width="${W}" height="${H}" rx="28"/></clipPath>
    <clipPath id="photo"><rect x="50" y="175" width="260" height="320" rx="18"/></clipPath>
    <linearGradient id="hdr" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1B7A3D"/><stop offset="1" stop-color="#0f5027"/>
    </linearGradient>
  </defs>
  <g clip-path="url(#card)">
    <rect x="0" y="0" width="${W}" height="${H}" fill="#ffffff"/>
    <rect x="0" y="0" width="${W}" height="140" fill="url(#hdr)"/>
    ${logo ? `<image href="${logo}" x="40" y="28" width="84" height="84"/>` : ''}
    <text x="140" y="66" fill="#ffffff" font-size="30" font-weight="800" letter-spacing="0.5">SMKS NU DARUL HIKAM</text>
    <text x="140" y="98" fill="#eaf5ec" font-size="16" font-weight="600">KARTU ALUMNI · Karanggeneng, Lamongan</text>

    ${photo
      ? `<image href="${photo}" x="50" y="175" width="260" height="320" clip-path="url(#photo)" preserveAspectRatio="xMidYMid slice"/>`
      : `<rect x="50" y="175" width="260" height="320" rx="18" fill="#eef2ee"/><g fill="#b8c2b6"><circle cx="180" cy="300" r="42"/><path d="M112 435 a68 68 0 0 1 136 0 z"/></g>`}
    <rect x="50" y="175" width="260" height="320" rx="18" fill="none" stroke="#e3e8e2" stroke-width="2"/>

    <text x="350" y="230" fill="#1c1b1b" font-size="${namaSize}" font-weight="800">${esc(a.nama)}</text>
    <text x="350" y="272" fill="#6f7a6e" font-size="22" font-weight="600">${esc(a.jurusan)} · Angkatan ${a.angkatan}</text>

    <rect x="350" y="300" width="${18 + a.alumniId.length * 13}" height="40" rx="20" fill="#eef7f0" stroke="#cfe6d4"/>
    <text x="${350 + (18 + a.alumniId.length * 13) / 2}" y="326" fill="#1B7A3D" font-size="19" font-weight="800" letter-spacing="1" text-anchor="middle">${esc(a.alumniId)}</text>

    <g fill="#1B7A3D">
      <text x="350" y="410" fill="#8a938a" font-size="14" font-weight="600">STATUS</text>
      <text x="350" y="438" fill="#1c1b1b" font-size="20" font-weight="700">✓ Alumni Terverifikasi</text>
    </g>

    <rect x="${qBoxX}" y="${qBoxY}" width="${qBox}" height="${qBox}" rx="12" fill="#ffffff" stroke="#e3e8e2" stroke-width="2"/>
    <path d="${qrPath}" fill="#0f1a12"/>
    <text x="${qBoxX + qBox / 2}" y="${qBoxY + qBox + 26}" fill="#6f7a6e" font-size="15" font-weight="600" text-anchor="middle">Scan untuk verifikasi</text>

    <rect x="0" y="${H - 46}" width="${W}" height="46" fill="#f7faf7"/>
    <text x="50" y="${H - 18}" fill="#8a938a" font-size="14" font-weight="600">Identitas resmi alumni · Terampil, Beriman, Siap Kerja</text>
  </g>
</svg>`;

const filename = `kartu-${a.alumniId}.png`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kartu {a.alumniId} — {a.nama}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; margin: 0; }
      body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f1efec; color: #1c1b1b; padding: 24px; }
      .bar { max-width: 1000px; margin: 0 auto 18px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .bar h1 { font-size: 18px; font-weight: 800; flex: 1; }
      .btn { display: inline-flex; align-items: center; gap: 6px; border-radius: 10px; padding: 10px 16px; font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; border: 1px solid transparent; }
      .btn-primary { background: #1B7A3D; color: #fff; }
      .btn-outline { background: #fff; color: #1c1b1b; border-color: #d9ddd7; }
      .cardwrap { max-width: 1000px; margin: 0 auto; }
      .cardwrap svg { width: 100%; height: auto; display: block; border-radius: 28px; box-shadow: 0 20px 50px rgba(0,0,0,.14); }
      .hint { max-width: 1000px; margin: 16px auto 0; font-size: 13px; color: #6f7a6e; line-height: 1.6; }
    </style>
  </head>
  <body>
    <div class="bar">
      <a href="/admin/alumni" class="btn btn-outline"><span class="material-symbols-outlined" style="font-size:18px">arrow_back</span> Alumni</a>
      <h1>Kartu Alumni — {a.nama}</h1>
      <button id="dl" class="btn btn-primary"><span class="material-symbols-outlined" style="font-size:18px">download</span> Download PNG</button>
    </div>

    <div class="cardwrap" id="card" set:html={cardSvg}></div>

    <p class="hint">QR mengarah ke halaman verifikasi publik (foto, nama, jurusan, angkatan) — kontak pribadi tidak ditampilkan. Download PNG lalu kirim ke alumni via WhatsApp.</p>

    <script define:vars={{ filename }}>
      document.getElementById('dl').addEventListener('click', async () => {
        const svgEl = document.querySelector('#card svg');
        if (!svgEl) return;
        const scale = 2; // resolusi 2x untuk cetak
        const vb = svgEl.viewBox.baseVal;
        const w = vb.width, h = vb.height;
        const xml = new XMLSerializer().serializeToString(svgEl);
        const svg64 = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml);
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = w * scale; canvas.height = h * scale;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob((blob) => {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = filename;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 2000);
          }, 'image/png');
        };
        img.onerror = () => alert('Gagal merender kartu. Coba muat ulang halaman.');
        img.src = svg64;
      });
    </script>
  </body>
</html>
