---
export const prerender = false;
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');
if (session.role !== 'superadmin') return Astro.redirect('/admin');

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const id = data.get('id')?.toString();
  if (id && id !== session.sub) {
    const acc = await db.account.findUnique({ where: { id }, include: { roles: true } });
    const isSuper = acc?.roles.some((r) => r.role === 'superadmin');
    // Superadmin tak bisa dihapus dari sini (proteksi lockout); begitu pula akun sendiri.
    if (acc && !isSuper) await db.account.delete({ where: { id } }).catch(() => {});
  }
}

return Astro.redirect('/admin/pengguna?saved=1');
---
<html></html>
