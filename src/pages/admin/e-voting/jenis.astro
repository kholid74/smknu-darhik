---
export const prerender=false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import DataTable from '../../../components/ui/DataTable.astro';
import StatusBadge from '../../../components/ui/StatusBadge.astro';
import MediaPicker from '../../../components/MediaPicker.astro';
import { listElectionTypes, type ElectionType } from '../../../lib/voting/election-types';
import { validateTypeQuery } from '../../../lib/voting/election-type-input';
import { csrfHeader } from '../../../lib/voting/admin-http';
import { can } from '../../../lib/rbac';
import { thumbnailUrl } from '../../../lib/image-url';
import { env } from '../../../lib/env';
const principal=Astro.locals.principal;
const manage=!!principal&&can(principal,'evoting.kelola');
const media=!!principal&&can(principal,'media.kelola');
const csrf=csrfHeader(Astro.locals.session!.sub,Astro.cookies.get('smkdh_token')?.value??'');
let items:ElectionType[]=Astro.props.items??[],failed=false;
if(!Astro.props.items)try{
  let cursor:string|null=null;
  do{const page=await listElectionTypes(validateTypeQuery(new URLSearchParams({limit:'100',...(cursor?{cursor}:{})})));items.push(...page.data);cursor=page.nextCursor;}while(cursor);
}catch{failed=true;Astro.response.status=503;}
Astro.response.headers.set('Cache-Control','private, no-store');
const mode=(value:string)=>value==='SINGLE'?'Calon tunggal':'Wakil opsional';
---
<AdminLayout title="Jenis Pemilihan" user={{role:Astro.locals.session?.role??''}}>
  <PageHeader title="Jenis Pemilihan" description="Atur organisasi, jabatan, mode calon dan logo. Perubahan master berlaku saat jenis dipasang ke periode berikutnya.">
    {manage&&!failed&&<button slot="actions" type="button" class="btn btn-primary" id="add-election-type">Tambah jenis</button>}
  </PageHeader>
  <p class="feedback" data-tone="info">Susunan jenis pada periode hanya dapat diubah saat DRAFT. Edit master tidak mengubah nama, logo atau jabatan yang sudah tersimpan pada periode.</p>
  <p id="type-message" class="feedback" role="status" hidden></p>
  {failed?<p class="feedback" data-tone="error">Jenis belum dapat dimuat. <a href="/admin/e-voting/jenis">Muat ulang</a>.</p>:<div class="card type-table"><DataTable id="table-election-types" label="Jenis pemilihan" filterColumn={5} filterLabel="Status"><table>
    <thead><tr><th>Logo</th><th>Nama / kode</th><th>Mode calon</th><th>Jabatan</th><th>Urutan awal</th><th>Status</th>{manage&&<th>Aksi</th>}</tr></thead><tbody>
    {items.length?items.map(item=><tr>
      <td>{item.logoUrl?<img src={thumbnailUrl(item.logoUrl,96,Astro.url.origin,env('R2_PUBLIC_URL'))} width="40" height="40" loading="lazy" alt=""/>:'—'}</td>
      <td><strong>{item.name}</strong><br/><small>{item.code}</small></td><td>{mode(item.candidateMode)}</td>
      <td>{item.chairLabel}{item.viceChairLabel&&<><br/><small>{item.viceChairLabel}</small></>}</td><td>{item.sortOrder}</td>
      <td><StatusBadge tone={item.active?'success':'neutral'} label={item.active?'Aktif':'Nonaktif'}/></td>
      {manage&&<td><div class="type-actions">
        <button type="button" class="btn btn-outline" data-type-edit data-item={JSON.stringify(item)} aria-label={`Edit ${item.name}`}>Edit</button>
        <button type="button" class="btn btn-outline" data-type-toggle data-item={JSON.stringify(item)}>{item.active?'Nonaktifkan':'Aktifkan'}</button>
        <button type="button" class="btn btn-outline danger" data-type-delete data-item={JSON.stringify(item)} aria-label={`Hapus ${item.name}`}>Hapus</button>
      </div></td>}
    </tr>):<tr><td colspan={manage?7:6}>Belum ada jenis pemilihan.</td></tr>}
    </tbody></table></DataTable></div>}
  {manage&&!failed&&<dialog class="ui-dialog" id="type-dialog" aria-labelledby="type-title">
    <form id="type-form" data-csrf={csrf} class="type-form">
      <h2 id="type-title">Tambah jenis pemilihan</h2><p id="type-form-message" class="feedback" role="alert" hidden></p>
      <label>Kode<input name="code" pattern="[A-Z][A-Z0-9_]{1,31}" maxlength="32" required autocomplete="off"/><small>Huruf besar, angka dan garis bawah. Tidak dapat diubah setelah dibuat.</small></label>
      <label>Nama<input name="name" maxlength="120" required/></label>
      <label>Mode calon<select name="candidateMode"><option value="SINGLE">Calon tunggal</option><option value="OPTIONAL_VICE">Ketua dengan wakil opsional</option></select></label>
      <label>Jabatan utama<input name="chairLabel" maxlength="80" required value="Ketua"/></label>
      <label id="vice-label-field">Jabatan wakil<input name="viceChairLabel" maxlength="80" value="Wakil Ketua"/></label>
      <label>Urutan awal<input name="sortOrder" type="number" min="0" max="9999" step="1" required value="1"/><small>Urutan awal daftar master; setiap periode dapat mengatur urutannya sendiri.</small></label>
      <label class="type-active"><input name="active" type="checkbox" checked/>Aktif — dapat dipasang pada periode baru</label>
      {media?<MediaPicker field="logoUrl" label="Logo organisasi (opsional)" folder="e-voting" assetKind="logo" hint="Pilih gambar yang terdaftar di pustaka media sekolah. Upload logo baru disimpan lossless."/>:<input name="logoUrl" type="hidden"/>}
      <p class="type-note">Menonaktifkan jenis tidak mencabut hak pemilih pada periode yang sudah memakai jenis tersebut.</p>
      <div class="dialog-actions"><button class="btn btn-outline" id="type-cancel" type="button">Batal</button><button class="btn btn-primary" type="submit">Simpan jenis</button></div>
    </form>
  </dialog>}
</AdminLayout>
<style>
  .type-table{padding:0}.type-table img{object-fit:contain;border-radius:6px}.type-table small,.type-note{font-size:12px;color:var(--color-muted)}
  .type-actions{display:flex;gap:6px;flex-wrap:wrap}.danger{color:#b42318}.type-form{display:grid;gap:14px}.type-form h2{font-size:20px}
  #type-dialog{width:min(560px,calc(100% - 32px));max-height:calc(100dvh - 32px);overflow:auto}.type-form label{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:700}.type-form small{font-size:11px;color:var(--color-muted);font-weight:400}
  .type-form .type-active{flex-direction:row;align-items:center;gap:8px}.type-active input{flex-shrink:0}.dialog-actions{display:flex;justify-content:flex-end;gap:8px}.type-note{line-height:1.6;margin:0}
</style>
<script>
  import { confirmAction } from '../../../lib/ui/confirm';
  import type { ElectionType } from '../../../lib/voting/election-types';
  const form=document.querySelector<HTMLFormElement>('#type-form'),dialog=document.querySelector<HTMLDialogElement>('#type-dialog');
  const message=document.querySelector<HTMLElement>('#type-message')!;
  const labels:Record<string,string>={DUPLICATE_TYPE:'Kode jenis sudah digunakan.',TYPE_IN_USE:'Jenis sudah dipakai periode dan tidak dapat dihapus. Nonaktifkan bila tidak dipakai lagi.',STALE_CONFIG:'Data sudah berubah. Muat ulang halaman sebelum menyimpan lagi.',INVALID_LOGO:'Logo harus berupa gambar dari pustaka media sekolah.',INVALID_INPUT:'Periksa kode, nama, jabatan dan mode calon.',CSRF_REJECTED:'Sesi keamanan berakhir. Muat ulang halaman.',FORBIDDEN:'Anda tidak memiliki izin untuk tindakan ini.'};
  const show=(target:HTMLElement,text:string)=>{target.textContent=text;target.hidden=false;target.dataset.tone='error';};
  let editing:ElectionType|null=null,busy=false;
  const field=(name:string)=>form!.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement;
  function mode(){const vice=field('viceChairLabel') as HTMLInputElement;const single=field('candidateMode').value==='SINGLE';vice.disabled=single;vice.required=!single;document.querySelector<HTMLElement>('#vice-label-field')!.hidden=single;}
  function open(item:ElectionType|null){
    if(!form||!dialog||busy)return;editing=item;form.reset();
    for(const key of ['code','name','chairLabel','candidateMode','sortOrder','logoUrl','viceChairLabel'])if(item)field(key).value=String(item[key as keyof ElectionType]??'');
    (field('code') as HTMLInputElement).readOnly=!!item;(field('active') as HTMLInputElement).checked=item?.active??true;
    field('logoUrl').dispatchEvent(new Event('input',{bubbles:true}));mode();
    document.querySelector('#type-title')!.textContent=item?'Edit jenis pemilihan':'Tambah jenis pemilihan';
    document.querySelector<HTMLElement>('#type-form-message')!.hidden=true;dialog.showModal();field(item?'name':'code').focus();
  }
  async function mutate(code:string|null,method:string,body:unknown){
    const response=await fetch('/api/admin/e-voting/types'+(code?'/'+encodeURIComponent(code):''),{method,credentials:'same-origin',headers:{'Content-Type':'application/json','X-CSRF-Token':form!.dataset.csrf!},body:JSON.stringify(body)});
    if(!response.ok){const result=await response.json().catch(()=>null);throw new Error(labels[result?.error?.code]??'Belum dapat menyimpan. Muat ulang untuk memeriksa data terbaru.');}
  }
  document.querySelector('#add-election-type')?.addEventListener('click',()=>open(null));
  document.querySelector('#type-cancel')?.addEventListener('click',()=>{if(!busy)dialog?.close();});
  dialog?.addEventListener('cancel',event=>{if(busy)event.preventDefault();});
  if(form)field('candidateMode').addEventListener('change',mode);
  document.querySelectorAll<HTMLButtonElement>('[data-type-edit]').forEach(button=>button.addEventListener('click',()=>open(JSON.parse(button.dataset.item!))));
  for(const button of document.querySelectorAll<HTMLButtonElement>('[data-type-toggle],[data-type-delete]'))button.addEventListener('click',async()=>{
    if(busy)return;const item:ElectionType=JSON.parse(button.dataset.item!),deleting=button.hasAttribute('data-type-delete');
    if(!await confirmAction(deleting?'Hapus jenis '+item.name+'? Jenis yang sudah dipakai periode tidak dapat dihapus.':(item.active?'Nonaktifkan ':'Aktifkan ')+item.name+'? Periode yang sudah ada tetap memakai snapshot dan haknya.'))return;
    busy=true;button.disabled=true;
    try{await mutate(item.code,deleting?'DELETE':'PATCH',{expectedRevision:item.revision,...(deleting?{}:{active:!item.active})});location.reload();}
    catch(error){show(message,error instanceof Error?error.message:'Koneksi terputus. Muat ulang untuk memeriksa data terbaru.');busy=false;button.disabled=false;}
  });
  form?.addEventListener('submit',async event=>{
    event.preventDefault();if(busy||!form.reportValidity())return;
    const values=Object.fromEntries(new FormData(form)),single=values.candidateMode==='SINGLE';
    const body={name:values.name,candidateMode:values.candidateMode,chairLabel:values.chairLabel,viceChairLabel:single?null:values.viceChairLabel,logoUrl:String(values.logoUrl??'').trim()||null,sortOrder:Number(values.sortOrder),active:(field('active') as HTMLInputElement).checked,
      ...(editing?{expectedRevision:editing.revision}:{code:values.code})};
    busy=true;const submit=form.querySelector<HTMLButtonElement>('[type=submit]')!;submit.disabled=true;
    try{await mutate(editing?.code??null,editing?'PATCH':'POST',body);dialog?.close();location.reload();}
    catch(error){show(document.querySelector('#type-form-message')!,error instanceof Error?error.message:'Koneksi terputus. Muat ulang untuk memeriksa data terbaru.');busy=false;submit.disabled=false;}
  });
</script>
