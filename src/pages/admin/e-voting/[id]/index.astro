---
export const prerender = false;
import PageHeader from '../../../../components/ui/PageHeader.astro';
import StatusBadge from '../../../../components/ui/StatusBadge.astro';
import TestPeriodCleanup from '../../../../components/voting/TestPeriodCleanup.astro';
import ContestPicker from '../../../../components/voting/ContestPicker.astro';
import ResultsAccess from '../../../../components/voting/ResultsAccess.astro';
import {canDeleteTestPeriod} from '../../../../lib/voting/test-cleanup-input';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getPeriod, getPeriodSetup } from '../../../../lib/voting/periods';
import { getParticipation } from '../../../../lib/voting/participation';
import { can } from '../../../../lib/rbac';
import { canEditElectionSetup } from '../../../../lib/voting/setup-readiness';

const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.redirect('/admin/e-voting');
const period = await getPeriod(id);
if (!period) return Astro.redirect('/admin/e-voting');
const lifecycleEditable = canEditElectionSetup(period, new Date());
const schedulable = period.state === 'DRAFT';
const wallTime = (date: Date) => new Date(date.getTime() + 7 * 60 * 60 * 1000).toISOString().slice(0, 16);
const expected = JSON.stringify({ name: period.name, academicYear: period.academicYear, opensAt: period.opensAt.toISOString(), closesAt: period.closesAt.toISOString() });
const dateLabel = (date: Date) => new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(date);
const principal = Astro.locals.principal;
const canManageCandidates = principal ? can(principal, 'evoting.kelola') && can(principal, 'evoting.pemilih') : false;
const canManageRoster = principal ? can(principal, 'evoting.pemilih') : false;
const canManagePins = principal ? can(principal, 'evoting.pin') && can(principal, 'evoting.pemilih') : false;
const canManagePeriod = principal ? can(principal, 'evoting.kelola') : false;
const canClosePeriod = principal ? can(principal, 'evoting.tutup') : false;
const showClose = period.state === 'SCHEDULED' && Date.now() >= period.opensAt.getTime() && canClosePeriod;
const earlyClose = Date.now() < period.closesAt.getTime();
const closingProgress = showClose ? await getParticipation(id).catch(() => null) : null;
const closeReady = !!closingProgress && closingProgress.eligible > 0;
const canPublishPeriod = principal ? can(principal, 'evoting.publikasi') : false;
const resultsPublished = (period.state === 'CLOSED' || period.state === 'ARCHIVED') && !!period.publishedAt;
const canViewParticipation = principal ? can(principal, 'evoting.partisipasi') : false;
const canExtendPeriod = principal ? can(principal, 'evoting.perpanjang') : false;
const editable=lifecycleEditable&&canManagePeriod;
const setup=canManageCandidates&&canManageRoster?await getPeriodSetup(id):null;
const readinessChecks = setup ? [
  { key: 'configuration', title: 'Jadwal dan jenis pemilihan', ready: setup.configurationReady, detail: 'Jadwal mulai di masa depan dan selesai setelah mulai, dengan susunan surat suara yang valid.' },
  { key: 'candidates', title: 'Daftar calon', ready: setup.candidatesReady, detail: setup.candidatesReady ? `Calon untuk seluruh ${period.contests.length} jenis pemilihan sudah lengkap.` : `Lengkapi dan periksa calon untuk seluruh ${period.contests.length} jenis pemilihan.` },
  { key: 'roster', title: 'Daftar pemilih', ready: setup.rosterReady, detail: `${setup.voterCount} pemilih terdaftar. Setiap pemilih harus memiliki hak untuk seluruh jenis periode.` },
  { key: 'pins', title: 'PIN pemilih', ready: setup.pinsReady, detail: `${setup.pinCount} dari ${setup.voterCount} PIN aktif. Seluruh pemilih harus memiliki kredensial yang aktif.` },
] : [];
const readyCheckCount = readinessChecks.filter(check => check.ready).length;
const steps=[
 {label:'Konfigurasi',href:canManagePeriod?'/admin/e-voting/'+id:null,ready:period.state!=='DRAFT'||!!setup?.configurationReady,detail:'Nama dan jadwal WIB'},
 {label:'Calon',href:canManageCandidates?'/admin/e-voting/'+id+'/calon':null,ready:!!setup?.candidatesReady,detail:period.contests.length+' jenis pemilihan'},
 {label:'Pemilih',href:canManageRoster?'/admin/e-voting/'+id+'/pemilih':null,ready:!!setup?.rosterReady,detail:setup?setup.voterCount+'/99 terdaftar':'Master siswa/guru'},
 {label:'PIN',href:canManagePins?'/admin/e-voting/'+id+'/pin':null,ready:!!setup?.pinsReady,detail:setup?setup.pinCount+' PIN aktif':'Kredensial pemilihan'},
 {label:'Jadwalkan',href:canManagePeriod&&period.state==='DRAFT'?'#schedule-period':null,ready:period.state!=='DRAFT',detail:period.state==='DRAFT'?'Periksa kesiapan':period.state},
 {label:'Partisipasi',href:canViewParticipation?'/admin/e-voting/'+id+'/partisipasi':null,ready:period.state!=='DRAFT',detail:'Status, tanpa pilihan'},
 {label:'Hasil resmi',href:resultsPublished?'/e-voting/'+period.slug+'/hasil':null,ready:resultsPublished,detail:resultsPublished?'Dipublikasikan · tab baru':'Belum dipublikasikan',newTab:true},
];

---

<AdminLayout title="Konfigurasi Periode" user={{ role: Astro.locals.session?.role ?? '' }}>
  <a href="/admin/e-voting" style="display:inline-flex;margin-bottom:14px;text-decoration:none;font-size:13px">â† Daftar periode</a>
  <PageHeader title={period.name} description={period.academicYear+' · Jadwal dan langkah persiapan pemilihan'}>
    <div slot="actions" class="page-actions"><a class="btn btn-outline" href="/admin/e-voting/panduan">Panduan pemilihan</a><StatusBadge label={period.state} tone={period.state==='DRAFT'?'warning':'success'}/></div>
  </PageHeader>
  <ResultsAccess period={period}/>
  {period.state === 'CLOSED' && !period.publishedAt && canPublishPeriod && <section id="publish-results" class="card" style="margin-bottom:18px" aria-labelledby="publish-results-title">
    <h3 id="publish-results-title" style="font-size:16px;font-weight:800;margin-bottom:5px">Publikasikan hasil</h3>
    <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">Publikasi membuka hasil resmi untuk umum. Hasil yang sudah diterbitkan tidak dapat ditarik kembali.</p>
    <form id="publish-period-form" method="post" class="publish-form">
      <label>Kata sandi admin<input name="adminPassword" type="password" autocomplete="current-password" required maxlength="256"/></label>
      <button class="btn btn-primary" type="submit" disabled>Publikasikan hasil</button>
    </form>
    <p id="publish-period-message" class="feedback" role="status" aria-live="polite" hidden></p>
  </section>}
  {period.isTest && <p class="feedback" data-tone="warning">Periode ini adalah data uji. Jangan digunakan untuk pemilihan resmi.</p>}
  {period.state === 'DRAFT' && period.opensAt <= new Date() && <p class="feedback" data-tone="warning">Periode masih DRAFT dan tetap dapat disiapkan. Jadwal mulai sudah lewat; ubah jadwal ke waktu mendatang sebelum menjadwalkan pemilihan.</p>}
  <nav class="setup-steps" aria-label="Langkah pemilihan">{steps.map((step,index)=>step.href?<a class="setup-step" href={step.href} target={step.newTab?'_blank':undefined} rel={step.newTab?'noopener noreferrer':undefined} data-ready={step.ready}><span class="step-number">{String(index+1).padStart(2,'0')}</span><strong>{step.label}</strong><small>{step.detail}</small></a>:<div class="setup-step" data-ready={step.ready}><span class="step-number">{String(index+1).padStart(2,'0')}</span><strong>{step.label}</strong><small>{step.detail}</small></div>)}</nav>
  {setup&&period.state==='DRAFT'&&<section class="preflight readiness-panel" data-ready={setup.ready} aria-labelledby="readiness-title">
    <div class="readiness-heading">
      <div><p class="readiness-eyebrow">PERSIAPAN PEMILIHAN</p><h3 id="readiness-title">Pratinjau kesiapan</h3><p class="readiness-count"><strong>{readyCheckCount} dari {readinessChecks.length}</strong> pemeriksaan sudah siap</p></div>
      <StatusBadge label={setup.ready ? 'Siap dijadwalkan' : 'Perlu dilengkapi'} tone={setup.ready ? 'success' : 'warning'}/>
    </div>
    <progress class="readiness-progress" value={readyCheckCount} max={readinessChecks.length} aria-label="Jumlah pemeriksaan yang siap"></progress>
    <ul class="readiness-checks">
      {readinessChecks.map(check => <li class="readiness-item" data-ready={check.ready} data-check={check.key}>
        <span class="readiness-icon" aria-hidden="true">{check.ready ? '✓' : '!'}</span>
        <div class="readiness-content"><div class="readiness-item-heading"><h4>{check.title}</h4><StatusBadge label={check.ready ? 'Siap' : 'Perlu dilengkapi'} tone={check.ready ? 'success' : 'warning'}/></div><p>{check.detail}</p></div>
      </li>)}
    </ul>
    <p class="readiness-note"><span aria-hidden="true">ⓘ</span> Status berdasarkan data saat halaman dimuat. Kesiapan diperiksa ulang oleh server saat dijadwalkan.</p>
  </section>}
  <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:12px">Susunan surat suara</h3>
    {canManagePeriod&&period.state==='DRAFT'?<form id="period-contests-form" data-period-id={id} data-revision={period.contestsRevision}>
      <ContestPicker id="period-edit" initial={period.contests}/>
      <p class="feedback" data-tone="info">Perubahan susunan menyesuaikan hak pemilih secara bersamaan. Jenis yang masih berisi calon tidak dapat dilepas. PIN tetap berlaku.</p>
      <p id="period-contests-message" class="feedback" role="status" hidden></p>
      <button class="btn btn-primary" type="submit" disabled>Simpan susunan</button>
    </form>:<ContestPicker id="period-locked" initial={period.contests} readOnly/>}
  </section>
  <p id="period-message" role="status" aria-live="polite" style="display:none;margin-bottom:14px;padding:12px;border-radius:8px;font-size:13px"></p>
  <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:5px">Konfigurasi</h3>
    <p style="font-size:12px;color:var(--color-muted);margin-bottom:14px">Slug tidak dapat diubah. Jadwal ditampilkan dalam WIB.</p>
    <form id="period-config-form" class="period-form" data-expected={expected}>
      <label>Nama periode<input name="name" maxlength="120" value={period.name} required disabled={!editable}/></label>
      <label>Tahun ajaran<input name="academicYear" maxlength="20" value={period.academicYear} required disabled={!editable}/></label>
      <label>Mulai (WIB)<input name="opensAt" type="datetime-local" value={wallTime(period.opensAt)} required disabled={!editable}/></label>
      <label>Selesai (WIB)<input name="closesAt" type="datetime-local" value={wallTime(period.closesAt)} required disabled={!editable}/></label>
      <div style="display:flex;align-items:end">{editable ? <button class="btn btn-primary" type="submit">Simpan konfigurasi</button> : <p style="font-size:13px;color:var(--color-muted)">Konfigurasi terkunci setelah periode dibuka atau ditutup.</p>}</div>
    </form>
  </section>
  {schedulable && canManagePeriod && <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:5px">Jadwalkan pemilihan</h3>
    <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">Pastikan seluruh jenis periode, calon, pemilih, dan PIN sudah siap. Jadwal masih dapat disunting sebelum pemilihan dibuka.</p>
    <button id="schedule-period" class="btn btn-primary" type="button">Jadwalkan periode</button>
  </section>}
  {period.state === 'CLOSED' && canManagePeriod && <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:5px">Arsipkan periode</h3>
    <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">Arsipkan periode yang sudah ditutup. Data suara dan audit tetap tersimpan.</p>
    <button id="archive-period" class="btn btn-outline" type="button">Arsipkan periode</button>
  </section>}
  {period.closedAt && <p class="feedback">Pemilihan ditutup {dateLabel(period.closedAt)}. Jadwal selesai tetap {dateLabel(period.closesAt)}.</p>}
  {showClose && <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:5px">{earlyClose ? 'Tutup pemilihan lebih awal' : 'Tutup pemilihan'}</h3>
    {closingProgress ? <div class="closing-summary">
      <p>{closingProgress.eligible} pemilih terdaftar · Ringkasan saat halaman dimuat</p>
      <dl>
        <div><dt>Lengkap</dt><dd>{closingProgress.complete}</dd></div>
        <div><dt>Parsial</dt><dd>{closingProgress.partial}</dd></div>
        <div><dt>Belum mulai</dt><dd>{closingProgress.notStarted}</dd></div>
      </dl>
      <p>Penutupan tetap diperbolehkan meski ada pemilih yang belum selesai. Muat ulang untuk melihat partisipasi terbaru.</p>
    </div> : <p class="feedback" data-tone="warning">Ringkasan partisipasi belum tersedia. Muat ulang sebelum menutup pemilihan.</p>}
    {closingProgress?.eligible === 0 && <p class="feedback" data-tone="warning">Penutupan memerlukan daftar pemilih yang sah. Periksa data pemilih terlebih dahulu.</p>}
    <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">Penutupan mengakhiri seluruh hak pilih yang tersisa dan mencabut sesi pemilih. Suara yang sudah tercatat tetap sah; pemilih absen tetap terdaftar tanpa suara tambahan. Periode tidak dapat dibuka kembali. Jadwal asli tetap tersimpan dan publikasi hasil dilakukan terpisah.</p>
    <form id="close-period-form" method="post" class="close-form" data-early={earlyClose ? 'true' : 'false'} data-ready={closeReady ? 'true' : 'false'} data-summary={closingProgress ? `${closingProgress.complete} lengkap, ${closingProgress.partial} parsial, ${closingProgress.notStarted} belum mulai` : ''}>
      {earlyClose && <label class="close-reason">Alasan penutupan lebih awal
        <textarea name="reason" rows="3" minlength="10" maxlength="500" required disabled={!closeReady} aria-describedby="close-reason-hint"></textarea>
        <small id="close-reason-hint">10–500 karakter. Tulis alasan keputusan panitia; alasan akan tercatat pada audit.</small>
      </label>}
      <label>Kata sandi admin<input name="adminPassword" type="password" autocomplete="current-password" required maxlength="256" disabled={!closeReady}/></label>
      <button class="btn btn-primary" type="submit" disabled>{earlyClose ? 'Tutup lebih awal dan rekonsiliasi' : 'Tutup dan rekonsiliasi'}</button>
    </form>
    <p id="close-period-message" class="feedback" role="status" aria-live="polite" hidden></p>
  </section>}
  {period.state === 'SCHEDULED' && !period.extensionUsedAt && Date.now() >= period.opensAt.getTime() && Date.now() < period.closesAt.getTime() && canExtendPeriod && <section class="card" style="margin-bottom:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:5px">Perpanjang waktu pemilihan</h3>
    <p style="font-size:13px;color:var(--color-muted);margin-bottom:12px">Dapat digunakan satu kali untuk menambah 60 menit. Siswa yang sesinya berakhir pada tenggat lama dapat masuk kembali dengan PIN yang sama.</p>
    <form id="extend-period-form" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
      <label style="display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:700">Kode alasan<input name="reasonCode" required maxlength="64" pattern="[A-Z][A-Z0-9_]{1,63}" placeholder="TECHNICAL_DISRUPTION"/></label>
      <label style="display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:700">Kata sandi admin<input name="adminPassword" type="password" autocomplete="current-password" required maxlength="256"/></label>
      <button class="btn btn-outline" type="submit">Tambah 60 menit</button>
    </form>
  </section>}
  <section class="card">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:10px">Organisasi</h3>
    <div style="display:grid;gap:8px">
      {period.contests.map((contest) => <div style="display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--color-border,#e5e7eb);padding:8px 0;font-size:13px"><span>{contest.organization.replace('_', ' ')}</span><span>{contest._count.candidates} pasangan</span></div>)}
    </div>
    <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">{canManageCandidates && <a class="btn btn-outline" href={`/admin/e-voting/${period.id}/calon`}>Kelola calon</a>}{canManageRoster && <a class="btn btn-outline" href={`/admin/e-voting/${period.id}/pemilih`}>Kelola Pemilih</a>}{canManagePins && <a class="btn btn-outline" href={`/admin/e-voting/${period.id}/pin`}>Terbitkan PIN</a>}{canViewParticipation && <a class="btn btn-outline" href={`/admin/e-voting/${period.id}/partisipasi`}>Partisipasi</a>}</div>
  </section>
  <p style="font-size:12px;color:var(--color-muted);margin-top:14px">Periode terjadwal akan terbuka otomatis pada waktu mulai yang ditentukan.</p>
  {period.isTest && canDeleteTestPeriod(principal) && <TestPeriodCleanup periodId={id} name={period.name} slug={period.slug}/>}
</AdminLayout>

<style>
  .preflight.readiness-panel{padding:24px;border:1px solid #e8d6ae;border-top:4px solid #c69330;border-radius:16px;background:white;box-shadow:0 4px 18px #17392b08}
  .preflight.readiness-panel[data-ready=true]{border-color:#b9d9c5;border-top-color:#1b7a3d}
  .readiness-heading{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
  .readiness-eyebrow{font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--color-muted);margin:0 0 6px}
  .readiness-heading h3{font-size:18px;font-weight:800;margin:0;color:var(--color-ink)}
  .readiness-count{font-size:12px;color:var(--color-muted);margin:8px 0 0}.readiness-count strong{color:var(--color-ink)}
  .readiness-progress{display:block;width:100%;height:7px;margin:18px 0;border:0;border-radius:99px;overflow:hidden;background:#eaf0ec;accent-color:#1b7a3d}
  .readiness-progress::-webkit-progress-bar{background:#eaf0ec;border-radius:99px}.readiness-progress::-webkit-progress-value{background:#1b7a3d;border-radius:99px}.readiness-progress::-moz-progress-bar{background:#1b7a3d;border-radius:99px}
  .preflight .readiness-checks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:0;margin:0;list-style:none}
  .readiness-item{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:16px;border:1px solid #e8d4aa;border-left:3px solid #c69330;border-radius:12px;background:#fffaf0}
  .readiness-item[data-ready=true]{border-color:#cce4d5;border-left-color:#1b7a3d;background:#f2faf5}
  .readiness-icon{display:grid;place-items:center;flex:none;width:32px;height:32px;border-radius:50%;background:#ffedc3;color:#875f0c;font-size:18px;font-weight:800;line-height:1}
  .readiness-item[data-ready=true] .readiness-icon{background:#1b7a3d;color:white}
  .readiness-content{min-width:0;flex:1}.readiness-item-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
  .readiness-item h4{font-size:13px;line-height:1.5;color:var(--color-ink);margin:0;font-weight:800}
  .readiness-item p{font-size:12px;line-height:1.7;color:var(--color-muted-strong);margin:8px 0 0;overflow-wrap:anywhere}
  .readiness-note{display:flex;align-items:flex-start;gap:8px;border-top:1px solid var(--color-line);padding-top:14px;margin:18px 0 0;color:var(--color-muted);font-size:11px;line-height:1.7}.readiness-note>span{font-size:15px;line-height:1.25;flex:none}
  @media(max-width:760px){.preflight.readiness-panel{padding:18px}.preflight .readiness-checks{grid-template-columns:minmax(0,1fr)}.readiness-item{padding:14px}.readiness-heading h3{font-size:17px}}
  .publish-form{display:flex;gap:12px;align-items:end;flex-wrap:wrap}
  .publish-form label{display:flex;flex:1 1 220px;flex-direction:column;gap:6px;font-size:13px;font-weight:700;min-width:0}
  .publish-form button{white-space:normal}
  .closing-summary{margin:14px 0;padding:14px;border-radius:10px;background:var(--color-paper)}
  .closing-summary p{font-size:12px;color:var(--color-muted);line-height:1.6}
  .closing-summary dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:12px 0}
  .closing-summary dt{font-size:12px;color:var(--color-muted)}
  .closing-summary dd{font-size:24px;font-weight:800;margin:4px 0}
  .close-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:end}
  .close-form label{display:flex;flex-direction:column;gap:6px;min-width:0;font-size:13px;font-weight:700}
  .close-form .close-reason{grid-column:1/-1}
  .close-form small{font-size:12px;color:var(--color-muted);font-weight:400}
  @media(max-width:600px){.close-form{grid-template-columns:minmax(0,1fr)}.close-form button{white-space:normal}}
  .period-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .period-form label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:700}
  @media(max-width:800px){.period-form{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:480px){.period-form{grid-template-columns:1fr}}
</style>

<script>
  import { confirmAction } from '../../../../lib/ui/confirm';
  const contestsForm=document.querySelector<HTMLFormElement>('#period-contests-form');
  contestsForm?.addEventListener('submit',async event=>{
    event.preventDefault();
    const picker=contestsForm.querySelector<HTMLFieldSetElement>('[data-contest-picker]')!;
    const message=contestsForm.querySelector<HTMLElement>('#period-contests-message')!;
    const submit=contestsForm.querySelector<HTMLButtonElement>('[type=submit]')!;
    if(submit.disabled||picker.dataset.ready!=='true')return;
    const organizations=new FormData(contestsForm).getAll('organizations');
    if(organizations.length<1||organizations.length>20)return;
    submit.disabled=true;
    if(!await confirmAction('Simpan susunan '+organizations.length+' surat suara? Hak pemilih akan disesuaikan. Jenis yang masih berisi calon tidak dapat dilepas.')){submit.disabled=false;return;}
    try{
      const response=await fetch('/api/admin/e-voting/'+contestsForm.dataset.periodId+'/contests',{method:'PUT',credentials:'same-origin',headers:{'Content-Type':'application/json','X-CSRF-Token':picker.dataset.csrf!},
        body:JSON.stringify({organizations,expectedRevision:Number(contestsForm.dataset.revision)})});
      if(!response.ok){
        const result=await response.json().catch(()=>null);
        const labels:Record<string,string>={STALE_CONFIG:'Susunan sudah berubah. Muat ulang halaman sebelum menyimpan lagi.',INVALID_STATE:'Susunan terkunci karena periode sudah dijadwalkan. Muat ulang halaman.',CONTEST_HAS_CANDIDATES:'Jenis masih berisi calon. Hapus calonnya lewat Kelola calon sebelum melepas jenis.',TYPE_INACTIVE:'Jenis sudah dinonaktifkan. Muat ulang pilihan jenis.',CSRF_REJECTED:'Sesi keamanan berakhir. Muat ulang halaman.'};
        message.textContent=labels[result?.error?.code]??'Susunan belum dapat disimpan. Muat ulang untuk memeriksa data terbaru.';message.hidden=false;
        if(!['STALE_CONFIG','INVALID_STATE'].includes(result?.error?.code))submit.disabled=false;
        return;
      }
      location.reload();
    }catch{message.textContent='Koneksi terputus. Muat ulang untuk memeriksa apakah susunan sudah tersimpan.';message.hidden=false;}
  });
</script>

<script>
  const form = document.querySelector<HTMLFormElement>('#period-config-form');
  if (form) {
    const message = document.querySelector<HTMLElement>('#period-message')!;
    const expected = JSON.parse(form.dataset.expected!) as { name: string; academicYear: string; opensAt: string; closesAt: string };
    const periodId = location.pathname.split('/')[3];
    let csrf = '';
    fetch(`/api/admin/e-voting/${periodId}`).then((response) => { csrf = response.headers.get('x-csrf-token') ?? ''; }).catch(() => {});
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!csrf) { message.textContent = 'Sesi keamanan belum siap. Muat ulang halaman lalu coba lagi.'; message.style.display = 'block'; return; }
      const values = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const asWib = (value: string) => new Date(`${value}:00+07:00`).toISOString();
      const input = { name: values.name, academicYear: values.academicYear, opensAt: asWib(values.opensAt), closesAt: asWib(values.closesAt) };
      try {
        const response = await fetch(`/api/admin/e-voting/${periodId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify({ input, expected }) });
        if (!response.ok) {
          const result = await response.json().catch(() => null);
          message.textContent = result?.error?.code === 'STALE_CONFIG' ? 'Konfigurasi berubah di sesi lain. Muat ulang sebelum mengedit.' : result?.error?.code === 'INVALID_STATE' ? 'Periode sudah dibuka atau ditutup.' : 'Konfigurasi gagal disimpan. Periksa jadwal dan coba lagi.';
          message.style.display = 'block'; message.style.background = '#fff1f0'; message.style.color = '#991b1b'; return;
        }
        location.reload();
      } catch { message.textContent = 'Koneksi terputus. Periksa koneksi lalu coba lagi.'; message.style.display = 'block'; }
    });
  }
</script>

