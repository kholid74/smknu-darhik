<script>
  import { confirmAction } from '../../../../lib/ui/confirm';
  const publishForm = document.querySelector<HTMLFormElement>('#publish-period-form');
  if (publishForm) {
    const message = document.querySelector<HTMLElement>('#publish-period-message')!;
    const button = publishForm.querySelector<HTMLButtonElement>('button')!;
    const password = publishForm.elements.namedItem('adminPassword') as HTMLInputElement;
    const showError = (text: string) => { message.textContent = text; message.hidden = false; message.dataset.tone = 'error'; };
    const periodId = location.pathname.split('/')[3];
    let csrf = '';
    fetch(`/api/admin/e-voting/${periodId}`).then((response) => {
      if (!response.ok) throw new Error();
      csrf = response.headers.get('x-csrf-token') ?? '';
      if (!csrf) throw new Error();
      button.disabled = false;
    }).catch(() => showError('Sesi keamanan belum siap. Muat ulang halaman sebelum memublikasikan hasil.'));
    publishForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled || !csrf) return;
      button.disabled = true;
      message.hidden = true;
      try {
        if (!await confirmAction('Publikasikan hasil pemilihan untuk umum? Publikasi tidak dapat ditarik kembali.')) return;
        const response = await fetch(`/api/admin/e-voting/${periodId}/publish`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify({ adminPassword: password.value }) });
        if (!response.ok) {
          const result = await response.json().catch(() => null);
          const labels: Record<string, string> = {
            INVALID_REAUTH: 'Kata sandi admin tidak valid.',
            RATE_LIMITED: 'Terlalu banyak percobaan autentikasi ulang. Coba kembali nanti.',
            INVALID_STATE: 'Status periode sudah berubah. Muat ulang untuk memeriksa publikasi.',
            FORBIDDEN: 'Akun ini tidak memiliki izin publikasi.',
            CSRF_REJECTED: 'Sesi keamanan berakhir. Muat ulang halaman.',
          };
          showError(labels[result?.error?.code] ?? 'Hasil belum dapat dipublikasikan. Muat ulang untuk memeriksa status.');
          return;
        }
        location.reload();
      } catch { showError('Koneksi terputus. Periksa status publikasi sebelum mencoba kembali.'); }
      finally { password.value = ''; button.disabled = false; }
    });
  }
</script>

<script>
  import { confirmAction } from '../../../../lib/ui/confirm';
  const closeForm = document.querySelector<HTMLFormElement>('#close-period-form');
  if (closeForm) {
    const early = closeForm.dataset.early === 'true';
    const message = document.querySelector<HTMLElement>('#close-period-message')!;
    const button = closeForm.querySelector<HTMLButtonElement>('button')!;
    const password = closeForm.elements.namedItem('adminPassword') as HTMLInputElement;
    const reasonField = closeForm.elements.namedItem('reason') as HTMLTextAreaElement | null;
    const periodId = location.pathname.split('/')[3];
    let csrf = '';
    const showError = (text: string) => { message.textContent = text; message.hidden = false; message.dataset.tone = 'error'; };
    fetch('/api/admin/e-voting/' + periodId).then(response => {
      if (!response.ok) throw new Error();
      csrf = response.headers.get('x-csrf-token') ?? '';
      if (!csrf) throw new Error();
      button.disabled = closeForm.dataset.ready !== 'true';
    }).catch(() => showError('Sesi keamanan belum siap. Muat ulang halaman sebelum menutup pemilihan.'));
    closeForm.addEventListener('submit', async event => {
      event.preventDefault();
      if (button.disabled || !csrf) return;
      const reason = reasonField?.value.trim();
      if (early && (!reason || reason.length < 10 || reason.length > 500)) {
        password.value = '';
        showError('Isi alasan penutupan lebih awal sepanjang 10–500 karakter.');
        reasonField?.focus();
        return;
      }
      button.disabled = true;
      message.hidden = true;
      try {
        const summary = closeForm.dataset.summary ?? '';
        if (!await confirmAction((early ? 'Tutup pemilihan lebih awal?' : 'Tutup pemilihan?') +
          ' Ringkasan saat halaman dimuat: ' + summary +
          '. Seluruh hak pilih tersisa berakhir dan sesi pemilih dicabut. Suara yang sudah tercatat tetap sah. Periode tidak dapat dibuka kembali; hasil belum dipublikasikan. Server memeriksa data terbaru.')) return;
        const response = await fetch('/api/admin/e-voting/' + periodId + '/close', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
          body: JSON.stringify({ adminPassword: password.value, early, ...(reason === undefined ? {} : { reason }) }),
        });
        if (!response.ok) {
          const result = await response.json().catch(() => null);
          const labels: Record<string, string> = {
            RECONCILIATION_FAILED: 'Rekonsiliasi tidak cocok. Periode tidak ditutup; minta pemeriksaan teknis.',
            BEFORE_DEADLINE: 'Periode belum dibuka atau penutupan lebih awal belum dikonfirmasi. Muat ulang halaman.',
            INVALID_REAUTH: 'Kata sandi admin tidak valid.',
            RATE_LIMITED: 'Terlalu banyak percobaan autentikasi ulang. Coba kembali nanti.',
            INVALID_INPUT: 'Periksa alasan penutupan dan kata sandi admin.',
            CSRF_REJECTED: 'Sesi keamanan berakhir. Muat ulang halaman.',
            FORBIDDEN: 'Akun ini tidak memiliki izin penutupan.',
            INVALID_STATE: 'Status periode sudah berubah. Muat ulang untuk memeriksa penutupan.',
          };
          showError(labels[result?.error?.code] ?? 'Penutupan belum dapat dipastikan. Muat ulang untuk memeriksa status periode.');
          return;
        }
        location.reload();
      } catch { showError('Koneksi terputus. Periksa status periode sebelum mencoba kembali.'); }
      finally { password.value = ''; button.disabled = false; }
    });
  }
</script>

