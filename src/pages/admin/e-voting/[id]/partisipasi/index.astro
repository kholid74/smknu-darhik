---
export const prerender = false;
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { can } from '../../../../../lib/rbac';
import { getParticipation, getParticipationVoters } from '../../../../../lib/voting/participation';

const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.redirect('/admin/e-voting');
const principal = Astro.locals.principal;
if (!principal || !can(principal, 'evoting.partisipasi')) return Astro.redirect('/admin?forbidden=1');
const data = await getParticipation(id);
if (!data) return Astro.redirect('/admin/e-voting');
const canViewVoters = can(principal, 'evoting.pemilih');
const voterPage = canViewVoters ? await getParticipationVoters(id, null, 50) : null;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const labels: Record<string, string> = { OSIS: 'OSIS', DEWAN_AMBALAN: 'Dewan Ambalan', IPNU: 'IPNU', IPPNU: 'IPPNU' };
const percent = (n: number, d: number) => d ? Math.round(n * 100 / d) : 0;
---

<AdminLayout title="Partisipasi Pemilihan" user={{ role: Astro.locals.session?.role ?? '' }}>
  <a href={`/admin/e-voting/${id}`} style="display:inline-flex;margin-bottom:14px;text-decoration:none;font-size:13px">← Konfigurasi periode</a>
  <div style="margin-bottom:18px"><h2 style="font-size:20px;font-weight:800">Partisipasi Pemilih</h2><p style="font-size:13px;color:var(--color-muted);margin-top:4px">{data.period.name} · {data.period.academicYear} · {data.period.state}</p></div>
  <section aria-label="Ringkasan keseluruhan" class="summary">
    <article class="card stat"><strong>{data.eligible}</strong><span>Pemilih terdaftar</span></article>
    <article class="card stat"><strong>{data.complete}</strong><span>Memilih lengkap</span></article>
    <article class="card stat"><strong>{data.partial}</strong><span>Memilih sebagian</span></article>
    <article class="card stat"><strong>{data.notStarted}</strong><span>Belum mulai</span></article>
  </section>
  <section class="card">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:16px">Per organisasi</h3>
    <div style="display:grid;gap:18px">
      {data.byOrganization.map((row) => <div>
        <div class="row-head"><strong>{labels[row.organization] ?? row.organization}</strong><span>{row.voted} / {row.eligible} suara masuk</span></div>
        <progress aria-label={`Partisipasi ${labels[row.organization] ?? row.organization}`} value={row.voted} max={Math.max(1, row.eligible)}></progress>
        <p style="font-size:12px;color:var(--color-muted);margin-top:4px">{percent(row.voted, row.eligible)}% berpartisipasi · {row.pending} belum memilih</p>
      </div>)}
    </div>
    {data.byOrganization.length === 0 && <p style="color:var(--color-muted)">Belum ada data organisasi.</p>}
  </section>
  {canViewVoters && voterPage && <section class="card" style="margin-top:18px">
    <h3 style="font-size:16px;font-weight:800;margin-bottom:6px">Status pemilih</h3>
    <p style="font-size:12px;color:var(--color-muted);margin-bottom:12px">Hanya tersedia bagi pemegang izin partisipasi dan pemilih. Pilihan kandidat dan waktu suara tidak ditampilkan.</p>
    <div class="table-wrap"><table id="voter-status-table"><thead><tr><th>NISN</th><th>Nama</th><th>Kelas</th><th>OSIS</th><th>Dewan Ambalan</th><th>IPNU</th><th>IPPNU</th></tr></thead><tbody>
      {voterPage.data.map((voter) => <tr><td>{voter.nisn}</td><td>{voter.name}</td><td>{voter.className}</td><td>{voter.participation.OSIS ? 'Sudah' : 'Belum'}</td><td>{voter.participation.DEWAN_AMBALAN ? 'Sudah' : 'Belum'}</td><td>{voter.participation.IPNU ? 'Sudah' : 'Belum'}</td><td>{voter.participation.IPPNU ? 'Sudah' : 'Belum'}</td></tr>)}
    </tbody></table></div>
    {voterPage.data.length === 0 && <p style="color:var(--color-muted)">Roster belum tersedia.</p>}
    <button id="more-voters" class="btn btn-outline" type="button" data-cursor={voterPage.nextCursor ?? ''} hidden={!voterPage.nextCursor}>Muat berikutnya</button>
    <p id="voter-status-message" role="status" aria-live="polite" style="font-size:12px;margin-top:8px"></p>
  </section>}
  <p style="font-size:12px;color:var(--color-muted);margin-top:12px">Laporan ini hanya menampilkan agregat. Tidak ada nama siswa atau pilihan kandidat.</p>
</AdminLayout>

<style>
  .summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:18px}.stat{display:flex;flex-direction:column;gap:5px}.stat strong{font-size:22px}.stat span{font-size:12px;color:var(--color-muted)}.row-head{display:flex;justify-content:space-between;gap:10px;font-size:13px;margin-bottom:7px}progress{width:100%;height:12px;accent-color:#17643f}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:9px;border-bottom:1px solid var(--color-border,#e5e7eb);white-space:nowrap}th{font-weight:800}@media(max-width:650px){.summary{grid-template-columns:repeat(2,minmax(0,1fr))}.row-head{flex-direction:column;gap:3px}}
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('#more-voters');
  const tableBody = document.querySelector<HTMLTableSectionElement>('#voter-status-table tbody');
  const message = document.querySelector<HTMLElement>('#voter-status-message');
  const periodId = location.pathname.split('/')[3];
  const organizations = ['OSIS', 'DEWAN_AMBALAN', 'IPNU', 'IPPNU'];
  button?.addEventListener('click', async () => {
    button.disabled = true;
    try {
      const url = new URL(`/api/admin/e-voting/${periodId}/participation/voters`, location.origin);
      url.searchParams.set('limit', '50'); url.searchParams.set('cursor', button.dataset.cursor ?? '');
      const response = await fetch(url, { cache: 'no-store' });
      const result = await response.json();
      if (!response.ok) throw new Error('Daftar status tidak dapat dimuat.');
      for (const voter of result.data.data) {
        const row = document.createElement('tr');
        for (const value of [voter.nisn, voter.name, voter.className, ...organizations.map((organization) => voter.participation[organization] ? 'Sudah' : 'Belum')]) {
          const cell = document.createElement('td'); cell.textContent = value; row.append(cell);
        }
        tableBody?.append(row);
      }
      button.dataset.cursor = result.data.nextCursor ?? '';
      button.hidden = !result.data.nextCursor;
      if (message) message.textContent = '';
    } catch (error) { if (message) message.textContent = error instanceof Error ? error.message : 'Gagal memuat daftar.'; }
    finally { button.disabled = false; }
  });
</script>
