---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SortTh from '../../../components/SortTh.astro';
import { tableSort } from '../../../lib/tablesort';
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const page = parseInt(url.searchParams.get('page') || '1');
const limit = 15;

const where: any = {};
if (search) where.question = { contains: search };

const s = tableSort(url, { pertanyaan: 'question', urutan: 'order' }, [{ order: 'asc' }]);

const [faqs, total] = await Promise.all([
  db.faq.findMany({ where, orderBy: s.orderBy, skip: (page - 1) * limit, take: limit }),
  db.faq.count({ where }),
]);

const totalPages = Math.ceil(total / limit);
---

<AdminLayout title="FAQ" user={{ role: session.role }}>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <div style="display:flex;gap:10px;align-items:center">
      <form method="GET" style="display:flex;gap:8px">
        <input type="text" name="q" value={search} placeholder="Cari pertanyaan..." style="width:280px"/>
        <button type="submit" class="btn btn-outline" style="padding:10px 14px">Cari</button>
      </form>
    </div>
    <a href="/admin/faq/new" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Tambah FAQ</a>
  </div>

  <div class="card" style="padding:0">
    <table>
      <thead>
        <tr>
          <SortTh label="#" href={s.sortLink('urutan')} active={s.sort === 'urutan'} icon={s.sortIcon('urutan')} width="5%" />
          <SortTh label="Pertanyaan" href={s.sortLink('pertanyaan')} active={s.sort === 'pertanyaan'} icon={s.sortIcon('pertanyaan')} width="35%" />
          <th>Jawaban</th>
          <th style="width:80px"></th>
        </tr>
      </thead>
      <tbody>
        {faqs.length === 0 ? (
          <tr><td colspan="4" style="text-align:center;padding:40px;color:#6f7a6e">Belum ada FAQ.</td></tr>
        ) : faqs.map((f, i) => (
          <tr>
            <td style="text-align:center;color:#6f7a6e;font-size:12px">{f.order}</td>
            <td style="font-weight:600">{f.question}</td>
            <td style="font-size:12px;color:#6f7a6e;max-width:350px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{f.answer}</td>
            <td>
              <div style="display:flex;gap:4px">
                <a href={`/admin/faq/${f.id}`} class="btn btn-outline" style="padding:6px 10px;font-size:11px"><span class="material-symbols-outlined" style="font-size:16px">edit</span></a>
                <form method="POST" action="/admin/faq/delete" style="display:inline">
                  <input type="hidden" name="id" value={f.id}/>
                  <button type="submit" class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#dc2626"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {totalPages > 1 && (
    <div style="display:flex;justify-content:center;gap:6px;margin-top:20px">
      {Array.from({length: totalPages}, (_, i) => i + 1).map(p => (
        <a href={s.mkQs({ page: p })} class={`btn ${p === page ? 'btn-primary' : 'btn-outline'}`} style="padding:8px 14px;font-size:13px">{p}</a>
      ))}
    </div>
  )}

  <p style="font-size:12px;color:#6f7a6e;margin-top:12px">Total: {total} FAQ</p>
</AdminLayout>
