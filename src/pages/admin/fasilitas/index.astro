---
export const prerender = false;
import DataTable from '../../../components/ui/DataTable.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import {pageOptions} from '../../../lib/ui/table-state';
import PageHeader from '../../../components/ui/PageHeader.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SortTh from '../../../components/SortTh.astro';
import { tableSort } from '../../../lib/tablesort';
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const {page,size:limit}=pageOptions(url.searchParams);

const where: any = {};
if (search) where.name = { contains: search };

const s = tableSort(url, { nama: 'name', urutan: 'order' }, [{ order: 'asc' }]);

const [facilities, total] = await Promise.all([
  db.facility.findMany({ where, orderBy: s.orderBy, skip: (page - 1) * limit, take: limit }),
  db.facility.count({ where }),
]);

const totalPages = Math.max(1,Math.ceil(total / limit));
if(page>totalPages){url.searchParams.set('page',String(totalPages));return Astro.redirect(url.pathname+url.search)}
---

<AdminLayout title="Fasilitas" user={{ role: session.role }}>
  <PageHeader title="Fasilitas"/>
  <div class="list-toolbar">
      <form method="GET" class="table-toolbar">
        <label>Cari fasilitas<input type="search" name="q" value={search} placeholder="Cari nama fasilitas..."/></label>
        <label>Per halaman<select name="size">{[10,25,50].map(size=><option value={size} selected={size===limit}>{size}</option>)}</select></label>
        <input type="hidden" name="sort" value={url.searchParams.get('sort')??''}/><input type="hidden" name="dir" value={url.searchParams.get('dir')??''}/>
        <button type="submit" class="btn btn-outline">Cari</button>
      </form>
    <a href="/admin/fasilitas/new" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Tambah Fasilitas</a>
  </div>

  <div class="card" style="padding:0">
    <DataTable id="server-fasilitas" label="fasilitas" mode="server"><table>
      <thead>
        <tr>
          <SortTh label="#" href={s.sortLink('urutan')} active={s.sort === 'urutan'} icon={s.sortIcon('urutan')} width="5%" />
          <SortTh label="Nama" href={s.sortLink('nama')} active={s.sort === 'nama'} icon={s.sortIcon('nama')} width="30%" />
          <th>Deskripsi</th>
          <th>Icon</th>
          <th style="width:80px"></th>
        </tr>
      </thead>
      <tbody>
        {facilities.length === 0 ? (
          <tr><td colspan="5" style="text-align:center;padding:40px;color:#6f7a6e">Belum ada fasilitas.</td></tr>
        ) : facilities.map(f => (
          <tr>
            <td style="text-align:center;color:#6f7a6e;font-size:12px">{f.order}</td>
            <td style="font-weight:600">{f.name}</td>
            <td style="font-size:12px;color:#6f7a6e;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{f.description || '-'}</td>
            <td>
              {f.icon ? <span class="material-symbols-outlined" style="font-size:18px;color:#6f7a6e">{f.icon}</span> : <span style="color:#ccc">-</span>}
            </td>
            <td>
              <div style="display:flex;gap:4px">
                <a href={`/admin/fasilitas/${f.id}`} class="btn btn-outline" style="padding:6px 10px;font-size:11px"><span class="material-symbols-outlined" style="font-size:16px">edit</span></a>
                <form method="POST" action="/admin/fasilitas/delete" style="display:inline">
                  <input type="hidden" name="id" value={f.id}/>
                  <button type="submit" class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#dc2626"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table></DataTable>
  </div>

  <Pagination page={page} pageCount={totalPages} total={total} size={limit} url={url}/>

  <p style="font-size:12px;color:#6f7a6e;margin-top:12px">Total: {total} fasilitas</p>
</AdminLayout>
