---
export const prerender = false;
import DataTable from '../../../components/ui/DataTable.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import {pageOptions} from '../../../lib/ui/table-state';
import PageHeader from '../../../components/ui/PageHeader.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SortTh from '../../../components/SortTh.astro';
import { tableSort } from '../../../lib/tablesort';
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const filter = url.searchParams.get('filter') || '';
const {page,size:limit}=pageOptions(url.searchParams);

const where: any = {};
if (search) where.title = { contains: search };
if (filter) where.category = filter;

const s = tableSort(url, { judul: 'title', kategori: 'category', status: 'published', tanggal: 'createdAt' }, [{ createdAt: 'desc' }]);

const [articles, total] = await Promise.all([
  db.article.findMany({ where, orderBy: s.orderBy, skip: (page - 1) * limit, take: limit }),
  db.article.count({ where }),
]);

const totalPages = Math.max(1,Math.ceil(total / limit));
if(page>totalPages){url.searchParams.set('page',String(totalPages));return Astro.redirect(url.pathname+url.search)}

// Antrean usulan guru menunggu tinjauan (pending). Ditampilkan di atas daftar.
const pending = await db.article.findMany({
  where: { reviewStatus: 'pending' },
  orderBy: { updatedAt: 'asc' },
  include: { author: { select: { email: true, username: true, teacher: { select: { name: true } } } } },
});
const reviewedNotice = url.searchParams.get('reviewed');

const catBadge: Record<string, string> = {
  Prestasi: 'badge-green',
  Keagamaan: 'badge-gold',
  Akademik: 'badge-green',
  Ekstrakurikuler: 'badge-gold',
  PPDB: 'badge-green',
};
---

<AdminLayout title="Artikel" user={{ role: session.role }}>
  <PageHeader title="Artikel"/>
  {reviewedNotice && (
    <div style="background:#f0f7f1;border:1px solid #cfe6d4;color:#1B7A3D;font-size:13px;border-radius:10px;padding:10px 14px;margin-bottom:16px">
      {reviewedNotice === 'approved' ? 'Usulan disetujui dan ditayangkan.' : 'Usulan ditolak. Pengusul dapat merevisi.'}
    </div>
  )}

  {pending.length > 0 && (
    <div class="card" style="margin-bottom:20px;border:1px solid #f5d9a8;background:#fffdf7">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
        <span class="material-symbols-outlined" style="color:#C8963E">inbox</span>
        <h3 style="font-size:15px;font-weight:800;margin:0">Usulan menunggu tinjauan</h3>
        <span class="badge badge-gold">{pending.length}</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        {pending.map((a) => (
          <div style="display:flex;align-items:center;gap:12px;padding:10px 12px;background:white;border:1px solid rgba(0,0,0,.06);border-radius:10px;flex-wrap:wrap">
            <div style="flex:1;min-width:200px">
              <div style="font-weight:700;font-size:14px">{a.title}</div>
              <div style="font-size:12px;color:var(--color-muted)">
                <span class="badge badge-gray" style="margin-right:6px">{a.category}</span>
                oleh {a.author?.teacher?.name || a.author?.username || a.author?.email || 'tidak diketahui'}
                · {new Date(a.updatedAt).toLocaleDateString('id-ID', { day: '2-digit', month: 'short' })}
              </div>
            </div>
            <a href={`/admin/artikel/${a.id}`} class="btn btn-outline" style="padding:6px 10px;font-size:11px" title="Pratinjau"><span class="material-symbols-outlined" style="font-size:16px">visibility</span> Lihat</a>
            <form method="POST" action="/admin/artikel/review" style="margin:0">
              <input type="hidden" name="id" value={a.id}/>
              <input type="hidden" name="action" value="approve"/>
              <button type="submit" class="btn btn-primary" style="padding:6px 12px;font-size:11px"><span class="material-symbols-outlined" style="font-size:16px">check</span> Setujui</button>
            </form>
            <button type="button" class="btn btn-outline reject-btn" data-id={a.id} data-title={a.title} style="padding:6px 12px;font-size:11px;color:#dc2626"><span class="material-symbols-outlined" style="font-size:16px">close</span> Tolak</button>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="list-toolbar">
      <form method="GET" class="table-toolbar">
        <label>Cari artikel<input type="search" name="q" value={search} placeholder="Cari judul..."/></label>
        <label>Per halaman<select name="size">{[10,25,50].map(size=><option value={size} selected={size===limit}>{size}</option>)}</select></label>
        <input type="hidden" name="sort" value={url.searchParams.get('sort')??''}/><input type="hidden" name="dir" value={url.searchParams.get('dir')??''}/>
        <label>Kategori<select name="filter" onchange="this.form.submit()">
          <option value="">Semua Kategori</option>
          {['Prestasi','Keagamaan','Akademik','Ekstrakurikuler','PPDB'].map(c => (
            <option value={c} selected={filter === c}>{c}</option>
          ))}
        </select></label>
        <button type="submit" class="btn btn-outline">Cari</button>
      </form>
    <a href="/admin/artikel/new" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Tulis Artikel</a>
  </div>

  <div class="card" style="padding:0">
    <DataTable id="server-artikel" label="artikel" mode="server"><table>
      <thead>
        <tr>
          <SortTh label="Judul" href={s.sortLink('judul')} active={s.sort === 'judul'} icon={s.sortIcon('judul')} width="45%" />
          <SortTh label="Kategori" href={s.sortLink('kategori')} active={s.sort === 'kategori'} icon={s.sortIcon('kategori')} />
          <SortTh label="Status" href={s.sortLink('status')} active={s.sort === 'status'} icon={s.sortIcon('status')} />
          <SortTh label="Tanggal" href={s.sortLink('tanggal')} active={s.sort === 'tanggal'} icon={s.sortIcon('tanggal')} />
          <th style="width:120px"></th>
        </tr>
      </thead>
      <tbody>
        {articles.length === 0 ? (
          <tr><td colspan="5" style="text-align:center;padding:40px;color:#6f7a6e">Belum ada artikel.</td></tr>
        ) : articles.map(a => (
          <tr>
            <td style="font-weight:600">{a.title}
              {a.featured && <span class="badge badge-gold" style="margin-left:6px">Featured</span>}
            </td>
            <td><span class={`badge ${catBadge[a.category] || 'badge-gray'}`}>{a.category}</span></td>
            <td><span class={`badge ${a.published ? 'badge-green' : 'badge-gray'}`}>{a.published ? 'Publish' : 'Draft'}</span></td>
            <td style="font-size:12px;color:#6f7a6e">{new Date(a.createdAt).toLocaleDateString('id')}</td>
            <td>
              <div style="display:flex;gap:4px">
                <a href={`/admin/artikel/${a.id}`} class="btn btn-outline" style="padding:6px 10px;font-size:11px" title="Edit"><span class="material-symbols-outlined" style="font-size:16px">edit</span></a>
                <form method="POST" action="/admin/artikel/clone" style="display:inline">
                  <input type="hidden" name="id" value={a.id}/>
                  <button type="submit" class="btn btn-outline" style="padding:6px 10px;font-size:11px" title="Duplikat artikel"><span class="material-symbols-outlined" style="font-size:16px">content_copy</span></button>
                </form>
                <form method="POST" action="/admin/artikel/delete" style="display:inline">
                  <input type="hidden" name="id" value={a.id}/>
                  <button type="submit" class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#dc2626"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table></DataTable>
  </div>

  <Pagination page={page} pageCount={totalPages} total={total} size={limit} url={url}/>

  <p style="font-size:12px;color:#6f7a6e;margin-top:12px">Total: {total} artikel</p>

  <!-- Modal tolak usulan (isi catatan alasan) -->
  <dialog id="reject-modal" class="ui-dialog" aria-labelledby="reject-title">
      <h2>Tolak usulan</h2><p id="reject-title"></p>
      <form method="POST" action="/admin/artikel/review">
        <input type="hidden" name="id" id="reject-id"/>
        <input type="hidden" name="action" value="reject"/>
        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">Catatan untuk pengusul *</label>
        <textarea name="note" rows="3" required placeholder="Alasan penolakan / yang perlu diperbaiki..." style="resize:vertical;margin-bottom:16px"></textarea>
        <div style="display:flex;gap:10px;justify-content:flex-end">
          <button type="button" class="btn btn-outline" id="reject-cancel">Batal</button>
          <button type="submit" class="btn btn-primary" style="background:#dc2626"><span class="material-symbols-outlined" style="font-size:16px">close</span> Tolak</button>
        </div>
      </form>
  </dialog>

  <script>
    const modal = document.querySelector<HTMLDialogElement>('#reject-modal')!;
    document.querySelectorAll<HTMLButtonElement>('.reject-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        (document.getElementById('reject-id') as HTMLInputElement).value = btn.dataset.id || '';
        document.getElementById('reject-title')!.textContent = btn.dataset.title || '';
        modal.showModal();
      });
    });
    document.getElementById('reject-cancel')!.addEventListener('click', () => { modal.close(); });
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  </script>
</AdminLayout>
