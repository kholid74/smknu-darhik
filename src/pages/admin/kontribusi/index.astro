---
export const prerender = false;
import DataTable from '../../../components/ui/DataTable.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import {pageOptions} from '../../../lib/ui/table-state';
import PageHeader from '../../../components/ui/PageHeader.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SortTh from '../../../components/SortTh.astro';
import { tableSort } from '../../../lib/tablesort';
import { verifyToken } from '../../../lib/auth';
import { db } from '../../../lib/prisma';

const token = Astro.cookies.get('smkdh_token')?.value;
if (!token) return Astro.redirect('/admin/login');
const session = await verifyToken(token);
if (!session) return Astro.redirect('/admin/login');

const url = new URL(Astro.request.url);
const jenisFilter = url.searchParams.get('j') || '';
const {page,size:limit}=pageOptions(url.searchParams);

const where: any = {};
if (jenisFilter) where.jenis = jenisFilter;

const s = tableSort(url, { nama: 'nama', jenis: 'jenis', tanggal: 'createdAt' }, [{ createdAt: 'desc' }]);

const [items, total, jenisRows] = await Promise.all([
  db.alumniContribution.findMany({ where, orderBy: s.orderBy, skip: (page - 1) * limit, take: limit }),
  db.alumniContribution.count({ where }),
  db.alumniContribution.findMany({ distinct: ['jenis'], select: { jenis: true }, orderBy: { jenis: 'asc' } }),
]);
const jenisList = jenisRows.map((r) => r.jenis);
const totalPages = Math.max(1,Math.ceil(total / limit));
if(page>totalPages){url.searchParams.set('page',String(totalPages));return Astro.redirect(url.pathname+url.search)}
---

<AdminLayout title="Kontribusi Alumni" user={{ role: session.role }}>
  <PageHeader title="Kontribusi Alumni"/>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <form method="GET" style="display:flex;gap:8px"><label style="font-size:12px">Per halaman<select name="size">{[10,25,50].map(size=><option value={size} selected={size===limit}>{size}</option>)}</select></label><input type="hidden" name="sort" value={url.searchParams.get('sort')??''}/><input type="hidden" name="dir" value={url.searchParams.get('dir')??''}/>
      <select name="j" style="width:240px" onchange="this.form.submit()">
        <option value="" selected={jenisFilter === ''}>Semua Jenis</option>
        {jenisList.map((j) => <option value={j} selected={jenisFilter === j}>{j}</option>)}
      </select>
      <button type="submit" class="btn btn-outline" style="padding:10px 14px">Filter</button>
    </form>
  </div>

  <div class="card" style="padding:0">
    <DataTable id="server-kontribusi" label="kontribusi" mode="server"><table>
      <thead>
        <tr>
          <SortTh label="Nama" href={s.sortLink('nama')} active={s.sort === 'nama'} icon={s.sortIcon('nama')} width="18%" />
          <SortTh label="Jenis" href={s.sortLink('jenis')} active={s.sort === 'jenis'} icon={s.sortIcon('jenis')} />
          <th style="width:40%">Detail</th>
          <th>Kontak</th>
          <SortTh label="Tanggal" href={s.sortLink('tanggal')} active={s.sort === 'tanggal'} icon={s.sortIcon('tanggal')} />
          <th style="width:60px"></th>
        </tr>
      </thead>
      <tbody>
        {items.length === 0 ? (
          <tr><td colspan="6" style="text-align:center;padding:40px;color:#6f7a6e">Belum ada kontribusi.</td></tr>
        ) : items.map((c) => (
          <tr>
            <td style="font-weight:600">{c.nama}</td>
            <td><span class="badge badge-gray">{c.jenis}</span></td>
            <td style="font-size:12px;color:#6f7a6e">{c.detail}</td>
            <td style="font-size:12px;color:#6f7a6e;white-space:nowrap">{c.kontak}</td>
            <td style="font-size:12px;color:#6f7a6e;white-space:nowrap">{new Date(c.createdAt).toLocaleDateString('id', { day: 'numeric', month: 'short', year: 'numeric' })}</td>
            <td>
              <form method="POST" action="/admin/kontribusi/delete" style="display:inline">
                <input type="hidden" name="id" value={c.id}/>
                <button type="submit" class="btn btn-outline" style="padding:6px 10px;font-size:11px;color:#dc2626" title="Hapus"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table></DataTable>
  </div>

  <Pagination page={page} pageCount={totalPages} total={total} size={limit} url={url}/>

  <p style="font-size:12px;color:#6f7a6e;margin-top:12px">Total: {total} kontribusi</p>
</AdminLayout>
