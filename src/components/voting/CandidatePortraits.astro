---
import { thumbnailUrl } from '../../lib/image-url';
import { env } from '../../lib/env';
interface Member { name: string; className: string; photoUrl: string | null }
interface Props { chair: Member; viceChair: Member | null; chairLabel: string; viceChairLabel: string | null; eager?: boolean }
const { chair, viceChair, chairLabel, viceChairLabel, eager = false } = Astro.props;
const members = [{ ...chair, label: chairLabel }, ...(viceChair ? [{ ...viceChair, label: viceChairLabel }] : [])];
const photo = (source: string, width: number) => thumbnailUrl(source, width, Astro.url.origin, env('R2_PUBLIC_URL'));
---
<div class:list={['members', { paired: !!viceChair }]}>
  {members.map((member, index) => <div class="member">
    {member.photoUrl ? <img
      src={photo(member.photoUrl, 600)}
      srcset={[200, 300, 480, 600, 768, 960].map(width => `${photo(member.photoUrl!, width)} ${width}w`).join(', ')}
      sizes={viceChair ? '(max-width: 760px) calc((100vw - 66px) / 2), 260px' : '(max-width: 760px) calc(100vw - 54px), 520px'}
      width="600" height="750" alt={`Foto ${member.name}`}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager && index === 0 ? 'high' : 'auto'} decoding="async"
    /> : <span class="photo-fallback" aria-hidden="true">{member.name.slice(0,1)}</span>}
    <div class="member-caption"><span class="position">{member.label}</span><strong>{member.name}</strong><small>{member.className}</small></div>
  </div>)}
</div>
<style>
  .members{display:grid;grid-template-columns:minmax(0,1fr);gap:2px;background:#eef2ef}
  .members.paired{grid-template-columns:repeat(2,minmax(0,1fr))}
  .member{min-width:0;background:white}
  .member img,.photo-fallback{display:grid;width:100%;height:clamp(260px,30vw,320px)}
  .member img{object-fit:cover;object-position:center top;background:#eef2ef}
  .photo-fallback{place-items:center;background:linear-gradient(145deg,#e6f3eb,#d4e6da);color:var(--color-accent,#17643f);font-size:64px;font-weight:800}
  .member-caption{padding:14px 16px;overflow-wrap:anywhere}
  .member strong,.member small,.position{display:block}
  .member strong{margin:3px 0}
  .member small,.position{color:#58685e;font-size:.82rem}
  .position{color:#27714b;font-weight:700}
  @media print{.member img,.photo-fallback{height:48mm}.member-caption{padding:8px}.member strong{font-size:11pt}.position,.member small{font-size:9pt}}
</style>
