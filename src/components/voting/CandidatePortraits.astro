---
import { thumbnailUrl } from '../../lib/image-url';
import { env } from '../../lib/env';
interface Member { name: string; className: string; photoUrl: string | null }
interface Props { chair: Member; viceChair: Member | null; chairLabel: string; viceChairLabel: string | null; eager?: boolean }
const { chair, viceChair, chairLabel, viceChairLabel, eager = false } = Astro.props;
const members = [{ ...chair, label: chairLabel }, ...(viceChair ? [{ ...viceChair, label: viceChairLabel }] : [])];
const photo = (source: string, width: number) => thumbnailUrl(source, width, Astro.url.origin, env('R2_PUBLIC_URL'));
---
<div class="candidate-content">
  <div class:list={['members', { paired: !!viceChair }]}>
    {members.map((member, index) => <div class="member">
    {member.photoUrl ? <img
      src={photo(member.photoUrl, 600)}
      srcset={[200, 300, 480, 600, 768, 960].map(width => `${photo(member.photoUrl!, width)} ${width}w`).join(', ')}
      sizes={viceChair ? '(max-width: 480px) calc((100vw - 44px) / 2), (max-width: 1160px) calc((100vw - 44px) / 5), 224px' : '(max-width: 480px) calc(100vw - 44px), (max-width: 1160px) calc((100vw - 44px) * .4), 448px'}
      width="600" height="750" alt={`Foto ${member.name}`}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager && index === 0 ? 'high' : 'auto'} decoding="async"
    /> : <span class="photo-fallback" aria-hidden="true">{member.name.slice(0,1)}</span>}
    </div>)}
  </div>
  <div class="candidate-information">
    <div class="member-captions">
      {members.map(member => <div class="member-caption"><span class="position">{member.label}</span><strong>{member.name}</strong><small>{member.className}</small></div>)}
    </div>
    <slot />
  </div>
</div>
<style>
  .candidate-content{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr);align-items:start}
  .members{display:grid;grid-template-columns:minmax(0,1fr);gap:2px;background:#eef2ef;min-width:0}
  .members.paired{grid-template-columns:repeat(2,minmax(0,1fr))}
  .member{min-width:0;background:white}
  .member img{display:block;width:100%;height:auto;object-fit:contain;background:#eef2ef}
  .photo-fallback{display:grid;width:100%;aspect-ratio:4/5;place-items:center;background:linear-gradient(145deg,#e6f3eb,#d4e6da);color:var(--color-accent,#17643f);font-size:clamp(32px,6vw,64px);font-weight:800}
  .candidate-information{min-width:0;padding:20px 24px}
  .member-captions{display:grid;gap:14px;margin-bottom:18px}
  .member-caption{overflow-wrap:anywhere}
  .member-caption strong,.member-caption small,.position{display:block}
  .member-caption strong{margin:4px 0;font-size:clamp(1rem,2vw,1.35rem);line-height:1.35}
  .member-caption small,.position{color:#58685e;font-size:.82rem}
  .position{color:#27714b;font-weight:700}
  @media(max-width:760px){.candidate-information{padding:16px}.member-captions{gap:12px;margin-bottom:14px}}
  @media(max-width:480px){.candidate-content{grid-template-columns:minmax(0,1fr)}}
  @media print{.candidate-content{grid-template-columns:minmax(0,2fr) minmax(0,3fr)}.candidate-information{padding:3mm}.member-caption strong{font-size:11pt}.position,.member-caption small{font-size:9pt}}
</style>
