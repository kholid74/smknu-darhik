---
import '../../styles/portal-tokens.css';
import PortalHead from '../../components/ui/PortalHead.astro';
import { db } from '../../lib/prisma';

interface Props { voterType: 'STUDENT' | 'TEACHER' }
const teacher = Astro.props.voterType === 'TEACHER';
const portal = teacher ? 'Portal Pemilih' : 'Portal Siswa';
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('X-Frame-Options', 'DENY');

const [{ now }] = await db.$queryRaw<[{ now: Date }]>`SELECT clock_timestamp() AS "now"`;
const periods = await db.electionPeriod.findMany({ where: { state: 'SCHEDULED', closesAt: { gt: now } },
  orderBy: { opensAt: 'asc' }, select: { id: true, slug: true, name: true, opensAt: true } });
const requestedSlug = Astro.url.searchParams.get('periode');
const selectedId = periods.find((period) => period.slug === requestedSlug)?.id ?? (periods.length === 1 ? periods[0].id : '');
const selectedPeriod=periods.find(period=>period.id===selectedId);
const dateLabel = (date: Date) => new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(date);
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <PortalHead/>
    <title>Masuk · {portal} SMKS NU Darul Hikam</title>
    <style>
      :root { font-family: var(--font-portal); color: var(--color-ink); background: var(--color-paper); }
      * { box-sizing: border-box; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; }
      main { width: min(100%, 460px); padding: 34px; border: 1px solid #dce5df; border-radius: 18px; background: white; box-shadow: 0 18px 50px #153e2812; }
      .brand { margin-bottom: 28px; color: #145c3b; font-weight: 800; }
      .brand small { display: block; margin-top: 5px; color: #58685e; font-size: .85rem; font-weight: 500; }
      h1 { margin: 0 0 8px; font-size: 1.75rem; }
      .intro { margin: 0 0 24px; color: #58685e; line-height: 1.5; }
      label { display: block; margin: 16px 0 7px; font-size: .92rem; font-weight: 700; }
      input, select { width: 100%; min-height: 48px; padding: 11px 12px; border: 1px solid #a8b8ad; border-radius: 8px; background: #fff; color: inherit; font: inherit; }
      button { width: 100%; min-height: 48px; margin-top: 22px; border: 0; border-radius: 8px; background: #17643f; color: white; font: inherit; font-weight: 700; cursor: pointer; }
      button:disabled { opacity: .55; cursor: not-allowed; }
      :focus-visible { outline: 3px solid #e6a800; outline-offset: 3px; }
      #message { min-height: 1.5rem; margin: 16px 0 0; color: #8b2f22; line-height: 1.4; }
      .help { margin-top: 22px; padding-top: 18px; border-top: 1px solid #e4e9e5; color: #58685e; font-size: .85rem; line-height: 1.5; }
      .unavailable { padding: 14px; border-radius: 8px; background: #f3f5f3; color: #58685e; }
      @media (max-width: 480px) { main { padding: 26px 21px; } }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">SMKS NU Darul Hikam<small>{portal}</small></div>
      <h1>Masuk ke {portal}</h1>
      {Astro.url.searchParams.has('expired')&&<p class="feedback" data-tone="info" role="status">Sesi Anda telah berakhir. Masuk kembali dengan PIN yang sama untuk melanjutkan pemilihan.</p>}
      {selectedPeriod&&<p class="unavailable" style="font-size:13px;margin-bottom:18px"><strong>{selectedPeriod.name}</strong><br/>Dibuka {dateLabel(selectedPeriod.opensAt)} WIB</p>}
      <p class="intro">Gunakan {teacher ? 'kode guru' : 'NISN'} dan PIN pemilihan yang diberikan panitia. PIN hanya berlaku untuk periode pemilihan ini.</p>
      {periods.length ? <form id="login-form" method="post" data-period-id={selectedId} data-voter-type={Astro.props.voterType}>
        {periods.length > 1 && <>
          <label for="period">Periode pemilihan</label>
          <select id="period" required>
            <option value="">Pilih periode</option>
            {periods.map((period) => <option value={period.id} selected={period.id === selectedId}>{period.name} — dibuka {dateLabel(period.opensAt)}</option>)}
          </select>
        </>}
        <label for="identifier">{teacher ? 'Kode pemilih guru' : 'NISN'}</label>
        <input id="identifier" name="identifier" type="text" inputmode={teacher ? 'text' : 'numeric'} pattern={teacher ? '[Gg][Uu][Rr][Uu]-[A-Fa-f0-9]{12}' : '[0-9]{10}'} minlength={teacher ? 17 : 10} maxlength={teacher ? 17 : 10} autocomplete="off" autocapitalize="off" spellcheck="false" required />
        <label for="pin">PIN pemilihan</label>
        <input id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{10}" minlength="10" maxlength="10" autocomplete="off" autocapitalize="off" spellcheck="false" required />
        <button id="submit" type="submit" disabled>Masuk</button>
        <p id="message" role="status" aria-live="polite"></p>
      </form> : <p class="unavailable">Saat ini tidak ada periode pemilihan yang sedang dibuka. Hubungi panitia jika jadwal seharusnya berlangsung.</p>}
      <p class="help">Jangan simpan PIN pada perangkat bersama. Setelah selesai, tekan Keluar dan pastikan layar kembali ke halaman masuk.</p>
      <p class="help"><a href={teacher ? '/siswa/masuk' : '/pemilih/masuk'}>{teacher ? 'Masuk sebagai siswa' : 'Masuk sebagai pemilih guru'}</a></p>
      <noscript><p class="help">Halaman masuk memerlukan JavaScript agar permintaan dapat dilindungi.</p></noscript>
    </main>
    <script>
      const form = document.getElementById('login-form');
      const message = document.getElementById('message');
      const submit = document.getElementById('submit');
      const periodSelect = document.getElementById('period');
      let csrfToken = '';
      let phase = 'CLOSED';
      let prepareTimer=0;
      async function prepareSession() {
        window.clearTimeout(prepareTimer);
        const periodId = periodSelect instanceof HTMLSelectElement ? periodSelect.value : form?.dataset.periodId;
        if (!periodId) { phase = 'CLOSED'; if (submit instanceof HTMLButtonElement) submit.disabled = true; return; }
        form.dataset.periodId = periodId;
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        try {
          const response = await fetch(`/api/e-voting/${periodId}/session`, { cache: 'no-store', credentials: 'same-origin' });
          if (!response.ok) throw new Error();
          const data = await response.json(); csrfToken = data.csrfToken; phase = data.phase;
          if (phase !== 'OPEN') {
            if (message) message.textContent = phase === 'BEFORE_OPEN' ? 'Periode pemilihan belum dibuka.' : 'Periode pemilihan tidak sedang dibuka.';
          } else if (message) message.textContent = '';
          if (submit instanceof HTMLButtonElement) submit.disabled = phase !== 'OPEN';
          form?.querySelectorAll<HTMLInputElement>('input').forEach(input=>input.disabled=phase!=='OPEN');
          if(phase==='BEFORE_OPEN')prepareTimer=window.setTimeout(prepareSession,15000);
        } catch {
          if (message) message.textContent = 'Layanan belum dapat dihubungi. Muat ulang halaman untuk mencoba kembali.';
        }
      }
      periodSelect?.addEventListener('change', prepareSession);
      if (form) prepareSession();
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !form.reportValidity() || phase !== 'OPEN' || !csrfToken) return;
        const identifier = new FormData(form).get('identifier');
        const teacher = form.dataset.voterType === 'TEACHER';
        const pinInput = document.getElementById('pin');
        const pin = pinInput instanceof HTMLInputElement ? pinInput.value : '';
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (message) message.textContent = 'Memeriksa kredensial…';
        try {
          const response = await fetch(`/api/e-voting/${form.dataset.periodId}/session`, { method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }, body: JSON.stringify(teacher ? {voterType: 'TEACHER', code: identifier, pin} : {nisn: identifier, pin}) });
          const data = await response.json();
          if (!response.ok) {
            if (pinInput instanceof HTMLInputElement) pinInput.value = '';
            if (response.status === 401) throw new Error('Identitas atau PIN tidak valid. Periksa kembali slip dari panitia.');
            if (response.status === 429) throw new Error('Terlalu banyak percobaan. Coba lagi setelah beberapa menit.');
            if (data.error?.code === 'SESSION_CAPACITY') throw new Error('Tiga perangkat masih digunakan. Tunggu pemilih selesai atau keluar, lalu coba kembali.');
            if (response.status === 409) throw new Error('Periode pemilihan tidak sedang dibuka.');
            throw new Error('Belum dapat masuk. Periksa koneksi lalu coba kembali.');
          }
          location.assign(data.redirectTo);
        } catch (error) {
          if (message) message.textContent = error instanceof Error ? error.message : 'Belum dapat masuk.';
          if (submit instanceof HTMLButtonElement) submit.disabled = phase !== 'OPEN';
        }
      });
    </script>
  </body>
</html>
