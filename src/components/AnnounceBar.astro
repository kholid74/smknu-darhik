---
import { parseAnnouncements, type TextAnnouncement } from '../lib/announcements';
interface Props { announcements?: TextAnnouncement[] }
const supplied = Astro.props.announcements;
const list = parseAnnouncements(supplied);
const first = list[0];
---
<aside id="announce-bar" class="announcement" aria-label="Pengumuman sekolah" hidden={!first} data-announcements={supplied === undefined ? undefined : JSON.stringify(list)} data-signature={list.map(item => item.id).join(',')}>
  <div class="announcement-header">
    <strong>Pengumuman sekolah</strong>
    <button id="announce-close" type="button" aria-label="Tutup pengumuman">×</button>
  </div>
  <div id="announce-msg" class="announcement-message" tabindex="0" aria-label="Isi pengumuman">
    <span id="announce-text">{first?.text}</span>{' '}
    <a id="announce-link" href={first?.linkUrl || undefined} hidden={!first?.linkUrl}>{first?.linkLabel} →</a>
  </div>
  <div id="announce-dots" class="announcement-dots" aria-hidden="true" hidden={list.length < 2}>
    {list.map((_, index) => <span style={{ opacity: index === 0 ? '1' : '0.4' }} />)}
  </div>
</aside>
<script is:inline>
  // Check before the first paint so a dismissed server-rendered notice does not flash.
  try {
    const notice = document.getElementById('announce-bar');
    if (notice?.dataset.signature && localStorage.getItem('smkdh_announce_dismissed') === notice.dataset.signature) notice.hidden = true;
  } catch { /* A blocked storage API must not hide announcements. */ }
</script>
<style>
  .announcement { position: fixed; z-index: 70; left: 16px; bottom: 96px; width: min(560px, calc(100% - 32px)); color: white; background: #00602b; border: 1px solid #ffffff30; border-radius: 14px; box-shadow: 0 8px 28px #002f1e40; padding: 12px 16px; }
  .announcement[hidden] { display: none; }
  .announcement-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: 13px; }
  .announcement-header button { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; border-radius: 8px; color: white; background: transparent; border: 1px solid #ffffff40; font: inherit; font-size: 24px; cursor: pointer; }
  .announcement-header button:hover { background: #ffffff20; }
  .announcement-message { margin-top: 4px; max-height: min(30vh, 180px); overflow: auto; overflow-wrap: anywhere; white-space: pre-line; font-size: 14px; line-height: 1.6; }
  .announcement-message a { color: #ffe0a3; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .announcement :focus-visible { outline: 3px solid #ffe0a3; outline-offset: 3px; }
  .announcement-dots { display: flex; gap: 6px; padding-top: 10px; }
  .announcement-dots[hidden] { display: none; }
  .announcement-dots span { width: 6px; height: 6px; border-radius: 50%; background: white; }
  @media (min-width: 768px) { .announcement { left: 24px; bottom: 24px; } }
</style>
<script>
  import { parseAnnouncements } from '../lib/announcements';
  import type { TextAnnouncement } from '../lib/announcements';

  (async () => {
    const bar = document.getElementById('announce-bar');
    if (!bar) return;
    const close = bar.querySelector<HTMLButtonElement>('#announce-close')!;
    const text = bar.querySelector<HTMLElement>('#announce-text')!;
    const link = bar.querySelector<HTMLAnchorElement>('#announce-link')!;
    const dots = bar.querySelector<HTMLElement>('#announce-dots')!;
    let list: TextAnnouncement[];
    try {
      if (bar.dataset.announcements !== undefined) list = parseAnnouncements(JSON.parse(bar.dataset.announcements));
      else {
        const response = await fetch('/api/announce', { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        list = parseAnnouncements(await response.json());
      }
    } catch { bar.hidden = true; return; }
    if (!list.length) { bar.hidden = true; return; }
    try { if (localStorage.getItem('smkdh_announce_dismissed') === list.map(item => item.id).join(',')) { bar.hidden = true; return; } } catch { /* Storage may be disabled on shared devices. */ }

    let index = 0, paused = false;
    let expiryTimer: ReturnType<typeof setTimeout> | undefined;
    let rotation: ReturnType<typeof setInterval> | undefined;
    const render = () => {
      const item = list[index];
      if (!item) { bar.hidden = true; return; }
      text.textContent = item.text;
      link.hidden = !item.linkUrl;
      if (item.linkUrl) link.href = item.linkUrl;
      else link.removeAttribute('href');
      link.textContent = item.linkLabel + ' →';
      dots.hidden = list.length < 2;
      dots.replaceChildren(...list.map((_, position) => {
        const dot = document.createElement('span');
        dot.style.opacity = position === index ? '1' : '0.4';
        return dot;
      }));
      bar.hidden = false;
    };
    const expire = () => {
      const current = list[index]?.id;
      list = parseAnnouncements(list);
      index = Math.max(0, list.findIndex(item => item.id === current));
      render();
      if (list.length < 2) clearInterval(rotation);
      const deadlines = list.flatMap(item => item.expiresAt ? [Date.parse(item.expiresAt)] : []);
      if (deadlines.length) expiryTimer = setTimeout(expire, Math.min(2147483647, Math.max(1, Math.min(...deadlines) - Date.now())));
    };
    expire();
    if (list.length > 1) rotation = setInterval(() => {
      if (!paused && !document.hidden && list.length > 1) { index = (index + 1) % list.length; render(); }
    }, 6000);
    bar.addEventListener('mouseenter', () => { paused = true; });
    bar.addEventListener('mouseleave', () => { paused = bar.contains(document.activeElement); });
    bar.addEventListener('focusin', () => { paused = true; });
    bar.addEventListener('focusout', () => { paused = bar.matches(':hover'); });
    close.addEventListener('click', () => {
      try { localStorage.setItem('smkdh_announce_dismissed', list.map(item => item.id).join(',')); } catch { /* Closing still works without storage. */ }
      clearInterval(rotation);
      clearTimeout(expiryTimer);
      bar.hidden = true;
      document.querySelector<HTMLAnchorElement>('header a')?.focus({ preventScroll: true });
    });
  })();
</script>
