---
const { content = '' } = Astro.props as { content?: string };
---
<div id="tiptap-editor" data-content={content}>
  <div class="tip-tb">
    <button type="button" data-action="bold" title="Bold"><strong>B</strong></button>
    <button type="button" data-action="italic" title="Italic"><em>I</em></button>
    <button type="button" data-action="underline" title="Underline"><u>U</u></button>
    <button type="button" data-action="strike" title="Strikethrough"><s>S</s></button>
    <span class="tip-sep"></span>
    <button type="button" data-action="heading" data-level="2" title="Heading">H2</button>
    <button type="button" data-action="heading" data-level="3" title="Subheading">H3</button>
    <span class="tip-sep"></span>
    <button type="button" data-action="bulletList" title="Bullet List">•&nbsp;List</button>
    <button type="button" data-action="orderedList" title="Numbered List">1.&nbsp;List</button>
    <button type="button" data-action="blockquote" title="Quote">❝</button>
    <span class="tip-sep"></span>
    <button type="button" data-action="link" title="Link">🔗</button>
    <button type="button" data-action="image" title="Image">🖼</button>
  </div>
  <div class="tip-content"></div>
</div>

<style>
  .tip-tb { display:flex;flex-wrap:wrap;gap:3px;padding:10px;background:#f6f3f2;border-radius:10px 10px 0 0;border:1px solid rgba(0,0,0,0.12);border-bottom:none }
  .tip-tb button { padding:6px 10px;border:none;background:white;border-radius:6px;cursor:pointer;font-size:13px;color:#3f493f;border:1px solid transparent;min-width:32px;text-align:center }
  .tip-tb button:hover,.tip-tb button.is-active { border-color:#1B7A3D;color:#1B7A3D;background:#f0f7f1 }
  .tip-sep { width:1px;background:#ddd;margin:0 4px }
  .tip-content { border:1px solid rgba(0,0,0,0.12);border-radius:0 0 10px 10px;background:white;min-height:350px }
  .tip-content:focus-within { border-color:#1B7A3D }
</style>

<style is:global>
  .tip-content .ProseMirror { outline:none;min-height:330px;padding:20px }
  .tip-content .ProseMirror p.is-editor-empty:first-child::before { content:attr(data-placeholder);color:#9ca3af;float:left;pointer-events:none;height:0 }
  .tip-content .ProseMirror h2 { font-size:22px;font-weight:800;margin:16px 0 8px;color:#1c1b1b }
  .tip-content .ProseMirror h3 { font-size:18px;font-weight:700;margin:12px 0 6px;color:#1c1b1b }
  .tip-content .ProseMirror p { margin:0 0 10px;line-height:1.7;color:#3f493f }
  .tip-content .ProseMirror ul,.tip-content .ProseMirror ol { padding-left:20px;margin:0 0 10px }
  .tip-content .ProseMirror li { margin-bottom:4px;color:#3f493f }
  .tip-content .ProseMirror blockquote { border-left:3px solid #C8963E;padding-left:16px;color:#6f7a6e;margin:12px 0 }
  .tip-content .ProseMirror img { max-width:100%;border-radius:8px;margin:8px 0 }
  .tip-content .ProseMirror a { color:#1B7A3D;text-decoration:underline }
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Underline from '@tiptap/extension-underline';
  import Link from '@tiptap/extension-link';
  import Image from '@tiptap/extension-image';

  const container = document.getElementById('tiptap-editor')!;
  const contentEl = container.querySelector('.tip-content')!;
  const initialContent = container.dataset.content || '';

  const editor = new Editor({
    element: contentEl,
    extensions: [StarterKit.configure({ heading: { levels: [2, 3] } }), Underline, Link.configure({ openOnClick: false }), Image],
    content: initialContent,
    editorProps: { attributes: { 'data-placeholder': 'Tulis konten artikel di sini...' } },
  });

  const syncInput = document.querySelector<HTMLInputElement>('input[name="body"]');
  editor.on('update', () => { if (syncInput) syncInput.value = editor.getHTML(); });

  container.querySelectorAll('[data-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-action')!;
      const level = parseInt(btn.getAttribute('data-level') || '0');
      if (action === 'heading') { editor.chain().focus().toggleHeading({ level: level as 2|3 }).run(); }
      else if (action === 'link') { const u = prompt('URL:'); if (u) editor.chain().focus().setLink({ href: u }).run(); }
      else if (action === 'image') { const u = prompt('URL gambar:'); if (u) editor.chain().focus().setImage({ src: u }).run(); }
      else { (editor.chain().focus() as any)[`toggle${action[0].toUpperCase()+action.slice(1)}`]?.run(); }
    });
  });

  editor.on('selectionUpdate', () => {
    container.querySelectorAll('[data-action]').forEach(btn => {
      btn.classList.toggle('is-active', editor.isActive(btn.getAttribute('data-action')!));
    });
  });
</script>
