---
// Upload a document (PDF/DOC/XLS/…) straight from the user's computer instead
// of pasting a hosted URL. Uploads to /api/upload (which stores non-images
// as-is and indexes them as kind="file") and writes the resulting URL into the
// form field named by `field`. A text field remains for pasting/editing a URL.
interface Props {
  field: string;
  value?: string | null;
  label?: string;
  folder?: string;
  accept?: string;
  required?: boolean;
}
const {
  field,
  value = '',
  label = 'File',
  folder = 'downloads',
  accept = '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar',
  required = false,
} = Astro.props;
const uid = 'fu-' + Math.random().toString(36).slice(2, 9);
---

<div class="file-upload" data-uid={uid} data-folder={folder}>
  <label style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">{label}</label>

  <div class="fu-chip" style={`display:${value ? 'flex' : 'none'};align-items:center;gap:10px;background:#f0f7f1;border-radius:8px;padding:8px 12px;margin-bottom:8px`}>
    <span class="material-symbols-outlined" style="font-size:22px;color:#1B7A3D">draft</span>
    <a class="fu-link" href={value || '#'} target="_blank" rel="noopener" style="flex:1;min-width:0;font-size:12px;color:#1B7A3D;font-weight:600;word-break:break-all">{value}</a>
    <button type="button" class="fu-clear" style="background:none;border:none;color:#dc2626;cursor:pointer;padding:4px" aria-label="Hapus file"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
  </div>

  <div style="display:flex;gap:8px">
    <input type="text" name={field} value={value} class="fu-input" placeholder="URL file atau upload dari komputer" style="flex:1" required={required}/>
    <button type="button" class="btn btn-outline fu-btn" style="white-space:nowrap;position:relative">
      <span class="material-symbols-outlined" style="font-size:16px">upload_file</span> Upload File
      <input type="file" accept={accept} class="fu-file" style="position:absolute;inset:0;opacity:0;cursor:pointer"/>
    </button>
  </div>
  <p class="fu-status" style="display:none;font-size:12px;color:#6f7a6e;margin-top:6px"></p>
</div>

<script>
  function initFileUploads() {
    document.querySelectorAll<HTMLElement>('.file-upload').forEach((root) => {
      if (root.dataset.wired) return;
      root.dataset.wired = 'true';

      const folder = root.dataset.folder || 'downloads';
      const input = root.querySelector<HTMLInputElement>('.fu-input')!;
      const chip = root.querySelector<HTMLElement>('.fu-chip')!;
      const link = root.querySelector<HTMLAnchorElement>('.fu-link')!;
      const fileInput = root.querySelector<HTMLInputElement>('.fu-file')!;
      const status = root.querySelector<HTMLElement>('.fu-status')!;

      const setValue = (url: string) => {
        input.value = url;
        if (url) {
          link.href = url;
          link.textContent = url;
          chip.style.display = 'flex';
        } else {
          chip.style.display = 'none';
        }
      };

      input.addEventListener('input', () => setValue(input.value.trim()));
      root.querySelector('.fu-clear')?.addEventListener('click', () => setValue(''));

      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        if (file.size > 10 * 1024 * 1024) { alert('File terlalu besar. Max 10MB.'); return; }
        status.style.display = 'block';
        status.textContent = `Mengupload ${file.name}…`;
        const fd = new FormData();
        fd.append('file', file);
        fd.append('folder', folder);
        try {
          const res = await fetch('/api/upload', { method: 'POST', body: fd });
          const data = await res.json();
          if (data.url) {
            setValue(data.url);
            status.textContent = 'Berhasil diupload.';
          } else {
            throw new Error(data.error || 'Upload gagal');
          }
        } catch (e: any) {
          status.textContent = 'Gagal: ' + e.message;
        } finally {
          fileInput.value = '';
        }
      });
    });
  }
  initFileUploads();
</script>
